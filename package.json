{
  "name": "kangdaejong-com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/brand-tokens.mjs && node scripts/site-release/prepare.mjs && astro build && node scripts/generate-sitemap.mjs && node scripts/site-release/check.mjs --dist dist",
    "verify:favicon-brand": "node scripts/verify-favicon-brand.mjs",
    "verify:shared-footer": "node scripts/verify-shared-footer-source.mjs",
    "verify:shared-header": "node scripts/verify-shared-header-source.mjs",
    "verify:organization-roster": "node scripts/verify-organization-roster.mjs",
    "verify:organization-tone": "node scripts/verify-organization-tone.mjs",
    "verify:homepage-renewal": "node scripts/verify-homepage-renewal.mjs",
    "verify:tone-pairs": "node scripts/verify-tone-pairs.mjs",
    "verify:dark-cards": "node scripts/verify-dark-cards.mjs",
    "verify:palette-copies": "node scripts/verify-palette-copies.mjs",
    "test": "playwright test",
    "preview": "astro preview",
    "astro": "astro",
    "build:protein": "node scripts/brand-tokens.mjs && astro build --config astro.protein.config.mjs",
    "render:protein-dark": "node scripts/render-amino-acids-dark.mjs",
    "test:protein": "playwright test --config playwright.protein.config.mjs",
    "test:logo-api": "node --test tests/logo/api.test.mjs",
    "test:logo-ui": "playwright test tests/logo-studio.spec.mjs --workers=2",
    "brand:render": "node scripts/render-studio-brand.mjs && node scripts/render-share-card.mjs",
    "test:site-release": "bash tests/test_site_release.sh && npm run test:work-route",
    "test:work-route": "node --test workshop-router/route.test.mjs",
    "deploy:work-route": "wrangler deploy --config workshop-router/wrangler.jsonc",
    "verify:site-release": "node scripts/site-release/check.mjs --dist dist",
    "verify:live-sites": "node scripts/site-release/live.mjs",
    "deploy:site": "bash scripts/site-release/deploy.sh"
  },
  "dependencies": {
    "astro": "^6.3.3",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "wrangler": "^4.100.0"
  }
}
