# T-261011-068: baseline security headers for every page. CSP is intentionally not set here
# (inline module scripts + Cloudflare email-decode would need per-build hashes).
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# T-261011-068: hashed build output and content-hashed icons never change in place — cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/product-icons/*
  Cache-Control: public, max-age=31536000, immutable

# Shared canonical header/components — must propagate to all consumer sites fast.
# Short cache (was default 4h, which made header edits invisible for hours). (T-260627-20)
/mb-components.js
  Cache-Control: public, max-age=0, must-revalidate

# Mutable company identity aliases. Revalidate rather than pinning an old version.
/brand/*
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

# Browser-only photo studio: no upload or API connections.
/photo/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
