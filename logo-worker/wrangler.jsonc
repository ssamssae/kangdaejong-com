{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "logo-kureomi",
  "main": "entry.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDERS",
        "class_name": "LogoOrder"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LogoOrder"
      ]
    }
  ],
  "vars": {
    "SALES_ENABLED": "false",
    "SERVICE_CLOSED": "true"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {"pattern": "kangdaejong.com/photo", "zone_name": "kangdaejong.com"},
    {"pattern": "kangdaejong.com/photo/*", "zone_name": "kangdaejong.com"},
    {"pattern": "kangdaejong.com/logo", "zone_name": "kangdaejong.com"},
    {
      "pattern": "kangdaejong.com/logo/*",
      "zone_name": "kangdaejong.com"
    },
    {
      "pattern": "logo.kangdaejong.com",
      "custom_domain": true
    }
  ]
}
