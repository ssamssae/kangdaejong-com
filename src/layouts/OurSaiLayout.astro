---
import SiteLayout from "./SiteLayout.astro";
const { title, description, path } = Astro.props;
---
<SiteLayout title={title} description={description} canonical={`https://kangdaejong.com/our-sai/${path || ""}`}>
<main id="main-content" class="our-sai"><a class="brand" href="/our-sai/">우리 사이 <span>둘만의 기록</span></a><slot /><nav aria-label="우리 사이 안내"><a href="/our-sai/">앱 소개</a><a href="/our-sai/privacy/">개인정보처리방침</a><a href="/our-sai/support/">지원·삭제 안내</a><a href="/our-sai/terms/">이용 안내</a></nav></main>
</SiteLayout>
<style is:global>
/* T-261024-050: 우리 사이 안내 = 첫이름 article 페이지와 같은 톤(공용 색·톤 값만, 앱 고유 보라색 폐기). */
body.studio-page .our-sai{width:min(calc(100% - var(--tone-gutter) * 2),var(--tone-prose-max));max-width:none;margin:0 auto;padding:var(--tone-space-5) 0 var(--tone-section-gap);color:var(--fg)}.our-sai .brand{display:inline-flex;align-items:center;gap:var(--tone-space-1);min-height:var(--tone-tap-height);color:var(--fg);font:var(--tone-weight-bold) var(--tone-subtitle-size)/var(--tone-subtitle-line) var(--tone-font);letter-spacing:var(--tone-tracking-title);text-decoration:none}.our-sai .brand span{color:var(--fg-dim);font:var(--tone-weight) var(--tone-caption-size)/var(--tone-caption-line) var(--tone-font);letter-spacing:normal}.our-sai h1{margin:var(--tone-space-4) 0 var(--tone-space-3)}.our-sai h2{margin:var(--tone-space-6) 0 var(--tone-space-2);padding-top:var(--tone-space-3);border-top:1px solid var(--border)}.our-sai p,.our-sai li{color:var(--fg-dim);line-height:var(--tone-body-line);overflow-wrap:anywhere}.our-sai li{margin-bottom:var(--tone-space-1)}.our-sai p{margin:0 0 var(--tone-space-3)}body.studio-page .our-sai a{color:var(--accent);font-weight:var(--tone-weight-bold);text-underline-offset:var(--tone-underline-offset)}body.studio-page .our-sai nav{display:flex;gap:var(--tone-space-1) var(--tone-space-3);flex-wrap:wrap;margin-top:var(--tone-section-gap);border-top:1px solid var(--border);padding-top:var(--tone-space-4)}.our-sai nav a{display:inline-flex;align-items:center;min-height:var(--tone-tap-height);color:var(--fg);text-decoration:none}.our-sai .intro{color:var(--fg-dim);font-size:var(--tone-body-size)}.our-sai .note{background:var(--accent-tint);padding:var(--tone-card-padding);border-radius:var(--tone-radius-card);color:var(--fg)}.our-sai ul{padding-left:var(--tone-space-4);margin:0 0 var(--tone-space-3)}
</style>
