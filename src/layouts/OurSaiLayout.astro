---
import SiteLayout from "./SiteLayout.astro";
const { title, description, path } = Astro.props;
---
<SiteLayout title={title} description={description} canonical={`https://kangdaejong.com/our-sai/${path || ""}`} theme="auto">
<main id="main-content" class="our-sai"><a class="brand" href="/our-sai/">우리 사이 <span>둘만의 기록</span></a><slot /><nav aria-label="우리 사이 안내"><a href="/our-sai/">앱 소개</a><a href="/our-sai/privacy/">개인정보처리방침</a><a href="/our-sai/support/">지원·삭제 안내</a><a href="/our-sai/terms/">이용 안내</a></nav></main>
</SiteLayout>
<style is:global>
.our-sai{max-width:800px;margin:48px auto;padding:0 24px 72px;color:var(--os-fg,#30263d)}.our-sai .brand{color:var(--os-brand,#7448b7);font-weight:800;text-decoration:none}.our-sai .brand span{font-size:14px;font-weight:400;margin-left:8px}.our-sai h1{font-size:clamp(30px,6vw,48px);line-height:1.3;margin:32px 0 20px}.our-sai h2{font-size:24px;margin:36px 0 12px}.our-sai p,.our-sai li{line-height:1.85;overflow-wrap:anywhere}.our-sai a{color:var(--os-link,#68409d);text-underline-offset:4px}.our-sai nav{display:flex;gap:12px 22px;flex-wrap:wrap;margin-top:48px;border-top:1px solid var(--os-line,#e4daef);padding-top:24px}.our-sai .intro{font-size:20px}.our-sai .note{background:var(--os-note,#f3edf9);padding:20px;border-radius:16px}.our-sai ul{padding-left:24px}
/* T-261012-029: 다크 모드 — 회사홈과 같은 바탕(tokens.css)에 「우리 사이」 보라 톤을 밝게 맞춘다. 라이트는 var() 대체값(원래색) 그대로. */
@media (prefers-color-scheme: dark){html[data-theme="auto"] .our-sai{--os-fg:#e9e1f4;--os-brand:#b997f2;--os-link:#c3a5f6;--os-line:#3b3149;--os-note:#251f2f}}
</style>
