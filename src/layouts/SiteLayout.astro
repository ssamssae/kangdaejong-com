---
import "../styles/tokens.css";
import "../styles/site.css";
import brandManifest from "../../public/brand/manifest.json";

const {
  minimal = false,
  title,
  description,
  canonical,
  active = "",
  robots,
  bodyClass = "",
  // 테마 선택은 없다 — T-261024-058(대종님 「다크를 풀고 전부 라이트」): 공용 tokens.css 에 다크 블록이 없고, 모든 화면이 <html data-theme="light"> 다.
  //   (T-261024-050 까지는 회사 홈만 라이트 고정이고 단백질 도감만 기기 설정(auto)을 따랐다. 그 분기와 다크 그림 세트는 걷어냈다.)
  langToggle = false, // true = 공용 헤더에 한국어/EN 전환 버튼을 띄운다. 페이지가 자기 사전으로 lang-toggle-core 를 시작해야 한다. (T-261012-029)
  fonts = "mono", // Google Fonts 요청 범위: "mono"(JetBrains Mono) | "mono-serif"(+Noto Serif KR) | "none". (T-261011-068)
  jsonLd = null, // schema.org 객체. 있으면 JSON-LD 로 넣는다. (T-261011-068)
  ogImage = `https://kangdaejong.com/brand/current/social.png?v=${brandManifest.files["social.png"].sha256.slice(0, 16)}`,
  ogImageAlt = "마이너스베타스튜디오 — 만들고, 써 보고, 다듬어요.",
} = Astro.props;

const company = "마이너스베타스튜디오";
const documentTitle = title ? `${title} — ${company}` : company;
// T-261013-004: 색·폭의 단 하나의 원본. 회사홈은 같은 사이트 경로, 같은 저장소의 다른 사이트(단백질)는 회사홈 주소를 읽는다 —
// 그래야 색을 바꿀 때 회사홈만 배포하면 된다.
// 회사홈 빌드(astro.config.mjs)는 site 가 없고, 단백질 빌드는 site = protein.kangdaejong.com 이다.
const tokensHref = Astro.site && Astro.site.hostname !== "kangdaejong.com" ? "https://kangdaejong.com/brand/current/tokens.css" : "/brand/current/tokens.css";
const googleFonts =
  fonts === "none"
    ? null
    : fonts === "mono-serif"
      ? "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Noto+Serif+KR:wght@500;600&display=swap"
      : "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap";
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;
---

<!doctype html>
<html lang="ko" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <link rel="stylesheet" href={tokensHref} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@minusbetastudio" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="https://kangdaejong.com/brand/current/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="https://kangdaejong.com/brand/current/logo.svg" />
    <link rel="apple-touch-icon" href="https://kangdaejong.com/brand/current/apple-touch-icon.png" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    {googleFonts && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href={googleFonts} rel="stylesheet" />
      </>
    )}
    <link rel="stylesheet" href="/studio-page.css" />
    <title>{documentTitle}</title>
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    <script is:inline src="https://kangdaejong.com/mb-components.js" defer></script>
  </head>
  <body class={`studio-page ${bodyClass}`}>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    {!minimal && <mb-header active={active} tone="studio" lang-toggle={langToggle || undefined}></mb-header>}
    <slot />
    {!minimal && <mb-footer tone="studio"></mb-footer>}
  </body>
</html>
