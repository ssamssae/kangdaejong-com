---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import {apps} from '../../../data/home';
import {appSupport} from '../../../data/app-support.mjs';
import '../../../styles/renewal.css';

export function getStaticPaths() {
  return Object.entries(appSupport).map(([id,support])=>({
    params:{app:support.slug},props:{app:apps.find(app=>app.id===id),support},
  }));
}
const {app,support}=Astro.props;
const canonical=`https://kangdaejong.com/apps/${support.slug}/`;
---
<SiteLayout title={`${app.name} — 앱 안내와 지원`} description={`${app.description} 다운로드, 웹 버전, 개인정보처리방침과 문의 방법을 확인하세요.`} canonical={canonical} active="products" bodyClass="renewal" langToggle>
  <main id="main-content" class="support-page" data-app-name={app.name}>
    <header>
      <img src={app.icon} srcset={`${app.icon2x} 2x`} width="80" height="80" alt="" />
      <p class="r-kicker">앱 안내</p>
      <h1>{app.name}</h1><p class="lead">{app.description}</p>
      <div class="downloads">
        <a class="r-button" href={`https://apps.apple.com/kr/app/id${app.appId}`}>App Store ↗</a>
        <a class="r-button secondary" href={`https://play.google.com/store/apps/details?id=${app.package}`}>Google Play ↗</a>
      </div>
    </header>
    <section aria-labelledby="web-title">
      <h2 id="web-title">웹 버전</h2>
      <p>기존 웹 버전을 쓰셨다면 같은 브라우저에서 열어 주세요.</p>
      <a href={support.web} data-app-web>웹 버전 열기 ↗</a>
    </section>
    <section aria-labelledby="privacy-title">
      <h2 id="privacy-title">개인정보처리방침</h2>
      <p><a href={support.privacy} data-app-privacy>{support.iosPrivacy?'Android 개인정보처리방침':'개인정보처리방침 보기'} ↗</a></p>
      {support.iosPrivacy&&<p><a href={support.iosPrivacy}>iOS 개인정보처리방침 ↗</a></p>}
    </section>
    <section aria-labelledby="help-title">
      <h2 id="help-title">사용 문의</h2>
      <p>앱 이름, 사용하는 기기와 문제가 생긴 순서를 알려주세요.</p>
      <a href={`mailto:minusbetastudio@gmail.com?subject=${encodeURIComponent(app.name+' 사용 문의')}`}>이메일로 문의하기 ↗</a>
    </section>
    <p class="all-apps"><a href="/#products">다른 앱 보기 ↗</a></p>
  </main>
  <script>
    import dict from '../../../data/i18n-en.json';
    import {startLangToggle} from '../../../scripts/lang-toggle-core.js';
    const name=document.querySelector('[data-app-name]')?.getAttribute('data-app-name')||'';
    const englishName=dict[name as keyof typeof dict]||name;
    startLangToggle({...dict,__title:`${englishName} — App guide and support — Minus Beta Studio`,__description:`Downloads, web version, privacy policies and support for ${englishName}.`});
  </script>
</SiteLayout>
<style>
  /* T-261024-050: 첫이름 service 페이지(.hero → .block)와 같은 값 — 숫자는 공용 톤 값만. */
  body.studio-page .support-page{width:min(calc(100% - var(--tone-gutter) * 2),var(--tone-prose-max));margin:0 auto;padding:var(--tone-hero-top) 0 var(--tone-section-gap);color:var(--fg)}
  header{padding:0 0 var(--tone-section-gap)}header img{border-radius:var(--tone-radius-card);margin-bottom:var(--tone-space-4)}h1{margin:0 0 var(--tone-space-3)}.lead{margin:0;color:var(--fg-dim);font-size:var(--tone-body-size);line-height:var(--tone-body-line)}
  .downloads{display:flex;flex-wrap:wrap;gap:var(--tone-space-1);margin-top:var(--tone-space-4)}section{border-top:1px solid var(--border);padding:var(--tone-section-gap) 0}h2{margin:0 0 var(--tone-space-2)}p{margin:0 0 var(--tone-space-3);color:var(--fg-dim);line-height:var(--tone-body-line);word-break:keep-all}
  a:not(.r-button){display:inline-flex;align-items:center;min-height:var(--tone-tap-height);color:var(--accent);font-weight:var(--tone-weight-bold);text-underline-offset:var(--tone-underline-offset)}.all-apps{margin:0;padding-top:var(--tone-space-4);border-top:1px solid var(--border)}@media(max-width:760px){section{padding:var(--tone-space-6) 0}.downloads{flex-direction:column}.downloads a{display:flex}}
</style>
