---
import "../styles/home-simple.css";
import StudioFooter from "../components/StudioFooter.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
const company = {
  name: "마이너스베타스튜디오",
  representative: "강대종",
  email: "minusbetastudio@gmail.com",
  since: "2026년 5월 4일",
};
---
<SiteLayout title="스튜디오 소개" description="강대종이 만들고 운영하는 1인 소프트웨어 스튜디오, 마이너스베타스튜디오를 소개해요." canonical="https://kangdaejong.com/organization/" minimal bodyClass="simple-home">
  <mb-header active="organization" tone="studio"></mb-header>
  <main id="main-content" class="home-width">
    <section class="intro" aria-labelledby="studio-title">
      <p class="eyebrow">스튜디오 소개</p>
      <h1 id="studio-title">만들고, 운영하는 사람.<br /><span>강대종이에요.</span></h1>
      <p class="lead">마이너스베타스튜디오는 서울 마포에서 시작한<br class="desktop" /> 1인 소프트웨어 스튜디오예요.</p>
      <p class="detail">기획과 개발부터 운영, 문의 응대까지 직접 맡아요.<br />실제로 필요한 문제를 해결하는 서비스를 만들려고 해요.</p>
    </section>
    <section class="now" aria-labelledby="now-title"><p class="eyebrow">지금</p><div><h2 id="now-title">작은 도구를 만들어 운영하고 있어요.</h2><p>텔레그램 브릿지, 입타, 자비스와 생활 앱을 직접 만들고 다듬어요.<br />지금 공개 중인 것은 홈에서 살펴볼 수 있어요.</p><p class="now-links"><a class="mb-link" href="/#projects">프로젝트 보기</a><a class="mb-link" href="/#products">앱 보기</a></p></div></section>
    <section class="company" aria-labelledby="company-title"><div><p class="eyebrow">기본 정보</p><h2 id="company-title">스튜디오 정보</h2></div><dl><div><dt>상호</dt><dd>{company.name}</dd></div><div><dt>대표</dt><dd>{company.representative}</dd></div><div><dt>개업일</dt><dd>{company.since}</dd></div><div><dt>사업자등록번호</dt><dd>878-21-02478</dd></div><div><dt>통신판매업 신고</dt><dd>제 2026-서울마포-1177 호</dd></div><div><dt>소재지</dt><dd>서울특별시 마포구 만리재로10길 4 (공덕동)</dd></div><div><dt>전화</dt><dd><a href="tel:01074842927">010-7484-2927</a></dd></div></dl></section>
    <section id="contact" class="contact"><p class="eyebrow">문의</p><h2>문의는 이곳으로 보내주세요.</h2><p>스튜디오 및 기존 서비스에 관한 문의를 받아요.</p><div class="contact-links"><a class="mb-link" href="tel:01048672382">010-4867-2382 ↗</a><a class="mb-link" href={`mailto:${company.email}`}>{company.email} ↗</a></div></section>
  </main>
  <StudioFooter />
</SiteLayout>
<style>
/* T-261024-050: 첫이름 service 페이지(.hero → .card → .block)와 같은 값 — 숫자는 공용 톤 값만. */
.eyebrow{margin:0 0 var(--tone-space-1);color:var(--fg-dim);font:var(--tone-weight-bold) var(--tone-caption-size)/var(--tone-caption-line) var(--tone-font);letter-spacing:normal}.lead{margin:var(--tone-space-3) 0 0!important;color:var(--fg-dim);font-size:var(--tone-body-size);line-height:var(--tone-body-line)}.detail{margin-top:var(--tone-space-3);color:var(--fg-dim);font-size:var(--tone-body-size);line-height:var(--tone-body-line)}.now{padding:var(--tone-card-padding);background:var(--bg-elev);border:0;border-radius:var(--tone-radius-card)}.now h2{margin:0 0 var(--tone-space-1)}.now .mb-link.mb-link{color:var(--accent-hover)}.now p:not(.eyebrow),.contact p{margin-top:0;color:var(--fg-dim);font-size:var(--tone-body-size);line-height:var(--tone-body-line)}.now-links,.contact-links{display:flex;flex-wrap:wrap;gap:var(--tone-space-1) var(--tone-space-3);margin-top:var(--tone-space-1)}.company{display:grid;grid-template-columns:1fr 2fr;gap:var(--tone-space-5);margin-top:var(--tone-section-gap);padding:var(--tone-section-gap) 0;border-top:1px solid var(--border)}.company h2{margin:0}dl{margin:0}dl>div{display:grid;grid-template-columns:140px 1fr;gap:var(--tone-space-3);padding:var(--tone-space-3) 0;border-top:1px solid var(--border);font-size:var(--tone-label-size)}dl>div:first-child{border-top:0;padding-top:0}dt{color:var(--fg-dim)}dd{margin:0;color:var(--fg);font-weight:var(--tone-weight-bold);overflow-wrap:anywhere}.contact{padding:var(--tone-section-gap) 0;border-top:1px solid var(--border)}.contact h2{margin:0 0 var(--tone-space-2)}.contact-links{margin-top:var(--tone-space-3)}.contact-links a{overflow-wrap:anywhere}@media(max-width:760px){.desktop{display:none}.company{grid-template-columns:1fr;gap:var(--tone-space-4);margin-top:var(--tone-space-6);padding:var(--tone-space-6) 0}dl>div{grid-template-columns:105px 1fr;gap:var(--tone-space-2)}.contact{padding:var(--tone-space-6) 0}}
</style>
