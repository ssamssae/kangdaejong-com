---
import "../styles/home-simple.css";
import StudioFooter from "../components/StudioFooter.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
const company = {
  name: "마이너스베타스튜디오",
  representative: "강대종",
  email: "minusbetastudio@gmail.com",
  since: "2026년 5월 4일",
};
---
<SiteLayout title="스튜디오 소개" description="강대종이 만들고 운영하는 1인 소프트웨어 스튜디오, 마이너스베타스튜디오를 소개합니다." canonical="https://kangdaejong.com/organization/" minimal bodyClass="simple-home">
  <mb-header active="organization" tone="studio"></mb-header>
  <main id="main-content" class="home-width">
    <section class="intro" aria-labelledby="studio-title">
      <p class="eyebrow">ABOUT THE STUDIO</p>
      <h1 id="studio-title">만들고, 운영하는 사람.<br /><span>강대종입니다.</span></h1>
      <p class="lead">마이너스베타스튜디오는 서울 마포에서 시작한<br class="desktop" /> 1인 소프트웨어 스튜디오입니다.</p>
      <p class="detail">기획과 개발부터 운영, 문의 응대까지 직접 맡습니다.<br />실제로 필요한 문제를 해결하는 서비스를 만들고자 합니다.</p>
    </section>
    <section class="now" aria-labelledby="now-title"><p class="eyebrow">NOW</p><div><h2 id="now-title">새로운 서비스를 준비하고 있습니다.</h2><p>지금까지의 경험을 바탕으로 다음 서비스를 준비하고 있습니다.<br />서비스의 내용과 이용 방법은 준비가 되면 공개하겠습니다.</p></div></section>
    <section class="company" aria-labelledby="company-title"><div><p class="eyebrow">STUDIO INFORMATION</p><h2 id="company-title">스튜디오 정보</h2></div><dl><div><dt>상호</dt><dd>{company.name}</dd></div><div><dt>대표</dt><dd>{company.representative}</dd></div><div><dt>개업일</dt><dd>{company.since}</dd></div><div><dt>사업자등록번호</dt><dd>878-21-02478</dd></div><div><dt>통신판매업 신고</dt><dd>제 2026-서울마포-1177 호</dd></div><div><dt>소재지</dt><dd>서울특별시 마포구 만리재로10길 4 (공덕동)</dd></div><div><dt>전화</dt><dd><a href="tel:01074842927">010-7484-2927</a></dd></div></dl></section>
    <section id="contact" class="contact"><p class="eyebrow">CONTACT</p><h2>문의는 이곳으로 보내주세요.</h2><p>스튜디오 및 기존 서비스에 관한 문의를 받습니다.</p><div><a href="tel:01074842927">010-7484-2927 ↗</a></div><a href={`mailto:${company.email}`}>{company.email} ↗</a></section>
  </main>
  <StudioFooter />
</SiteLayout>
<style>
.intro{padding:76px 0 66px}.eyebrow{font:500 12px var(--sans);color:#69717d;letter-spacing:.05em;margin-bottom:20px}.lead{font-size:18px;line-height:1.8;margin:25px 0 16px!important;color:#535b68}.detail{font-size:15px;color:#626b78;line-height:1.9}.now{padding:28px;background:#f7f8fa;border:1px solid #e6e8ed;border-radius:12px}.now p:not(.eyebrow),.contact p{font-size:14px;line-height:1.9;color:#626b78;margin-top:12px}.company{display:grid;grid-template-columns:1fr 2fr;gap:32px;padding:48px 0}dl{margin:0}dl>div{display:grid;grid-template-columns:140px 1fr;gap:18px;padding:16px 0;border-bottom:1px solid #e6e8ed;font-size:14px;line-height:1.7}dt{color:#69717d}dd{margin:0;color:#242930}.contact{padding:38px 0 48px;border-top:1px solid #e6e8ed}.contact a{display:inline-block;color:#2458cc;font-size:18px;margin-top:20px;overflow-wrap:anywhere}@media(max-width:650px){.intro{padding:48px 0 38px}.lead{font-size:16px}.detail{font-size:14px}.desktop{display:none}.company{grid-template-columns:1fr;gap:20px;padding:32px 0}dl>div{grid-template-columns:105px 1fr;gap:12px;font-size:13px}.now{padding:22px}.contact a{font-size:16px}}
</style>
