---
import StudioFooter from "../components/StudioFooter.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
const company = {
  name: "마이너스베타스튜디오",
  representative: "강대종",
  email: "minusbetastudio@gmail.com",
  since: "2026년 5월 4일",
};
---
<SiteLayout title="스튜디오 소개" description="강대종이 만들고 운영하는 1인 소프트웨어 스튜디오, 마이너스베타스튜디오를 소개합니다." canonical="https://kangdaejong.com/organization/" minimal>
  <header class="shell"><a class="brand" href="/">MINUS BETA STUDIO<span>{company.name}</span></a><a class="back" href="/">홈으로 ↗</a></header>
  <main id="main-content" class="shell">
    <section class="intro" aria-labelledby="studio-title">
      <p class="eyebrow">ABOUT THE STUDIO</p>
      <h1 id="studio-title">만들고, 운영하는 사람.<br /><em>강대종입니다.</em></h1>
      <p class="lead">마이너스베타스튜디오는 서울 마포에서 시작한<br class="desktop" /> 1인 소프트웨어 스튜디오입니다.</p>
      <p class="detail">기획과 개발부터 운영, 문의 응대까지 직접 맡습니다.<br />실제로 필요한 문제를 해결하는 서비스를 만들고자 합니다.</p>
    </section>
    <section class="now" aria-labelledby="now-title"><p class="eyebrow">NOW</p><div><h2 id="now-title">새로운 서비스를 준비하고 있습니다.</h2><p>지금까지의 경험을 바탕으로 다음 서비스를 준비하고 있습니다.<br />서비스의 내용과 이용 방법은 준비가 되면 공개하겠습니다.</p></div></section>
    <section class="company" aria-labelledby="company-title"><div><p class="eyebrow">STUDIO INFORMATION</p><h2 id="company-title">스튜디오 정보</h2></div><dl><div><dt>상호</dt><dd>{company.name}</dd></div><div><dt>대표</dt><dd>{company.representative}</dd></div><div><dt>개업일</dt><dd>{company.since}</dd></div><div><dt>사업자등록번호</dt><dd>878-21-02478</dd></div><div><dt>통신판매업 신고</dt><dd>제 2026-서울마포-1177 호</dd></div><div><dt>소재지</dt><dd>서울특별시 마포구 만리재로10길 4 (공덕동)</dd></div></dl></section>
    <section id="contact" class="contact"><p class="eyebrow">CONTACT</p><h2>문의는 이곳으로 보내주세요.</h2><p>스튜디오 및 기존 서비스에 관한 문의를 받습니다.</p><a href={`mailto:${company.email}`}>{company.email} ↗</a></section>
  </main>
  <StudioFooter />
</SiteLayout>
<style>
.shell{width:min(1120px,calc(100% - 64px));margin:auto}header{padding:36px 0;border-bottom:1px solid #deded6;display:flex;justify-content:space-between;align-items:center;gap:20px}a{color:inherit;text-underline-offset:5px}.brand{text-decoration:none;font-size:13px;letter-spacing:.12em;font-weight:700;color:#282b25}.brand span{display:block;font-size:11px;letter-spacing:0;font-weight:400;margin-top:7px;color:#62655d}.back{font-size:12px;color:#62655d;text-decoration:none}.intro{padding:92px 0 76px;max-width:820px}.eyebrow{font-size:11px;letter-spacing:.19em;color:#777b6f;margin:0 0 24px}h1{font-size:clamp(34px,5.2vw,64px);line-height:1.25;letter-spacing:-.055em;font-weight:600;color:#282b25;margin:0}h1 em{font-style:normal;color:#a94830}.lead{font-size:21px;line-height:1.75;margin:32px 0 18px;color:#41473c}.detail{font-size:15px;line-height:1.9;color:#666a60}.now{display:grid;grid-template-columns:1fr 2fr;gap:32px;padding:36px;border:1px solid #dce0d3;border-radius:12px;background:#eff1e9}.now .eyebrow{margin:6px 0}h2{font-size:23px;line-height:1.5;letter-spacing:-.035em;font-weight:550;margin:0;color:#282b25}.now p:not(.eyebrow),.contact p:not(.eyebrow){font-size:14px;color:#666a60;line-height:1.9;margin:12px 0 0}.company{display:grid;grid-template-columns:1fr 2fr;gap:32px;padding:72px 0}.company .eyebrow{margin-bottom:12px}dl{margin:0}dl>div{display:grid;grid-template-columns:140px 1fr;gap:18px;padding:17px 0;border-bottom:1px solid #deded6;font-size:14px;line-height:1.7}dl>div:first-child{padding-top:0}dt{color:#74786f}dd{margin:0;color:#373e32}.contact{padding:48px 0 64px;border-top:1px solid #deded6}.contact a{display:inline-block;margin-top:24px;font-size:clamp(16px,3vw,24px);color:#a94830;overflow-wrap:anywhere}footer{border-top:1px solid #deded6;padding:24px 0 32px;display:flex;justify-content:space-between;gap:20px;color:#70746b;font-size:11px}footer nav{display:flex;gap:20px}footer a{text-decoration:none}a:hover{text-decoration:underline}a:focus-visible{outline:2px solid #a94830;outline-offset:5px}@media(max-width:650px){.shell{width:calc(100% - 40px)}.brand{font-size:11px}.intro{padding:60px 0 44px}.lead{font-size:17px}.detail{font-size:14px}.desktop{display:none}.now,.company{grid-template-columns:1fr;gap:20px}.now{padding:24px}.company{padding:44px 0}h2{font-size:20px}dl>div{grid-template-columns:105px 1fr;gap:14px;font-size:12px}.contact{padding:36px 0 44px}footer{flex-direction:column;gap:16px}}
</style>
