---
import SiteLayout from "../layouts/SiteLayout.astro";

const company = {
  name: "마이너스베타스튜디오",
  representative: "강대종",
  email: "minusbetastudio@gmail.com",
};

const principles = [
  {
    title: "방향은 사람이 정합니다.",
    description: "무엇을 만들고 무엇을 멈출지, 누구에게 어떤 약속을 할지는 법적 대표가 결정합니다.",
  },
  {
    title: "AI는 반복 작업을 돕습니다.",
    description: "조사·초안·구현·검증처럼 되풀이되는 작업에는 AI 도구를 쓰되, 결과를 책임 주체로 소개하지 않습니다.",
  },
  {
    title: "공개 전에는 다시 확인합니다.",
    description: "제품 변경, 외부 발신, 결제와 비용, 되돌리기 어려운 동작은 사람이 확인한 뒤 반영합니다.",
  },
];

const checks = [
  { label: "FACT", title: "사실", description: "제품 상태와 가격, 회사 정보가 공개 근거와 맞는지 확인합니다." },
  { label: "USE", title: "사용", description: "구매·다운로드·연락 링크가 실제 목적지까지 이어지는지 확인합니다." },
  { label: "CARE", title: "책임", description: "자동화가 빠른 것보다 사람이 되돌리고 설명할 수 있는지를 먼저 봅니다." },
];

const description = `${company.name}의 책임 구조 — 법적 대표 ${company.representative}이 방향, 공개, 비용을 결정하고 AI는 반복 작업을 보조합니다.`;
---

<SiteLayout title="회사와 책임" description={description} canonical="https://kangdaejong.com/organization/" active="organization" bodyClass="organization-page">
  <main id="main-content">
    <section class="subpage-hero" aria-labelledby="page-title">
      <div class="site-shell subpage-hero-grid">
        <div>
          <p class="eyebrow">Company & responsibility</p>
          <h1 class="page-title" id="page-title">작게 운영해도,<br />책임은 선명하게.</h1>
          <p class="lede">{company.name}는 {company.representative}이 운영하는 1인 사업자입니다. AI 도구를 함께 쓰지만, 제품과 고객에게 하는 약속의 책임은 사람에게 있습니다.</p>
        </div>
        <div class="subpage-mark" aria-hidden="true">責</div>
      </div>
    </section>

    <section class="responsibility-band" aria-label="법적 책임자">
      <div class="site-shell responsibility-row">
        <span>LEGAL OWNER</span>
        <strong>법적 대표 {company.representative}</strong>
        <p>1인 스튜디오 · 서울 마포</p>
      </div>
    </section>

    <section class="section site-shell" aria-labelledby="principles-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">Working principle</p>
          <h2 class="section-title" id="principles-title">AI는 도구이고,<br />결정은 사람의 일입니다.</h2>
        </div>
        <p class="section-intro">내부의 역할 이름이나 기기 목록보다, 방문자가 알아야 할 책임의 경계를 공개합니다.</p>
      </div>
      <ol class="principles">
        {principles.map((principle) => (
          <li class="principle">
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section site-shell" aria-labelledby="checks-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">Before publishing</p>
          <h2 class="section-title" id="checks-title">내보내기 전에 보는 세 가지.</h2>
        </div>
        <p class="section-intro">자동화의 속도는 유용하지만, 공개된 결과의 정확성과 사용 가능성을 대신하지는 않습니다.</p>
      </div>
      <div class="boundary-grid">
        {checks.map((item) => (
          <article class="boundary-item">
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="site-shell closing-callout" aria-label="회사 문의">
      <p>제품, 구매, 공개 도구에 관한 문의는 대표 이메일로 받습니다.</p>
      <div class="button-row">
        <a class="button" href="/">회사 홈으로</a>
        <a class="button primary" href={`mailto:${company.email}`}>이메일 문의</a>
      </div>
    </section>
  </main>
</SiteLayout>
