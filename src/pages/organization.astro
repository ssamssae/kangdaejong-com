---
import "../styles/home-simple.css";
import StudioFooter from "../components/StudioFooter.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
const company = {
  name: "마이너스베타스튜디오",
  representative: "강대종",
  email: "minusbetastudio@gmail.com",
  since: "2026년 5월 4일",
};
---
<SiteLayout theme="auto" title="스튜디오 소개" description="강대종이 만들고 운영하는 1인 소프트웨어 스튜디오, 마이너스베타스튜디오를 소개해요." canonical="https://kangdaejong.com/organization/" minimal bodyClass="simple-home">
  <mb-header active="organization" tone="studio"></mb-header>
  <main id="main-content" class="home-width">
    <section class="intro" aria-labelledby="studio-title">
      <p class="eyebrow">스튜디오 소개</p>
      <h1 id="studio-title">만들고, 운영하는 사람.<br /><span>강대종이에요.</span></h1>
      <p class="lead">마이너스베타스튜디오는 서울 마포에서 시작한<br class="desktop" /> 1인 소프트웨어 스튜디오예요.</p>
      <p class="detail">기획과 개발부터 운영, 문의 응대까지 직접 맡아요.<br />실제로 필요한 문제를 해결하는 서비스를 만들려고 해요.</p>
    </section>
    <section class="now" aria-labelledby="now-title"><p class="eyebrow">지금</p><div><h2 id="now-title">작은 도구를 만들어 운영하고 있어요.</h2><p>텔레그램 브릿지, 입타, 자비스와 생활 앱을 직접 만들고 다듬어요.<br />지금 공개 중인 것은 홈에서 살펴볼 수 있어요.</p><p class="now-links"><a href="/#projects">프로젝트 보기</a><a href="/#products">앱 보기</a></p></div></section>
    <section class="company" aria-labelledby="company-title"><div><p class="eyebrow">기본 정보</p><h2 id="company-title">스튜디오 정보</h2></div><dl><div><dt>상호</dt><dd>{company.name}</dd></div><div><dt>대표</dt><dd>{company.representative}</dd></div><div><dt>개업일</dt><dd>{company.since}</dd></div><div><dt>사업자등록번호</dt><dd>878-21-02478</dd></div><div><dt>통신판매업 신고</dt><dd>제 2026-서울마포-1177 호</dd></div><div><dt>소재지</dt><dd>서울특별시 마포구 만리재로10길 4 (공덕동)</dd></div><div><dt>전화</dt><dd><a href="tel:01074842927">010-7484-2927</a></dd></div></dl></section>
    <section id="contact" class="contact"><p class="eyebrow">문의</p><h2>문의는 이곳으로 보내주세요.</h2><p>스튜디오 및 기존 서비스에 관한 문의를 받아요.</p><div><a href="tel:01048672382">010-4867-2382 ↗</a></div><a href={`mailto:${company.email}`}>{company.email} ↗</a></section>
  </main>
  <StudioFooter />
</SiteLayout>
<style>
.intro{padding:76px 0 66px}.eyebrow{font:500 12px var(--sans);color:var(--fg-mute);letter-spacing:.05em;margin-bottom:20px}.lead{font-size:18px;line-height:1.8;margin:25px 0 16px!important;color:var(--text-2)}.detail{font-size:15px;color:var(--fg-dim);line-height:1.9}.now{padding:var(--tone-card-padding);background:var(--bg-elev);border:0;border-radius:var(--tone-radius-card)}.now p:not(.eyebrow),.contact p{font-size:14px;line-height:1.9;color:var(--fg-dim);margin-top:12px}.now-links{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:4px}.now-links a{display:inline-flex;align-items:center;min-height:44px;color:var(--accent);font-size:14px}.company{display:grid;grid-template-columns:1fr 2fr;gap:32px;padding:48px 0}dl{margin:0}dl>div{display:grid;grid-template-columns:140px 1fr;gap:18px;padding:16px 0;border-bottom:1px solid var(--border);font-size:14px;line-height:1.7}dt{color:var(--fg-mute)}dd{margin:0;color:var(--fg)}.contact{padding:38px 0 48px;border-top:1px solid var(--border)}.contact a{display:inline-block;color:var(--accent);font-size:18px;margin-top:20px;overflow-wrap:anywhere}@media(max-width:650px){.intro{padding:48px 0 38px}.lead{font-size:16px}.detail{font-size:14px}.desktop{display:none}.company{grid-template-columns:1fr;gap:20px;padding:32px 0}dl>div{grid-template-columns:105px 1fr;gap:12px;font-size:13px}.now{padding:var(--tone-card-padding)}.contact a{font-size:16px}}
</style>
