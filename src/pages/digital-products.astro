---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/renewal.css";
import { books } from "../data/home";
---
<SiteLayout title="전자책 판매 종료 안내" description="전자책 3종의 크몽 판매를 종료했습니다. 기존 무료 실습 양식은 계속 이용할 수 있습니다." canonical="https://kangdaejong.com/digital-products/" active="products" bodyClass="renewal">
  <main id="main-content" class="digital-page">
    <header><p class="r-kicker">전자책</p><h1>전자책 판매를 종료했습니다.</h1><p>2026년 10월 3일부터 아래 전자책 3종의 크몽 판매를 종료했습니다.</p></header>
    <section aria-label="판매 종료 전자책"><ul>{books.map(book => <li><h2>{book.name}</h2><p>{book.description}</p><span>판매 종료</span></li>)}</ul></section>
    <section><h2>무료 실습 양식</h2><p>공개된 실습 양식은 계속 이용할 수 있습니다.</p><ul><li><a href="/ebook-automation-workshop/vol1/templates/t01-repeat-work-inventory/">반복 업무 정리 양식 →</a></li><li><a href="/ai-team-ebook/vol2/templates/t01-task-queue/">AI 팀 작업 대기열 양식 →</a></li></ul></section>
    <a href="/#books">홈으로 돌아가기 →</a>
  </main>
</SiteLayout>
<style>.digital-page{max-width:960px;margin:0 auto;padding:64px 24px}h1{font-size:clamp(30px,5vw,48px);line-height:1.3}h2{font-size:24px}p{line-height:1.8;color:#53616a}section{padding:32px 0;border-top:1px solid #e6e8ed;margin-top:32px}ul{padding-left:22px}li{margin:24px 0}span{color:#6b7280;font-size:14px}a{color:#2458cc;text-underline-offset:4px}</style>
