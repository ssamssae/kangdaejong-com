x 0 25px}.palette-row button{width:23px;height:23px;border-radius:50%;border:3px solid #fff;outline:1px solid #d5ddcf;background:var(--swatch);cursor:pointer}.control-divider{border-top:1px solid #e3e7df;margin:2px 0 22px}.canvas-area{min-width:0;padding:24px}.canvas-toolbar{display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#7c8574;margin-bottom:16px}.text-button{background:none;border:0;text-decoration:underline;text-underline-offset:4px;color:#5a6e4e;font-size:11px;cursor:pointer;padding:8px}.canvas{background:repeating-conic-gradient(#f1f0eb 0% 25%,#faf9f5 0% 50%) 50%/20px 20px;aspect-ratio:1.45;display:flex;align-items:center;justify-content:center;border-radius:7px;overflow:hidden}:global(.canvas>svg){height:100%;width:100%;display:block}.canvas p{font-size:13px}#status{font-size:11px;line-height:1.7;min-height:38px;color:#697760;margin:12px 0}.symbol-heading{display:flex;justify-content:space-between;gap:12px;margin:20px 0 12px;font-size:12px}.symbol-heading span{font-size:10px;color:#87927c}.symbols{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}:global(.symbols button){min-width:0;width:100%;overflow:hidden;position:relative;border:1px solid #d8dfcf;background:#f8f9f2;border-radius:6px;aspect-ratio:1.2;cursor:pointer;padding:15px;color:#315443}:global(.symbols svg){width:100%;height:100%;max-height:75px}:global(.symbols button[aria-pressed=true]){outline:2px solid #315443;outline-offset:2px;background:#e7ecde}:global(.symbols button[aria-pressed=true]):after{content:'✓';position:absolute;top:5px;right:8px;font-size:12px}.ai-panel{display:flex;justify-content:space-between;gap:20px;align-items:center;border-top:1px solid #e2e7db;margin-top:26px;padding-top:23px}.ai-panel strong{font-size:12px}.ai-panel p{font-size:11px;line-height:1.7;color:#7e8874;margin:7px 0 0}.ai-panel button{white-space:nowrap;font-size:11px;padding:10px}.download-bar{background:#e8eddf;border:1px solid #d8dfce;border-radius:9px;padding:24px;ma