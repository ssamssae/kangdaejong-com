---
import SiteLayout from "../layouts/SiteLayout.astro";

const destination = "https://work.kangdaejong.com/system/";
const steps = [
  {
    title: "작은 문제부터 만듭니다.",
    description: "한 번에 많은 기능을 약속하기보다, 지금 해결할 한 가지 일을 정하고 제품의 범위를 작게 잡습니다.",
  },
  {
    title: "실제로 눌러 보고 확인합니다.",
    description: "빌드와 자동 검사를 통과하는 데서 끝내지 않고, 화면·링크·다운로드·모바일 동작을 직접 확인합니다.",
  },
  {
    title: "출시 뒤에도 고쳐 갑니다.",
    description: "생활 도구는 한 번의 출시보다 꾸준한 유지가 중요합니다. 기록을 남기고 문제를 작게 되돌릴 수 있게 운영합니다.",
  },
];

const description = "마이너스베타스튜디오가 제품을 작게 만들고, 확인하고, 오래 유지하는 공개 원칙.";
---

<SiteLayout title="만드는 방식" description={description} canonical="https://kangdaejong.com/system/" active="system" bodyClass="studio-page">
  <main id="main-content" class="studio-width" tabindex="-1">
    <section class="studio-hero" aria-labelledby="page-title">
      <p class="studio-label">만들고 운영하는 방식</p>
      <h1 id="page-title">작게 만들고, 확인하고,<br/><span>오래 돌봅니다.</span></h1>
      <p class="studio-lead">생활 가까운 제품을 무리 없이 계속 운영하기 위한 약속입니다.</p>
    </section>
    <section class="studio-section" aria-labelledby="sequence-title">
      <h2 id="sequence-title">제품이 오래 남게 하는 세 단계.</h2>
      <div class="studio-cards">{steps.map((step,index)=><article class="studio-card"><span class="step-number">0{index+1}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
    </section>
    <section class="studio-section" aria-labelledby="boundary-title">
      <h2 id="boundary-title">자동화가 넘지 않는 선.</h2>
      <p class="boundary-copy">AI와 자동화 도구는 조사와 반복 작업을 돕습니다. 공개, 외부 발신, 결제, 배포처럼 영향이 큰 일은 사람이 근거를 확인하고 결정합니다.</p>
    </section>
    <section class="studio-section" aria-label="시스템 관련 링크">
      <h2>더 자세한 작업 기록</h2><p class="boundary-copy">운영 문서와 작업 기록은 공개 작업장에서 볼 수 있습니다.</p>
      <div class="system-links"><a class="studio-link" href="/">회사 홈으로</a><a class="studio-link" href="https://choso.kangdaejong.com/guest">초소 둘러보기</a><a class="studio-link" href={destination}>운영 시스템 자세히 보기</a></div>
    </section>
  </main>
</SiteLayout>
<style>.step-number{font-size:11px;color:#69717d}.studio-card h3{margin:18px 0 9px}.studio-card p{margin:0}.boundary-copy{font-size:14px;line-height:1.9;color:#626b78;max-width:700px;margin:16px 0 0}.system-links{display:flex;gap:24px;flex-wrap:wrap}</style>
