---
import EbookTemplatePage from "../../../../components/EbookTemplatePage.astro";

export function getStaticPaths() {
  const templates = {
    "t01-task-queue": { file: "t01-task-queue.md", title: "AI 팀 운영 템플릿 01 - 일감 큐 시트" },
    "t02-distribution-rules": { file: "t02-distribution-rules.md", title: "AI 팀 운영 템플릿 02 - 작업 분배 규칙표" },
    "t03-approval-gate": { file: "t03-approval-gate.md", title: "AI 팀 운영 템플릿 03 - 승인 게이트 체크리스트" },
    "t04-incident-response": { file: "t04-incident-response.md", title: "AI 팀 운영 템플릿 04 - 사고 대응 룰 모음" },
  };
  return Object.entries(templates).map(([slug, meta]) => ({ params: { slug }, props: { meta } }));
}

const { meta } = Astro.props;
---

<EbookTemplatePage
  meta={meta}
  sourceSegments={["ai-team-ebook", "vol2", "templates"]}
  rawBase="ai-team-ebook/vol2/templates"
  eyebrow="AI TEAM OPERATIONS · VOL2 APPENDIX"
  sourceNote="「혼자서 AI 팀 운영하기」 Vol2 부록용 공개 템플릿"
  description="혼자서 AI 팀 운영하기 Vol2 부록 템플릿"
/>
