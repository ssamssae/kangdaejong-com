---
import '../styles/home-tone.css';
import MenuPicker from '../components/MenuPicker.astro';
import StudioFooter from '../components/StudioFooter.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectVersions from '../components/ProjectVersions.astro';
import { currentProjects, featuredProjects } from '../data/project-versions';
---
<SiteLayout title="강대종의 프로젝트 2.0" description="텔레그램 브릿지, 입타, 자비스. 내 컴퓨터의 AI를 연결하고, 말로 쓰고, 목소리로 부르는 강대종의 프로젝트." canonical="https://kangdaejong.com/" minimal bodyClass="home-editorial">
  <header class="studio-header"><a href="/" aria-label="마이너스베타스튜디오 홈"><img src="https://kangdaejong.com/brand/current/logo.svg" alt="" width="48" height="48" /><div>MINUS BETA STUDIO<span>마이너스베타스튜디오</span></div></a><a class="header-index" href="#projects">프로젝트 인덱스 <span aria-hidden="true">↘</span></a></header>
  <main id="main-content">
    <section class="hero" aria-labelledby="chapter-title">
      <div class="hero-meta"><p class="eyebrow">INDEPENDENT STUDIO · SEOUL</p><ProjectVersions current="2.0" /></div>
      <div class="hero-copy">
        <div class="hero-title"><p class="hero-name">강대종의 프로젝트</p><h1 id="chapter-title">내 컴퓨터의 AI를,<br /><span>더 가까이.</span></h1></div>
        <div class="edition" aria-label="프로젝트 2.0"><span class="edition-caption">THE SECOND CHAPTER</span><span class="version">2.0<span class="dot">.</span></span><span class="edition-foot">연결하고 · 말하고 · 부르다</span></div>
      </div>
      <div class="hero-bottom"><p class="intro">브릿지로 연결하고, 입타로 쓰고,<br />자비스를 목소리로 부릅니다.</p><a class="jump" href="#projects">대표 프로젝트 보기 <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="projects" id="projects" aria-labelledby="projects-title">
      <div class="section-heading"><div><p class="eyebrow">01 — SELECTED WORK</p><h2 id="projects-title">브릿지 · 입타 · 자비스</h2></div><p>직접 만들고, 쓰고, 다듬습니다.</p></div>
      <div class="project-grid featured-project-grid">{featuredProjects.map((project, index) => <article class:list={["project-card", `project-${index}`]}>
        <div class="project-visual" aria-hidden="true">
          <div class="visual-label"><span>MINUS BETA / 0{index + 1}</span><span>↗</span></div>
          {index === 0 ? <div class="bridge-art"><div class="bridge-phone"><span>요청</span><i></i><i></i><b>↗</b></div><span class="bridge-line">↔</span><div class="bridge-desktop"><span>내 컴퓨터</span><i></i><i></i><b>응답 ↙</b></div></div> : index === 1 ? <div class="ipta-art"><div class="wave">{[12,24,40,28,52,68,40,24,46,60,34,18,28].map(height => <i style={`--bar:${height}px`}></i>)}</div><span>말이 글이 되는 순간<span class="caret">|</span></span></div> : <div class="jarvis-art"><div class="voice-orbit"><div class="voice-core"><span>자비스</span><small>듣고 있어요</small></div></div></div>}
          <span class="visual-caption">{['A BRIDGE TO YOUR AI', 'YOUR VOICE, IN WORDS', 'A VOICE FOR YOUR COMPUTER'][index]}</span>
        </div>
        <div class="card-copy"><div class="card-top"><span class="project-status">{project.status}</span></div>
        <p class="category">0{index + 1} / {project.category}</p><h3>{project.name}</h3><p class="description">{project.description}</p>
        <a href={project.href}>{project.action} <span aria-hidden="true">↗</span></a>
        </div>
      </article>)}</div>
    </section>
    <div class="interlude"><MenuPicker /></div>
    <section class="projects" aria-labelledby="other-projects-title">
      <div class="section-heading"><div><p class="eyebrow">02 — EVERYDAY TOOLS</p><h2 id="other-projects-title">함께 만드는 서비스</h2></div><p>일상에서 쓰는 작은 도구들</p></div>
      <div class="other-grid">{currentProjects.slice(1).map(project => <article class="other-card"><p class="category">{project.status}</p><h3>{project.name}</h3><p class="description">{project.description}</p><a href={project.href}>{project.action} ↗</a></article>)}</div>
    </section>
    <section class="chapters" aria-label="이전과 다음 프로젝트">
      <a class="previous" href="/archive/"><span class="eyebrow">CHAPTER 01 / 1.0</span><h2>지금의 시작이 된 것들</h2><p>입타 이전에 만든 앱과 웹 서비스,<br />공개 도구를 모았습니다.</p><span class="chapter-action">1.0 프로젝트 둘러보기 ↗</span></a>
      <div class="next"><span class="eyebrow">CHAPTER 03 / 3.0</span><h2>다음 이야기는, 나중에.</h2><p>새로운 장을 시작하면<br />이곳에 이어 담겠습니다.</p><span class="chapter-note">아직 시작하지 않은 다음 버전</span></div>
    </section>
  </main>
  <StudioFooter />
  <script is:inline>
    // Preserve existing book links when moving between project chapters.
    const openArchivedSection = () => {
      if (window.location.hash === '#books') window.location.replace('/archive/' + window.location.search + '#books');
    };
    openArchivedSection();
    window.addEventListener('hashchange', openArchivedSection);
  </script>
</SiteLayout>
