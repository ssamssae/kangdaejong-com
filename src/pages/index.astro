---
const company = {
  name: "마이너스베타스튜디오",
  representative: "강대종",
  bizNumber: "878-21-02478",
  mailOrderNumber: "제 2026-서울마포-1177 호",
  address: "서울특별시 마포구 만리재로10길 4 (공덕동)",
  category: "정보통신업 / 응용 소프트웨어 개발 및 공급업",
  email: "minusbetastudio@gmail.com",
  github: "github.com/ssamssae",
  work: "https://work.kangdaejong.com/",
  products: "https://work.kangdaejong.com/products/",
  newsletter: "https://daejongkang.substack.com",
};

const slogan = "Tools Worth Keeping.";
const sloganKo = "덜어내서, 오래 남을 도구를 만듭니다.";
const intro = "마이너스베타스튜디오는 강대종이 운영하는 1인 스튜디오입니다. 모바일 앱, 작은 웹 서비스, 공개 자동화 도구를 직접 만들고 운영합니다. 반복 작업은 AI 자동화와 작업 노드로 줄이고, 사람의 판단이 필요한 지점은 기록과 검증으로 남깁니다.";

const heroStats = [
  { label: "대표", value: company.representative },
  { label: "형태", value: "1인 스튜디오" },
  { label: "분야", value: "앱 · 웹 · 자동화" },
];

const focusAreas = [
  {
    number: "01",
    title: "모바일 앱",
    desc: "메모, 일기, 복약, 정산처럼 매일 반복되는 일을 가볍게 만드는 iOS/Android 앱을 만듭니다.",
  },
  {
    number: "02",
    title: "웹 서비스",
    desc: "작은 유료 서비스와 공개 페이지를 직접 설계하고 배포하며, 사용 흐름이 짧은 도구를 우선합니다.",
  },
  {
    number: "03",
    title: "자동화 도구",
    desc: "실제 운영에서 쓰는 Codex·Claude 브릿지와 작업 노드 자동화를 공개 가능한 형태로 정리합니다.",
  },
];

const apps = [
  {
    name: "메모요",
    status: "iOS · Android LIVE",
    desc: "빠르게 쓰고 지우는 심플 메모 앱.",
    links: [
      { label: "App Store", url: "https://apps.apple.com/kr/app/id6762068073" },
      { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.daejongkang.simple_memo_app" },
    ],
  },
  {
    name: "한줄일기",
    status: "iOS · Android LIVE",
    desc: "하루 한 줄 기록과 AI 응원 답글.",
    links: [
      { label: "App Store", url: "https://apps.apple.com/kr/app/id6764308678" },
      { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.daejongkang.hanjul" },
    ],
  },
  {
    name: "더치페이 계산기",
    status: "iOS LIVE",
    desc: "모임 자리의 금액을 바로 나누는 정산 도구.",
    links: [{ label: "App Store", url: "https://apps.apple.com/kr/app/id6762072499" }],
  },
  {
    name: "약먹자",
    status: "iOS LIVE",
    desc: "복약 시간을 놓치지 않게 돕는 알림 앱.",
    links: [{ label: "App Store", url: "https://apps.apple.com/kr/app/id6762100639" }],
  },
];

const tools = [
  {
    name: "Codex Telegram Bridge",
    status: "오픈소스 · 공개 repo",
    desc: "Codex CLI REPL을 텔레그램으로 제어하는 브릿지. 텍스트, 이미지, 영상, 음성, 파일 입력과 진행 보고를 지원합니다.",
    repo: "https://github.com/ssamssae/codex-telegram-bridge",
    releases: "https://github.com/ssamssae/codex-telegram-bridge/releases",
  },
  {
    name: "Claude Telegram Bridge",
    status: "오픈소스 · 공개 repo",
    desc: "Claude Code live tmux 세션을 텔레그램에 연결하는 브릿지. 세션 주입, transcript 추출, 미디어 전달 흐름을 다룹니다.",
    repo: "https://github.com/ssamssae/claude-telegram-bridge",
    releases: "https://github.com/ssamssae/claude-telegram-bridge/releases",
  },
];

const links = [
  { label: "작업장", desc: "제품, 작업일지, 뉴스레터, 인사이트를 모아둔 공개 허브.", href: company.work, meta: "work.kangdaejong.com" },
  { label: "제품", desc: "공개 앱, 웹 서비스, 자동화 도구 전체 목록.", href: company.products, meta: "products" },
  { label: "뉴스레터", desc: "1인 스튜디오의 빌드, 운영, 실패 복구 기록.", href: company.newsletter, meta: "Substack" },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${company.name} — 오래 남을 앱, 웹 서비스, 공개 자동화 도구를 만드는 1인 스튜디오. 대표 ${company.representative}.`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Pretendard:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{company.name}</title>
    <script is:inline src="/mb-components.js" defer></script>
  </head>
  <body>
    <mb-header active="home"></mb-header>
    <main>
      <section class="hero" id="top" aria-labelledby="page-title">
        <div class="hero-copy">
          <p class="eyebrow">MINUS BETA STUDIO</p>
          <h1 id="page-title">{company.name}</h1>
          <p class="lead">{sloganKo} 모바일 앱, 작은 웹 서비스, 공개 자동화 도구를 직접 만들고 오래 운영합니다.</p>
          <div class="hero-actions" aria-label="주요 링크">
            <a class="button primary" href={`mailto:${company.email}`}>문의하기</a>
            <a class="button" href={company.work}>작업장 보기</a>
          </div>
        </div>
        <aside class="hero-panel" aria-label="회사 요약">
          <img src="/minusbeta-badge.svg" alt="마이너스베타스튜디오 로고" width="88" height="88" />
          <strong>{slogan}</strong>
          <p>더하기보다 빼기. 꼭 필요한 것만 남긴 도구를 만듭니다.</p>
          <dl>
            {heroStats.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </section>

      <section class="statement-section" aria-labelledby="statement-title">
        <div class="section-head">
          <p class="eyebrow">IDENTITY</p>
          <h2 id="statement-title">작게 만들고, 오래 고칩니다.</h2>
        </div>
        <p>{intro}</p>
      </section>

      <section class="focus-section" aria-labelledby="focus-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">WHAT WE BUILD</p>
            <h2 id="focus-title">하는 일</h2>
          </div>
          <p>기획, 개발, 배포, 운영을 한 흐름으로 묶어 빠르게 검증합니다.</p>
        </div>
        <ol class="focus-list">
          {focusAreas.map((item) => (
            <li>
              <span>{item.number}</span>
              <strong>{item.title}</strong>
              <p>{item.desc}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="products-section" aria-labelledby="products-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">PRODUCTS</p>
            <h2 id="products-title">대표 제품</h2>
          </div>
          <a class="text-link" href={company.products}>전체 제품 보기</a>
        </div>
        <div class="product-grid">
          {apps.map((app) => (
            <article class="product-card">
              <span>{app.status}</span>
              <h3>{app.name}</h3>
              <p>{app.desc}</p>
              <div class="link-row">
                {app.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener">{link.label} →</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="tools-section" aria-labelledby="tools-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">OPEN TOOLS</p>
            <h2 id="tools-title">공개 자동화 도구</h2>
          </div>
          <p>내부에서 실제로 쓰는 도구를 공개 repo로 정리합니다.</p>
        </div>
        <div class="tool-grid">
          {tools.map((tool) => (
            <article class="tool-card">
              <div class="tool-top">
                <h3>{tool.name}</h3>
                <span>{tool.status}</span>
              </div>
              <p>{tool.desc}</p>
              <div class="link-row">
                <a href={tool.repo} target="_blank" rel="noopener">GitHub →</a>
                <a href={tool.releases} target="_blank" rel="noopener">Release →</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="connect-section" aria-labelledby="connect-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">CONNECT</p>
            <h2 id="connect-title">연결</h2>
          </div>
          <p>제품과 기록은 공개 페이지에서, 연락은 이메일로 받습니다.</p>
        </div>
        <div class="connect-list">
          {links.map((link) => (
            <a href={link.href}>
              <span>{link.label}</span>
              <strong>{link.desc}</strong>
              <em>{link.meta} →</em>
            </a>
          ))}
        </div>
      </section>

      <section class="company-section" aria-labelledby="company-title">
        <div class="section-head">
          <p class="eyebrow">COMPANY</p>
          <h2 id="company-title">회사 정보</h2>
        </div>
        <dl class="company-info">
          <div>
            <dt>상호</dt>
            <dd>{company.name}</dd>
          </div>
          <div>
            <dt>대표</dt>
            <dd>{company.representative}</dd>
          </div>
          <div>
            <dt>사업자등록번호</dt>
            <dd>{company.bizNumber}</dd>
          </div>
          <div>
            <dt>통신판매업신고</dt>
            <dd>{company.mailOrderNumber}</dd>
          </div>
          <div>
            <dt>업종</dt>
            <dd>{company.category}</dd>
          </div>
          <div>
            <dt>소재지</dt>
            <dd>{company.address}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div>
            <dt>GitHub</dt>
            <dd><a href={`https://${company.github}`} target="_blank" rel="noopener">{company.github}</a></dd>
          </div>
        </dl>
      </section>
    </main>
    <mb-footer></mb-footer>

    <style is:global>
      :root {
        --bg: #ffffff;
        --bg-elev: #f7f7f7;
        --bg-elev2: #eeeeee;
        --fg: #111111;
        --fg-dim: #4f4f4f;
        --fg-mute: #777777;
        --border: #dedede;
        --border-soft: #eeeeee;
        --accent: #2563eb;
        --accent-dim: #1748b8;
        --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
        --sans: "Pretendard", -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: var(--bg);
        scroll-behavior: smooth;
        scrollbar-gutter: stable;
      }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        line-height: 1.65;
        text-rendering: geometricPrecision;
      }

      [id] {
        scroll-margin-top: 96px;
      }

      main {
        width: min(calc(100% - 48px), 1120px);
        margin: 0 auto;
        padding: 52px 0 72px;
      }

      a {
        color: var(--fg);
        text-decoration: none;
      }

      a:hover {
        color: var(--accent);
      }

      h1,
      h2,
      h3 {
        color: var(--fg);
        font-weight: 700;
        letter-spacing: 0;
      }

      p {
        color: var(--fg-dim);
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
        gap: 48px;
        align-items: end;
        min-height: 560px;
        border-bottom: 1px solid var(--border);
        padding: 24px 0 52px;
      }

      .hero-copy,
      .hero-panel {
        min-width: 0;
      }

      .eyebrow {
        color: var(--fg-mute);
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0;
        margin-bottom: 12px;
      }

      .hero h1 {
        max-width: 760px;
        font-size: 76px;
        line-height: 1;
        margin-bottom: 22px;
        overflow-wrap: anywhere;
        word-break: keep-all;
      }

      .lead {
        max-width: 660px;
        color: var(--fg-dim);
        font-size: 20px;
        line-height: 1.75;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 28px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0 16px;
        color: var(--fg);
        font-size: 14px;
        font-weight: 700;
      }

      .button.primary {
        border-color: var(--accent);
        background: var(--accent);
        color: #ffffff;
      }

      .button:hover {
        border-color: var(--fg);
        color: var(--fg);
      }

      .button.primary:hover {
        border-color: var(--accent-dim);
        background: var(--accent-dim);
        color: #ffffff;
      }

      .hero-panel {
        border-top: 1px solid var(--fg);
        padding-top: 18px;
      }

      .hero-panel img {
        display: block;
        width: 88px;
        height: 88px;
        border-radius: 20px;
        margin-bottom: 22px;
      }

      .hero-panel strong {
        display: block;
        color: var(--fg);
        font-family: var(--mono);
        font-size: 24px;
        line-height: 1.15;
        margin-bottom: 10px;
      }

      .hero-panel p {
        color: var(--fg-dim);
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 22px;
      }

      .hero-panel dl,
      .company-info {
        display: grid;
        grid-template-columns: 1fr;
        border-top: 1px solid var(--border);
      }

      .hero-panel dl div,
      .company-info div {
        display: grid;
        grid-template-columns: 112px minmax(0, 1fr);
        gap: 14px;
        align-items: baseline;
        border-bottom: 1px solid var(--border);
        min-height: 50px;
        padding: 12px 0;
      }

      .hero-panel dt,
      .company-info dt {
        color: var(--fg-mute);
        font-size: 13px;
        font-weight: 600;
      }

      .hero-panel dd,
      .company-info dd {
        color: var(--fg);
        font-size: 15px;
        font-weight: 600;
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .statement-section,
      .focus-section,
      .products-section,
      .tools-section,
      .connect-section,
      .company-section {
        margin-top: 72px;
      }

      .section-head {
        margin-bottom: 20px;
      }

      .section-head.split {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        align-items: end;
      }

      .section-head h2 {
        font-size: 30px;
        line-height: 1.25;
      }

      .section-head.split > p {
        max-width: 380px;
        color: var(--fg-mute);
        font-size: 14px;
        line-height: 1.65;
        text-align: right;
      }

      .statement-section {
        border-bottom: 1px solid var(--border);
        padding-bottom: 52px;
      }

      .statement-section > p {
        max-width: 820px;
        color: var(--fg-dim);
        font-size: 19px;
        line-height: 1.85;
        word-break: keep-all;
      }

      .focus-list {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        list-style: none;
        border-top: 1px solid var(--fg);
        border-left: 1px solid var(--border);
      }

      .focus-list li {
        min-height: 240px;
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: 18px;
      }

      .focus-list span,
      .product-card > span,
      .tool-top span,
      .connect-list em {
        color: var(--fg-mute);
        font-family: var(--mono);
        font-size: 12px;
        font-style: normal;
        font-weight: 600;
      }

      .focus-list strong {
        display: block;
        color: var(--fg);
        font-size: 22px;
        line-height: 1.3;
        margin: 54px 0 14px;
      }

      .focus-list p {
        color: var(--fg-dim);
        font-size: 15px;
        line-height: 1.75;
        word-break: keep-all;
      }

      .product-grid,
      .tool-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .product-card,
      .tool-card {
        min-width: 0;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg);
        padding: 18px;
      }

      .product-card:hover,
      .tool-card:hover {
        border-color: var(--fg);
      }

      .product-card h3,
      .tool-card h3 {
        color: var(--fg);
        font-size: 22px;
        line-height: 1.32;
        margin: 34px 0 10px;
        overflow-wrap: anywhere;
        word-break: keep-all;
      }

      .product-card p,
      .tool-card p {
        color: var(--fg-dim);
        font-size: 15px;
        line-height: 1.7;
        word-break: keep-all;
      }

      .link-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
      }

      .link-row a,
      .text-link {
        color: var(--fg);
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 600;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      .link-row a:hover,
      .text-link:hover {
        color: var(--accent);
      }

      .tool-top {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: flex-start;
      }

      .tool-top h3 {
        margin-top: 0;
      }

      .tool-top span {
        flex: 0 0 auto;
        padding-top: 4px;
      }

      .connect-list {
        display: grid;
        grid-template-columns: 1fr;
        border-top: 1px solid var(--fg);
      }

      .connect-list a {
        display: grid;
        grid-template-columns: 120px minmax(0, 1fr) 180px;
        gap: 18px;
        align-items: baseline;
        border-bottom: 1px solid var(--border);
        min-height: 62px;
        padding: 14px 0;
      }

      .connect-list a:hover strong {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      .connect-list span {
        color: var(--fg-mute);
        font-size: 13px;
        font-weight: 700;
      }

      .connect-list strong {
        color: var(--fg);
        font-size: 15px;
        line-height: 1.5;
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .connect-list em {
        text-align: right;
        overflow-wrap: anywhere;
      }

      .company-info {
        border-top-color: var(--fg);
      }

      .company-info a {
        color: var(--fg);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
          min-height: 0;
          gap: 36px;
        }

        .focus-list {
          grid-template-columns: 1fr;
        }

        .focus-list li {
          min-height: 0;
        }

        .focus-list strong {
          margin-top: 34px;
        }

        .connect-list a {
          grid-template-columns: 100px minmax(0, 1fr);
