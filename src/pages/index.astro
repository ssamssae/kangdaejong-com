      .connect-list a { display: flex; flex-direction: column; gap: 6px; }

      .connect-list a:hover { border-color: var(--accent); color: var(--fg); }

      .connect-list a > span { color: var(--fg); font-size: var(--text-lead); font-weight: 700; line-height: 1.3; }

      .connect-list strong {
