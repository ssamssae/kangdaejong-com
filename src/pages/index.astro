        .proof-inner { border-bottom: 0; }

        .proof-inner > div {
          padding: 18px 0;
          border-left: 0;
          border-bottom: 1px solid var(--border-soft);
        }

        .proof-inner > div + div { padding-left: 0; }

        .product-card.featured { padding: 0; }

        .featured-copy { padding: 22px; }

        .company-info div { grid-template-columns: 1fr; gap: 3px; }
      }
    </style>
