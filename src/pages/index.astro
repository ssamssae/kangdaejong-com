---
const company = {
  name: "마이너스베타스튜디오",
  representative: "강대종",
  bizNumber: "878-21-02478",
  mailOrderNumber: "제 2026-서울마포-1177 호",
  address: "서울특별시 마포구 만리재로10길 4 (공덕동)",
  category: "정보통신업 / 응용 소프트웨어 개발 및 공급업",
  email: "minusbetastudio@gmail.com",
  github: "github.com/ssamssae",
  work: "https://work.kangdaejong.com/",
  products: "https://work.kangdaejong.com/products/",
  newsletter: "https://minusbetastudio.substack.com",
};

const slogan = "Tools Worth Keeping.";
const sloganKo = "작게 만들고, 오래 운영합니다.";
const intro = "마이너스베타스튜디오는 강대종이 운영하는 1인 스튜디오입니다. 생활에 가까운 모바일 앱, 짧게 쓰는 웹 서비스, 실제 운영에서 쓰는 공개 자동화 도구를 직접 만들고 유지합니다.";

const proofPoints = [
  { label: "LIVE APPS", value: "4", desc: "출시 후 직접 운영" },
  { label: "OPEN TOOLS", value: "2", desc: "브릿지·자동화 공개" },
  { label: "STUDIO", value: "1인", desc: "기획부터 고객응대까지" },
  { label: "LOOP", value: "기록 기반", desc: "작업일지와 검증으로 개선" },
];

const focusAreas = [
  {
    number: "01",
    title: "생활 앱",
    desc: "메모, 일기, 복약, 정산처럼 매일 반복되는 일을 빠르게 처리하는 작은 앱을 만듭니다.",
  },
  {
    number: "02",
    title: "작업장 웹",
    desc: "제품, 뉴스레터, 작업일지, 실험 페이지를 공개해 만드는 과정과 결과를 같이 남깁니다.",
  },
  {
    number: "03",
    title: "운영 자동화",
    desc: "반복 작업은 에이전트와 브릿지로 줄이고, 사람 판단이 필요한 지점은 검증 절차로 묶습니다.",
  },
];

const operatingLoop = [
  { step: "BUILD", title: "작게 만든다", desc: "한 번에 거대한 제품보다, 문제 하나를 해결하는 단위로 시작합니다." },
  { step: "SHIP", title: "바로 내보낸다", desc: "앱스토어, 웹, 공개 repo까지 실제 사용 가능한 형태로 배포합니다." },
  { step: "WATCH", title: "계속 본다", desc: "테스터 피드백, 작업일지, 오류 로그를 모아 다음 수정의 근거로 씁니다." },
  { step: "REFINE", title: "덜어낸다", desc: "기능을 늘리기보다 사용 흐름을 짧게 만들고 오래 남길 것만 남깁니다." },
];

const apps = [
  {
    name: "메모요",
    status: "iOS · Android LIVE",
    desc: "빠르게 쓰고 지우는 심플 메모 앱.",
    links: [
      { label: "App Store", url: "https://apps.apple.com/kr/app/id6762068073" },
      { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.daejongkang.simple_memo_app" },
    ],
  },
  {
    name: "한줄일기",
    status: "iOS · Android LIVE",
    desc: "하루 한 줄 기록과 AI 응원 답글.",
    links: [
      { label: "App Store", url: "https://apps.apple.com/kr/app/id6764308678" },
      { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.daejongkang.hanjul" },
    ],
  },
  {
    name: "더치페이 계산기",
    status: "iOS LIVE",
    desc: "모임 자리의 금액을 바로 나누는 정산 도구.",
    links: [{ label: "App Store", url: "https://apps.apple.com/kr/app/id6762072499" }],
  },
  {
    name: "약먹자",
    status: "iOS LIVE",
    desc: "복약 시간을 놓치지 않게 돕는 알림 앱.",
    links: [{ label: "App Store", url: "https://apps.apple.com/kr/app/id6762100639" }],
  },
  {
    name: "첫이름",
    status: "웹 LIVE",
    desc: "사주와 획수, 인명용 한자를 따져 아이 이름 후보를 뽑아주는 AI 작명 서비스.",
    links: [{ label: "바로가기", url: "https://cheotireum.kangdaejong.com/" }],
  },
];

const tools = [
  {
    name: "Codex Telegram Bridge",
    status: "오픈소스 · 공개 repo",
    desc: "Codex CLI REPL을 텔레그램으로 제어하는 브릿지. 텍스트, 이미지, 영상, 음성, 파일 입력과 진행 보고를 지원합니다.",
    repo: "https://github.com/ssamssae/codex-telegram-bridge",
    releases: "https://github.com/ssamssae/codex-telegram-bridge/releases",
  },
  {
    name: "Claude Telegram Bridge",
    status: "오픈소스 · 공개 repo",
    desc: "Claude Code live tmux 세션을 텔레그램에 연결하는 브릿지. 세션 주입, transcript 추출, 미디어 전달 흐름을 다룹니다.",
    repo: "https://github.com/ssamssae/claude-telegram-bridge",
    releases: "https://github.com/ssamssae/claude-telegram-bridge/releases",
  },
];

const links = [
  { label: "작업장", desc: "제품, 작업일지, 뉴스레터, 인사이트를 모아둔 공개 허브.", href: company.work, meta: "work.kangdaejong.com" },
  { label: "제품", desc: "공개 앱, 웹 서비스, 자동화 도구 전체 목록.", href: company.products, meta: "products" },
  { label: "뉴스레터", desc: "1인 스튜디오의 빌드, 운영, 실패 복구 기록.", href: company.newsletter, meta: "Substack" },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${company.name} — 오래 남을 앱, 웹 서비스, 공개 자동화 도구를 만드는 1인 스튜디오. 대표 ${company.representative}.`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Pretendard:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{company.name}</title>
    <script is:inline src="/mb-components.js" defer></script>
  </head>
  <body>
    <mb-header active="home"></mb-header>
    <main>
      <section class="hero" id="top" aria-labelledby="page-title">
        <div class="hero-inner">
          <img class="hero-mark" src="/minusbeta-badge.svg" alt="" width="640" height="640" aria-hidden="true" />
          <div class="hero-copy">
            <p class="eyebrow">MINUS BETA STUDIO</p>
            <h1 id="page-title"><span>마이너스</span><span>베타스튜디오</span></h1>
            <p class="tagline">{slogan}</p>
            <p class="lead">{sloganKo} 모바일 앱, 작은 웹 서비스, 공개 자동화 도구를 직접 만들고 검증하며 운영합니다.</p>
            <div class="hero-actions" aria-label="주요 링크">
              <a class="button primary" href={company.products}>제품 보기</a>
              <a class="button" href={company.work}>작업장 보기</a>
              <a class="button" href={`mailto:${company.email}`}>문의하기</a>
            </div>
          </div>
          <aside class="hero-aside" aria-label="스튜디오 운영 요약">
            <div class="aside-top">
              <span>OPERATING STUDIO</span>
              <strong>1 person</strong>
            </div>
            <ul>
              <li><span>Build</span><strong>앱 · 웹 · 자동화</strong></li>
              <li><span>Record</span><strong>작업일지 · 뉴스레터</strong></li>
              <li><span>Open</span><strong>GitHub · 공개 도구</strong></li>
            </ul>
          </aside>
        </div>
      </section>

      <section class="proof-strip" aria-label="스튜디오 요약">
        <div class="proof-inner">
          {proofPoints.map((item) => (
            <div>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <div class="page-shell">
      <section class="statement-section" aria-labelledby="statement-title">
        <div class="section-head">
          <p class="eyebrow">IDENTITY</p>
          <h2 id="statement-title">혼자 만들지만 혼자만 보지 않습니다.</h2>
        </div>
        <div class="statement-grid">
          <p>{intro}</p>
          <p>제품은 출시 상태로, 과정은 작업장에, 도구는 공개 저장소에 남깁니다. 작게 시작한 도구가 오래 쓰이도록 기능보다 운영과 회복력을 먼저 봅니다.</p>
        </div>
      </section>

      <section class="focus-section" aria-labelledby="focus-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">WHAT WE BUILD</p>
            <h2 id="focus-title">하는 일</h2>
          </div>
          <p>기획, 개발, 배포, 운영을 한 흐름으로 묶어 빠르게 검증합니다.</p>
        </div>
        <ol class="focus-list">
          {focusAreas.map((item) => (
            <li>
              <span>{item.number}</span>
              <strong>{item.title}</strong>
              <p>{item.desc}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="loop-section" aria-labelledby="loop-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">OPERATING LOOP</p>
            <h2 id="loop-title">만드는 방식</h2>
          </div>
          <p>작게 만들고, 빠르게 공개하고, 기록으로 다시 줄입니다.</p>
        </div>
        <div class="loop-list">
          {operatingLoop.map((item) => (
            <article>
              <span>{item.step}</span>
              <strong>{item.title}</strong>
              <p>{item.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="products-section" aria-labelledby="products-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">PRODUCTS</p>
            <h2 id="products-title">대표 제품</h2>
          </div>
          <a class="text-link" href={company.products}>전체 제품 보기</a>
        </div>
        <div class="product-grid">
          {apps.map((app) => (
            <article class="product-card">
              <span>{app.status}</span>
              <h3>{app.name}</h3>
              <p>{app.desc}</p>
              <div class="link-row">
                {app.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener">{link.label} →</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="tools-section" aria-labelledby="tools-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">OPEN TOOLS</p>
            <h2 id="tools-title">공개 자동화 도구</h2>
          </div>
          <p>내부에서 실제로 쓰는 도구를 공개 repo로 정리합니다.</p>
        </div>
        <div class="tool-grid">
          {tools.map((tool) => (
            <article class="tool-card">
              <div class="tool-top">
                <h3>{tool.name}</h3>
                <span>{tool.status}</span>
              </div>
              <p>{tool.desc}</p>
              <div class="link-row">
                <a href={tool.repo} target="_blank" rel="noopener">GitHub →</a>
                <a href={tool.releases} target="_blank" rel="noopener">Release →</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="connect-section" aria-labelledby="connect-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">CONNECT</p>
            <h2 id="connect-title">연결</h2>
          </div>
          <p>제품과 기록은 공개 페이지에서, 연락은 이메일로 받습니다.</p>
        </div>
        <div class="connect-list">
          {links.map((link) => (
            <a href={link.href}>
              <span>{link.label}</span>
              <strong>{link.desc}</strong>
              <em>{link.meta} →</em>
            </a>
          ))}
        </div>
      </section>

      <section class="company-section" aria-labelledby="company-title">
        <div class="section-head">
          <p class="eyebrow">COMPANY</p>
          <h2 id="company-title">회사 정보</h2>
        </div>
        <dl class="company-info">
          <div>
            <dt>상호</dt>
            <dd>{company.name}</dd>
          </div>
          <div>
            <dt>대표</dt>
            <dd>{company.representative}</dd>
          </div>
          <div>
            <dt>사업자등록번호</dt>
            <dd>{company.bizNumber}</dd>
          </div>
          <div>
            <dt>통신판매업신고</dt>
            <dd>{company.mailOrderNumber}</dd>
          </div>
          <div>
            <dt>업종</dt>
            <dd>{company.category}</dd>
          </div>
          <div>
            <dt>소재지</dt>
            <dd>{company.address}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div>
            <dt>GitHub</dt>
            <dd><a href={`https://${company.github}`} target="_blank" rel="noopener">{company.github}</a></dd>
          </div>
        </dl>
      </section>
      </div>
    </main>
    <mb-footer></mb-footer>

    <style is:global>
      :root {
        --bg: #ffffff;
        --bg-elev: #f7f7f7;
        --bg-elev2: #eeeeee;
        --fg: #111111;
        --fg-dim: #4f4f4f;
        --fg-mute: #777777;
        --border: #dedede;
        --border-soft: #eeeeee;
        --accent: #2563eb;
        --accent-dim: #1748b8;
        --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;
        --sans: "Pretendard", -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", sans-serif;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background: var(--bg);
        scroll-behavior: smooth;
        scrollbar-gutter: stable;
      }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        line-height: 1.65;
        text-rendering: geometricPrecision;
      }

      [id] {
        scroll-margin-top: 96px;
      }

      main { width: 100%; margin: 0; padding: 0 0 72px; }

      .page-shell { width: min(calc(100% - 48px), 1120px); margin: 0 auto; }

      a {
        color: var(--fg);
        text-decoration: none;
      }

      a:hover {
        color: var(--accent);
      }

      h1,
      h2,
      h3 {
        color: var(--fg);
        font-weight: 700;
        letter-spacing: 0;
      }

      p {
        color: var(--fg-dim);
      }

      .hero {
        position: relative;
        overflow: hidden;
        min-height: min(540px, calc(100svh - 180px));
        border-bottom: 1px solid var(--border);
        background: var(--bg);
      }

      .hero-inner {
        position: relative;
        width: min(calc(100% - 48px), 1120px);
        min-height: inherit;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(260px, 348px);
        gap: clamp(28px, 5vw, 56px);
        align-items: center;
        padding: 64px 0 58px;
      }

      .hero-copy {
        position: relative;
        z-index: 1;
        max-width: 760px;
        min-width: 0;
      }

      .hero-mark {
        position: absolute;
        right: clamp(-220px, -8vw, -72px);
        bottom: clamp(-220px, -10vw, -84px);
        width: min(58vw, 640px);
        height: auto;
        opacity: 0.055;
        pointer-events: none;
        user-select: none;
      }

      .eyebrow {
        color: var(--fg-mute);
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0;
        margin-bottom: 12px;
      }

      .hero h1 {
        max-width: 760px;
        font-size: 76px;
        line-height: 1;
        margin-bottom: 14px;
        overflow-wrap: anywhere;
        word-break: keep-all;
      }

      .hero h1 span {
        display: inline-block;
      }

      .tagline {
        color: var(--fg);
        font-family: var(--mono);
        font-size: 14px;
        font-weight: 600;
        line-height: 1.5;
        margin-bottom: 18px;
      }

      .lead {
        max-width: 660px;
        color: var(--fg-dim);
        font-size: 20px;
        line-height: 1.75;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 28px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0 16px;
        color: var(--fg);
        font-size: 14px;
        font-weight: 700;
      }

      .button.primary {
        border-color: var(--accent);
        background: var(--accent);
        color: #ffffff;
      }

      .button:hover {
        border-color: var(--fg);
        color: var(--fg);
      }

      .button.primary:hover {
        border-color: var(--accent-dim);
        background: var(--accent-dim);
        color: #ffffff;
      }

      .hero-aside {
        position: relative;
        z-index: 1;
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: rgba(247, 247, 247, 0.92);
        padding: 20px;
      }

      .aside-top {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: baseline;
        border-bottom: 1px solid var(--fg);
        padding-bottom: 14px;
      }

      .aside-top span,
      .hero-aside li span {
        color: var(--fg-mute);
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 600;
      }

      .aside-top strong {
        color: var(--fg);
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
      }

      .hero-aside ul {
        display: grid;
        list-style: none;
      }

      .hero-aside li {
        display: grid;
        grid-template-columns: 76px minmax(0, 1fr);
        gap: 14px;
        align-items: baseline;
        border-bottom: 1px solid var(--border);
        padding: 14px 0;
      }

      .hero-aside li:last-child {
        border-bottom: 0;
        padding-bottom: 0;
      }

      .hero-aside li strong {
        color: var(--fg);
        font-size: 15px;
        line-height: 1.45;
        overflow-wrap: anywhere;
      }

      .company-info {
        display: grid;
        grid-template-columns: 1fr;
        border-top: 1px solid var(--border);
      }

      .company-info div {
        display: grid;
        grid-template-columns: 112px minmax(0, 1fr);
        gap: 14px;
        align-items: baseline;
        border-bottom: 1px solid var(--border);
        min-height: 50px;
        padding: 12px 0;
      }

      .company-info dt {
        color: var(--fg-mute);
        font-size: 13px;
        font-weight: 600;
      }

      .company-info dd {
        color: var(--fg);
        font-size: 15px;
        font-weight: 600;
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .proof-strip {
        border-bottom: 1px solid var(--border);
        background: var(--bg);
      }

      .proof-inner {
        width: min(calc(100% - 48px), 1120px);
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
