    <mb-footer tone="studio"></mb-footer>

    <style is:global>
      /* Linear 크롬 (T-260831-005 기준점). 값은 src/styles/tokens.css 와 같아야 한다. */
      :root {
        color-scheme: dark;
        --bg: #08090A;
        --bg-elev: #0F1011;
        --bg-elev2: #1C1C1F;
        --fg: #F7F8F8;
        --fg-dim: #D0D6E0;
        --fg-mute: #8A8F98;
        --border: rgba(255, 255, 255, 0.08);
        --border-soft: rgba(255, 255, 255, 0.05);
        --accent: #7170FF;
        --accent-dim: #828FFF;
        --cta-fg: #08090A;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      html { color-scheme: dark; background: var(--bg); scroll-behavior: smooth; scrollbar-gutter: stable; }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        line-height: var(--leading-body);
        text-rendering: geometricPrecision;
      }

      ::selection { background: var(--fg); color: var(--bg); }

      [id] { scroll-margin-top: 96px; }

      main { width: 100%; margin: 0; padding: 0 0 72px; }

      .page-shell { width: min(calc(100% - 92px), 1250px); margin: 0 auto; }

      a { color: var(--fg); text-decoration: none; }
      a:hover { color: var(--accent); }

      h1, h2, h3 { color: var(--fg); font-family: var(--sans); font-weight: 510; letter-spacing: -0.022em; }
      p { color: var(--fg-dim); }

      .eyebrow {
        font-family: var(--mono);
        font-size: var(--text-meta);
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--fg-mute);
      }

      main section {
        padding: var(--pad-section) 0;
        border-bottom: 1px solid var(--border-soft);
      }

      .company-section { border-bottom: 0; }

      .section-head { margin-bottom: var(--pad-head-bottom); }
      .section-head h2 {
        margin-top: 10px;
        font-size: var(--text-h2);
        line-height: 1.18;
        word-break: keep-all;
      }

      .section-head.split > p {
        max-width: var(--measure);
        margin-top: 14px;
        font-size: var(--text-body);
        color: var(--fg-mute);
        word-break: keep-all;
      }

      .section-head .text-link { display: inline-block; margin-top: 12px; }

      @media (min-width: 860px) {
        .section-head.split {
          display: grid;
          grid-template-columns: minmax(0, 1.15fr) minmax(220px, 0.85fr);
          gap: 48px;
          align-items: end;
        }
        .section-head.split > p,
        .section-head.split .text-link { margin-top: 0; }
      }

      .focus-list li,
      .connect-list a,
      .product-card,
      .tool-card {
        min-width: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        background: var(--bg);
        padding: 22px 22px;
      }

      .focus-list li > span,
      .product-card > span,
      .featured-copy > span,
      .tool-top span {
        font-family: var(--mono);
        font-size: var(--text-badge);
        font-weight: 600;
        letter-spacing: var(--track-badge);
        color: var(--fg-mute);
        text-transform: uppercase;
      }

      .hero { position: relative; overflow: hidden; padding: 104px 0 40px; }

      .hero-inner {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
        gap: clamp(24px, 4vw, 48px);
        align-items: end;
        min-height: 0;
      }

      .hero-copy { position: relative; z-index: 1; min-width: 0; max-width: 40rem; }

