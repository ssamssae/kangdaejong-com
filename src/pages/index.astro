        font-weight: 400;
        line-height: var(--leading-desc);
        overflow-wrap: anywhere;
      }

      .connect-list em {
        margin-top: auto;
        padding-top: 10px;
        font-family: var(--mono);
        font-size: var(--text-meta);
        font-style: normal;
        font-weight: 600;
        color: var(--fg-mute);
        overflow-wrap: anywhere;
      }

      .connect-list a:hover em { color: var(--accent); }

      .company-info {
        display: grid;
        grid-template-columns: 1fr;
        border-top: 1px solid var(--border);
      }

      .company-info div {
        display: grid;
        grid-template-columns: 112px minmax(0, 1fr);
        gap: 14px;
        align-items: baseline;
        border-bottom: 1px solid var(--border-soft);
        padding: 14px 0;
      }

      .company-info dt {
        font-family: var(--mono);
        font-size: var(--text-meta);
        font-weight: 600;
        letter-spacing: var(--track-badge);
        color: var(--fg-mute);
      }

      .company-info dd {
        color: var(--fg);
        font-size: var(--text-body);
        font-weight: 500;
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .company-info a {
        color: var(--fg);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      @media (max-width: 900px) {
        .hero { padding-top: 56px; min-height: 0; }

        .hero-inner { min-height: 0; grid-template-columns: 1fr; }

        .hero-figure img { height: 260px; }

        .product-card.featured { grid-template-columns: 1fr; }

        .proof-inner,
        .product-grid,
        .ebooks-section .product-grid,
        .tool-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

        .focus-list,
        .connect-list { grid-template-columns: 1fr; }

        .proof-inner > div + div { padding-left: 16px; }
      }

      @media (max-width: 640px) {
        .page-shell { width: calc(100% - 48px); }

        main { padding-bottom: 56px; }

        main section { padding: var(--pad-section-sm) 0; }

        .hero { padding: 40px 0 12px; }

        .hero-mark { right: -160px; top: -40px; width: 420px; opacity: 0.05; }

        .proof-inner,
        .product-grid,
        .ebooks-section .product-grid,
