        margin: 16px 0 14px;
        font-size: var(--text-h1);
        line-height: var(--leading-h1);
        font-weight: 510;
        letter-spacing: -0.022em;
        overflow-wrap: anywhere;
        word-break: keep-all;
      }

      .hero h1 span { display: block; }

