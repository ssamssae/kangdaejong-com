---
import '../styles/home-simple.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import StudioFooter from '../components/StudioFooter.astro';
import SocialBanner from '../components/SocialBanner.astro';
import InsightBanner from '../components/InsightBanner.astro';
import MoodCorner from '../components/MoodCorner.astro';
import { productIcon } from '../lib/product-icons.mjs';
import { currentProjects } from '../data/project-versions';
import { apps, books, tools } from '../data/home';
import { appSupport } from '../data/app-support.mjs';
const srcsetFor = (entry?: { icon: string; icon2x?: string }) => entry?.icon2x ? `${entry.icon}, ${entry.icon2x} 2x` : undefined;
const ipta = productIcon('ipta');
const jarvis = productIcon('jarvis');
// 텔레그램 브릿지 카드의 그림 = 그록봇이 2026-10-11 만든 4칸 카드(Claude·Codex·Grok·Cursor), 480/960px WebP.
const bridgesVisual = { src: '/product-screens/telegram-bridges-531861e1-480.webp', srcset: '/product-screens/telegram-bridges-531861e1-480.webp 480w, /product-screens/telegram-bridges-531861e1-960.webp 960w', alt: 'Claude, Codex, Grok, Cursor 네 가지 오픈소스 텔레그램 브릿지' };
const projects = [
  { name: '텔레그램 브릿지', mark: '↔', description: '휴대폰에서 내 컴퓨터의 AI에게 요청하고 답을 받아요.', note: '공개 소스', href: '#open-tools', action: '설치 안내', icon: null, icon2x: null, visual: bridgesVisual },
  { id: 'ipta', name: '입타', mark: '입', description: '쓰던 입력칸에서 말하면 글이 돼요. Mac과 Windows에서 써요.', note: '음성 입력', href: '/ipta/', action: '입타 알아보기', icon: ipta?.icon ?? null, icon2x: ipta?.icon2x ?? null, visual: null },
  { id: 'jarvis', name: '자비스', mark: '⌁', description: '목소리로 부르고, AI의 답을 스피커로 듣는 개인 비서예요.', note: '실험 중 · 공개 소스', href: 'https://github.com/ssamssae/jarvis-mac', action: '소스 보기', icon: jarvis?.icon ?? null, icon2x: jarvis?.icon2x ?? null, visual: null },
];
// 검색엔진용 구조화 데이터. 공개 페이지에 이미 있는 정보만 담는다 (T-261011-068).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': 'https://kangdaejong.com/#org', name: '마이너스베타스튜디오', alternateName: 'Minus Beta Studio',
      url: 'https://kangdaejong.com/', logo: 'https://kangdaejong.com/brand/current/logo.svg', email: 'minusbetastudio@gmail.com',
      founder: { '@id': 'https://kangdaejong.com/#person' },
      sameAs: ['https://github.com/ssamssae', 'https://www.instagram.com/minusbetastudio/', 'https://www.threads.com/@minusbetastudio', 'https://x.com/minusbetastudio', 'https://www.youtube.com/channel/UCp92-I0U8c-R2KT8u7gbIXQ', 'https://www.linkedin.com/in/minusbetastudio', 'https://minusbetastudio.substack.com', 'https://blog.naver.com/ssamssae'],
    },
    { '@type': 'Person', '@id': 'https://kangdaejong.com/#person', name: '강대종', alternateName: 'Daejong Kang', url: 'https://kangdaejong.com/founder/', worksFor: { '@id': 'https://kangdaejong.com/#org' }, sameAs: ['https://github.com/ssamssae', 'https://www.linkedin.com/in/minusbetastudio'] },
    { '@type': 'WebSite', '@id': 'https://kangdaejong.com/#website', url: 'https://kangdaejong.com/', name: '마이너스베타스튜디오', inLanguage: 'ko', publisher: { '@id': 'https://kangdaejong.com/#org' } },
  ],
};
---
<SiteLayout title="강대종 — 직접 만드는 작은 도구들" description="강대종의 프로젝트를 한곳에. 텔레그램 브릿지, 입타, 자비스와 생활 앱, 만들며 배운 기록을 만나보세요." canonical="https://kangdaejong.com/" minimal bodyClass="simple-home" jsonLd={jsonLd}>
  <mb-header active="home" tone="studio" lang-toggle></mb-header>
  <main id="main-content" class="home-width" tabindex="-1">
    <InsightBanner />
    <section class="intro" aria-labelledby="intro-title">
      <p class="intro-label">만들고, 써 보고, 다듬어요.</p>
      <h1 id="intro-title">안녕하세요.<br/>만드는 사람 <span>강대종</span>이에요.</h1>
      <p class="intro-description">일할 때 필요한 도구부터 일상의 작은 앱까지.<br class="desktop-break"/> 직접 만들어 쓰는 것들을 이곳에 모았어요.</p>
      <div class="intro-links"><a class="mb-btn mb-btn--primary" href="#projects">프로젝트 둘러보기 <span aria-hidden="true">↓</span></a><a class="mb-btn mb-btn--secondary" href="https://github.com/ssamssae" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
    </section>
    <section id="projects" class="home-section" aria-labelledby="projects-title">
      <div class="section-title"><h2 id="projects-title">만드는 도구</h2><span>일하는 방식을 조금 더 편하게</span></div>
      {/* T-261025-009: 링크가 하나뿐인 카드(브릿지·입타·자비스·복붙 정리기)는 카드 전체가 그 링크다(공용 부품 .mb-press-card). 링크가 여러 개인 첫이름은 그대로 둔다. 카드 묶음은 화면에 들어올 때 차례로 나타난다(data-mb-reveal). */}
      <div class="project-grid" data-mb-reveal>{projects.map(project => project.visual ? <article class="project-card featured mb-press-card">
        <img class="project-visual" src={project.visual.src} srcset={project.visual.srcset} sizes="(max-width: 650px) 260px, 220px" width="1024" height="1024" alt={project.visual.alt} decoding="async"/>
        <div class="project-body">
          <div class="project-top"><span class="project-note mb-chip">{project.note}</span></div>
          <h3>{project.name}</h3><p>{project.description}</p><a class="mb-press-target" href={project.href}>{project.action}<span aria-hidden="true">↗</span></a>
        </div>
      </article> : <article class="project-card mb-press-card" data-product-id={project.id}>
        <div class="project-top">{project.icon ? <img class="project-icon" src={project.icon} srcset={srcsetFor(project)} width="40" height="40" alt="" decoding="async"/> : <span class="project-mark" aria-hidden="true">{project.mark}</span>}<span class="project-note mb-chip">{project.note}</span></div>
        <h3>{project.name}</h3><p>{project.description}</p><a class="mb-press-target" href={project.href}>{project.action}<span aria-hidden="true">↗</span></a>
      </article>)}
        <article class="project-card text-tool-card mb-press-card">
          <span class="project-mark" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 6h14M5 12h9M5 18h14"/></svg></span>
          <div class="project-body">
            <span class="project-note mb-chip">설치 없이 · PC/휴대전화</span>
            <h3>복붙 정리기</h3>
            <p>복사한 글의 불필요한 공백과 줄바꿈을 정리해요.</p>
          </div>
          <a class="mb-press-target" href="/tools/text/">글 정리하기<span aria-hidden="true">→</span></a>
        </article>
        <article class="project-card text-tool-card web-service-card" data-product-id="cheotireum">
          <span class="project-mark" aria-hidden="true">첫</span>
          <div class="project-body">
            <span class="project-note mb-chip">웹 서비스 · 작명서 1,000원</span>
            <h3>첫이름</h3>
            <p>사주와 부족한 오행, 한자 뜻풀이와 발음·획수를 함께 살펴 아기 이름 작명서를 만들어요.</p>
            <div class="service-sublinks">
              <a href="https://cheotireum.kangdaejong.com/sample-report">무료 샘플<span aria-hidden="true">↗</span></a>
              <a href="https://cheotireum.kangdaejong.com/hanja-check">한자 확인<span aria-hidden="true">↗</span></a>
              <a href="/cheotireum/">서비스 안내<span aria-hidden="true">→</span></a>
            </div>
          </div>
          <a href="https://cheotireum.kangdaejong.com/">웹에서 시작하기<span aria-hidden="true">↗</span></a>
        </article>
      </div>
      <details id="open-tools" class="bridge-details"><summary>텔레그램 브릿지 설치·시연 <span>Codex · Cursor · Claude · Grok · Grok Bot</span></summary>
        <div class="bridge-links">{tools.map(tool => <div data-product-id={tool.id}>{tool.icon && <img class="bridge-tile" src={tool.icon} srcset={tool.icon2x ? `${tool.icon}, ${tool.icon2x} 2x` : undefined} width="24" height="24" alt="" loading="lazy" decoding="async"/>}<strong>{tool.name.replace(' Telegram Bridge','')}</strong><a href={tool.guide ?? `/product/${tool.name.toLowerCase().replaceAll(" ","-")}/`}>설치 안내 ↗</a><a href={tool.release}>릴리스 ↗</a></div>)}</div>
        <video controls playsinline preload="none" width="768" height="500" poster="https://kangdaejong.com/work/product-demos/bridge-iphone-20260923.jpg" aria-label="텔레그램 브릿지 실제 시연"><source src="https://kangdaejong.com/work/product-demos/bridge-iphone-20260923.mp4" type="video/mp4"/><track kind="captions" src="/bridge-demo.ko.vtt" srclang="ko" label="한국어" default/><a href="https://kangdaejong.com/work/product-demos/bridge-iphone-20260923.mp4">시연 영상 보기</a></video><p class="video-note">2026.09.23 시연 · 대기 일부 생략 · 한국어 자막</p>
      </details>
      {currentProjects.length > 1 && <div class="service-list">{currentProjects.slice(1).map(project => <a class="service-row" href={project.href}><span><strong>{project.name}</strong><span>{project.category}</span></span><span class="service-note">{project.status}<span aria-hidden="true"> ↗</span></span></a>)}</div>}
    </section>
    <section id="products" class="home-section" aria-labelledby="apps-title">
      <span id="everyday" class="anchor-alias"></span>
      <div class="section-title"><h2 id="apps-title">생활에 가까운 앱</h2><span>필요할 때 가볍게 꺼내 쓰세요</span></div>
      <div class="app-grid" data-mb-reveal>{apps.map(app => <article class="app-row" data-product-id={app.id}>{app.icon ? <img src={app.icon} srcset={srcsetFor(app)} alt="" width="48" height="48" loading="lazy" decoding="async"/> : <span class="app-letter" aria-hidden="true">{app.name.slice(0,1)}</span>}<div><h3>{app.name}</h3><p>{app.description}</p><div class="store-links">{app.appId && <a href={`https://apps.apple.com/kr/app/id${app.appId}`} aria-label={`${app.name} App Store`}>App Store ↗</a>}{app.package && <a href={`https://play.google.com/store/apps/details?id=${app.package}`} aria-label={`${app.name} Google Play`}>Google Play ↗</a>}{(app.support || appSupport[app.id]) && <a href={app.support || `/apps/${appSupport[app.id].slug}/`} aria-label={`${app.name} 앱 안내와 지원`}>앱 안내·지원 ↗</a>}{app.storeNote && <span class="app-status">{app.storeNote}</span>}{app.status && <span class="app-status">{app.status}</span>}</div></div></article>)}</div>
    </section>
    <section id="books" class="home-section" aria-labelledby="books-title">
      <div class="section-title"><h2 id="books-title">만들며 배운 것</h2><span class="section-note">전자책 3권 · PDF 무료 공개</span></div>
      <div class="book-list" data-mb-reveal>{books.map((book,index) => <div class="book-item mb-card"><a class="book-row" href={book.file} target="_blank" rel="noopener" type="application/pdf"><span class="book-number">0{index+1}</span><span><strong>{book.name}</strong><span>{book.description}</span></span><span class="book-action">무료로 읽기 ↗ · PDF {book.pages}쪽</span></a><a class="book-download mb-btn mb-btn--secondary" href={book.file} download={book.file.split('/').pop()} type="application/pdf" aria-label={`${book.name} PDF 다운로드`}>PDF 다운로드<span aria-hidden="true"> ⤓</span></a></div>)}</div>
    </section>
    <section id="contact" class="home-section contact-section" aria-labelledby="contact-title">
      <span id="company" class="anchor-alias"></span><span id="choso" class="anchor-alias"></span>
      <div class="contact-heading"><div><h2 id="contact-title">이야기를 나눠요.</h2><p>궁금한 점이나 하고 싶은 이야기가 있다면.</p></div><div class="contact-actions"><a class="contact-email mb-btn mb-btn--primary" href="mailto:minusbetastudio@gmail.com">이메일 보내기 ↗</a><button class="contact-copy mb-btn mb-btn--secondary" type="button" data-mb-copy-email=".contact-email">주소 복사</button></div></div>
      <SocialBanner compact />
      <details class="pause-details"><summary>잠깐 쉬어가기 <span aria-hidden="true">＋</span></summary><MoodCorner /></details>
    </section>
  </main>
  <StudioFooter compact />
  <script>
    import '../scripts/lang-toggle.js';
    function revealAnchor() {
      let id; try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (!target) return;
      let parent: HTMLElement | null = target;
      while (parent) { if (parent instanceof HTMLDetailsElement) parent.open = true; parent = parent.parentElement; }
      requestAnimationFrame(() => target.scrollIntoView({ behavior: 'instant', block: 'start' }));
    }
    revealAnchor(); window.addEventListener('hashchange', revealAnchor);
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
      link.addEventListener('click', () => {
        if (link.hash === location.hash) revealAnchor();
      });
    });
  </script>
</SiteLayout>
