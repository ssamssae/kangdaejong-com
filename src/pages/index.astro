      .focus-list strong { color: var(--fg); font-size: var(--text-h3); line-height: 1.3; }

      .focus-list p { font-size: var(--text-desc); line-height: var(--leading-desc); word-break: keep-all; }

      .product-grid,
      .tool-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--gap-card);
      }

      .ebooks-section .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

      .tool-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

      .product-card,
      .tool-card { display: flex; flex-direction: column; gap: 8px; }

