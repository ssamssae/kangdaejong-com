---
import StudioFooter from "../components/StudioFooter.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout description="마이너스베타스튜디오. 새로운 서비스를 준비 중입니다." canonical="https://kangdaejong.com/" minimal>
  <header class="studio-header"><a href="/" aria-label="마이너스베타스튜디오 홈">MINUS BETA STUDIO<span>마이너스베타스튜디오</span></a></header>
  <main id="main-content">
    <p class="eyebrow">NEXT CHAPTER</p>
    <h1>새로운 서비스를<br />준비 중입니다<span class="dot">.</span></h1>
    <p class="intro">필요한 순간에, 분명한 도움이 되는 서비스.<br />준비가 되면 이곳에서 소개하겠습니다.</p>
    <span class="status"><i aria-hidden="true"></i> 준비 중</span>
  </main>
  <StudioFooter />
  <script is:inline>
    // Preserve shared links to the catalog moved off the home page.
    const openArchivedSection = () => {
      if (window.location.hash === '#books') {
        window.location.replace('/archive/' + window.location.search + '#books');
      }
    };
    openArchivedSection();
    window.addEventListener('hashchange', openArchivedSection);
  </script>
</SiteLayout>
<style>
.studio-header,main,footer{width:min(1120px,calc(100% - 64px));margin:auto}.studio-header{padding:36px 0;border-bottom:1px solid #deded6}.studio-header a{font-size:13px;font-weight:700;letter-spacing:.12em;text-decoration:none;color:#282b25}.studio-header span{display:block;font-size:11px;font-weight:400;letter-spacing:0;margin-top:7px;color:#62655d}main{min-height:72vh;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:80px 0 100px}.eyebrow{font-size:11px;letter-spacing:.22em;color:#777b6f;margin:0 0 26px}h1{font-size:clamp(36px,6vw,76px);line-height:1.22;letter-spacing:-.055em;font-weight:600;margin:0;color:#282b25}.dot{color:#a94830}.intro{font-size:17px;line-height:1.9;color:#666a60;margin:28px 0 34px}.status{font-size:12px;border:1px solid #d6d9cd;border-radius:99px;padding:9px 14px;color:#626b53;display:inline-flex;gap:8px;align-items:center}.status i{width:6px;height:6px;background:#7c8868;border-radius:50%}footer{border-top:1px solid #deded6;padding:24px 0 32px;display:flex;justify-content:space-between;gap:20px;color:#70746b;font-size:11px}footer nav{display:flex;gap:20px}footer a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible{outline:2px solid #a94830;outline-offset:5px}@media(max-width:600px){.studio-header,main,footer{width:calc(100% - 40px)}main{min-height:70vh;padding:70px 0}.intro{font-size:14px}footer{flex-direction:column;gap:16px}footer nav{flex-wrap:wrap}}
</style>
