---
import SiteLayout from "../layouts/SiteLayout.astro";

const company = {
  name: "마이너스베타스튜디오",
  representative: "강대종",
  bizNumber: "878-21-02478",
  mailOrderNumber: "제 2026-서울마포-1177 호",
  address: "서울특별시 마포구 만리재로10길 4 (공덕동)",
  category: "정보통신업 / 응용 소프트웨어 개발 및 공급업",
  email: "minusbetastudio@gmail.com",
  github: "https://github.com/ssamssae",
  work: "https://work.kangdaejong.com/",
  products: "https://work.kangdaejong.com/products/",
  newsletter: "https://minusbetastudio.substack.com",
};

const featured = {
  name: "첫이름",
  price: "웹 서비스 · ₩19,900",
  description: "사주·획수·인명용 한자를 함께 살펴 아이 이름 후보를 만드는 작명 서비스입니다. 웹에서 바로 시작할 수 있습니다.",
  url: "https://cheotireum.kangdaejong.com/",
};

const productGroups = [
  {
    number: "01",
    label: "기록하기",
    products: [
      {
        name: "한줄일기",
        status: "iOS · Android LIVE",
        description: "하루 한 줄로 남기는 일기. 감정 히트맵, 로컬 저장, 가입 없음.",
        links: [
          { label: "App Store", url: "https://apps.apple.com/kr/app/id6764308678" },
          { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.daejongkang.hanjul" },
        ],
      },
      {
        name: "메모요",
        status: "iOS · Android LIVE",
        description: "다크 테마의 심플 메모. 여러 개를 골라 한 번에 지울 수 있습니다.",
        links: [
          { label: "App Store", url: "https://apps.apple.com/kr/app/id6762068073" },
          { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.daejongkang.simple_memo_app" },
        ],
      },
    ],
  },
  {
    number: "02",
    label: "생활 챙기기",
    products: [
      {
        name: "약먹자",
        status: "iOS · Android LIVE",
        description: "약 등록과 알림 시각만 정하면 복약 시간을 챙겨 주는 앱.",
        links: [
          { label: "App Store", url: "https://apps.apple.com/kr/app/id6762100639" },
          { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.daejongkang.yakmukja" },
        ],
      },
      {
        name: "한컵",
        status: "iOS LIVE",
        description: "하루 물 섭취량을 한 컵 단위로 세는 수분 트래커.",
        links: [{ label: "App Store", url: "https://apps.apple.com/kr/app/id6765536616" }],
      },
      {
        name: "포모도로",
        status: "iOS · Android LIVE",
        description: "25분 집중과 5분 휴식 사이클을 재는 집중 타이머.",
        links: [
          { label: "App Store", url: "https://apps.apple.com/kr/app/id6765536777" },
          { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.ssamssae.pomodoro" },
        ],
      },
    ],
  },
  {
    number: "03",
    label: "나누고 익히기",
    products: [
      {
        name: "더치페이 계산기",
        status: "iOS · Android LIVE",
        description: "모임 자리의 금액과 인원만 넣으면 바로 나누는 정산 도구.",
        links: [
          { label: "App Store", url: "https://apps.apple.com/kr/app/id6762072499" },
          { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.daejongkang.dutchpay" },
        ],
      },
      {
        name: "단어요",
        status: "iOS · Android LIVE",
        description: "영어 단어를 카드처럼 넘기며 외우는 미니 단어장.",
        links: [
          { label: "App Store", url: "https://apps.apple.com/kr/app/id6766556759" },
          { label: "Google Play", url: "https://play.google.com/store/apps/details?id=com.daejongkang.wordyo" },
        ],
      },
    ],
  },
];

const books = [
  {
    number: "01",
    name: "1인회사 AI자동화",
    price: "전자책 · ₩10,000",
    description: "1인 비즈니스의 구조화부터 콘텐츠, 자동화, 판매까지 실제 작업 흐름을 정리했습니다.",
    purchase: "https://kmong.com/gig/786557",
    template: "/ebook-automation-workshop/vol1/templates/t01-repeat-work-inventory/",
  },
  {
    number: "02",
    name: "혼자서 AI팀",
    price: "전자책 · ₩15,000",
    description: "혼자 일하면서 여러 AI 역할을 팀처럼 구성하고 운영하는 방법을 정리했습니다.",
    purchase: "https://kmong.com/gig/786749",
    template: "/ai-team-ebook/vol2/templates/t01-task-queue/",
  },
  {
    number: "03",
    name: "폰으로 내 컴퓨터 AI 부리기",
    price: "전자책 · ₩10,000",
    description: "텔레그램에 내 컴퓨터의 AI 도구를 연결하는 과정을 비개발자 눈높이로 정리한 안내서입니다.",
    purchase: "https://kmong.com/gig/798202",
  },
];

const tools = [
  {
    name: "Grok Telegram Bridge",
    description: "텔레그램으로 자기 컴퓨터의 Grok 세션을 사용하는 공개 브릿지.",
    repo: "https://github.com/ssamssae/grok-telegram-bridge",
    release: "https://github.com/ssamssae/grok-telegram-bridge/releases",
  },
  {
    name: "Codex Telegram Bridge",
    description: "Codex CLI 세션에 텍스트와 미디어를 전달하고 진행 상황을 받는 공개 브릿지.",
    repo: "https://github.com/ssamssae/codex-telegram-bridge",
    release: "https://github.com/ssamssae/codex-telegram-bridge/releases",
  },
  {
    name: "Claude Telegram Bridge",
    description: "Claude Code 세션을 텔레그램에 연결하는 공개 브릿지.",
    repo: "https://github.com/ssamssae/claude-telegram-bridge",
    release: "https://github.com/ssamssae/claude-telegram-bridge/releases",
  },
];

const description = `${company.name} — 생활에 가까운 앱, 웹 서비스, 전자책과 공개 도구를 직접 만들고 운영하는 강대종의 1인 스튜디오.`;
---

<SiteLayout description={description} canonical="https://kangdaejong.com/" active="home" bodyClass="home-page">
  <main id="main-content">
    <section class="home-hero" aria-labelledby="page-title">
      <div class="site-shell home-hero-grid">
        <div>
          <p class="eyebrow">Minus Beta Studio · Seoul</p>
          <h1 class="display" id="page-title"><span>작고 분명한</span><span>도구를 만듭니다.</span></h1>
          <p class="lede">메모하고, 챙기고, 집중하고, 이름을 고르는 일. 생활에 가까운 앱과 웹 서비스를 직접 만들고 오래 운영합니다.</p>
          <div class="button-row" aria-label="주요 행동">
            <a class="button primary" href={featured.url}>첫이름 시작하기</a>
            <a class="button" href="#products">생활 앱 둘러보기</a>
          </div>
          <p class="hero-note"><strong>{company.name}</strong><span>강대종의 1인 소프트웨어 스튜디오</span></p>
        </div>
        <figure class="hero-visual">
          <img src="/studio/hero-desk.jpg" alt="창가에서 첫이름 리포트를 읽는 모습" width="1600" height="900" />
          <figcaption><span>Tools worth keeping.</span><span>Made in Mapo, Seoul</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="featured-product" aria-labelledby="featured-title">
      <div class="featured-grid">
        <figure class="featured-media">
          <img src="/studio/cheotireum.jpg" alt="첫이름 작명 서비스 화면" width="1050" height="1400" loading="lazy" />
        </figure>
        <div class="featured-copy">
          <p class="eyebrow">Featured · Web</p>
          <h2 id="featured-title">이름을 고르는 시간을, 차분한 리포트로.</h2>
          <p class="price">{featured.price}</p>
          <p class="description">{featured.description}</p>
          <div class="button-row">
            <a class="button primary" href={featured.url}>첫이름 시작하기</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section site-shell" id="products" aria-labelledby="products-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">Everyday apps</p>
          <h2 class="section-title" id="products-title">오늘 필요한 일부터 찾아보세요.</h2>
        </div>
        <p class="section-intro">기능 수가 아니라 쓰는 순간으로 묶었습니다. 앱 이름을 고르면 각 스토어에서 바로 확인할 수 있습니다.</p>
      </div>
      <div class="product-groups">
        {productGroups.map((group) => (
          <section class="product-group" aria-labelledby={`group-${group.number}`}>
            <header class="group-label">
              <span>{group.number}</span>
              <h3 id={`group-${group.number}`}>{group.label}</h3>
            </header>
            <ol class="product-list">
              {group.products.map((product) => (
                <li class="product-row">
                  <div>
                    <h4>{product.name}</h4>
                    <span class="status">{product.status}</span>
                  </div>
                  <p>{product.description}</p>
                  <div class="store-links" aria-label={`${product.name} 다운로드`}>
                    {product.links.map((link) => <a href={link.url}>{link.label} ↗</a>)}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
      <div class="button-row"><a class="button" href={company.products}>전체 제품 목록 보기</a></div>
    </section>

    <section class="section site-shell" id="books" aria-labelledby="books-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">Books & worksheets</p>
          <h2 class="section-title" id="books-title">운영하면서 배운 것을, 바로 쓰는 문서로.</h2>
        </div>
        <p class="section-intro">전자책은 크몽에서 구매할 수 있고, 책과 함께 쓰는 일부 Markdown 템플릿은 이 사이트에서 공개합니다.</p>
      </div>
      <div class="books-layout">
        <article class="book-lead">
          <span class="book-number">{books[0].number} / FEATURED</span>
          <h3>{books[0].name}</h3>
          <p>{books[0].description}</p>
          <p class="book-meta">{books[0].price}</p>
          <div class="button-row">
            <a class="button primary" href={books[0].purchase}>크몽에서 구매</a>
            <a class="button" href={books[0].template}>공개 템플릿 보기</a>
          </div>
        </article>
        <div class="book-stack">
          {books.slice(1).map((book) => (
            <article class="book-item">
              <h3>{book.name}</h3>
              <p class="book-meta">{book.number} · {book.price}</p>
              <p>{book.description}</p>
              <div class="book-links">
                <a href={book.purchase}>크몽에서 구매 ↗</a>
                {book.template && <a href={book.template}>공개 템플릿 보기 →</a>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section site-shell" id="open-tools" aria-labelledby="tools-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">Open source</p>
          <h2 class="section-title" id="tools-title">직접 쓰는 연결 도구도 공개합니다.</h2>
        </div>
        <p class="section-intro">내 컴퓨터의 AI 세션을 텔레그램에서 쓰기 위해 만든 브릿지입니다. 설치와 변경 내역은 각 저장소에서 확인할 수 있습니다.</p>
      </div>
      <ol class="tool-directory">
        {tools.map((tool, index) => (
          <li class="tool-row">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{tool.name}</h3>
            <p>{tool.description}</p>
            <div class="store-links">
              <a href={tool.repo}>GitHub ↗</a>
              <a href={tool.release}>Release ↗</a>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="record-band" aria-labelledby="record-title">
      <div class="section site-shell">
        <div class="section-head">
          <div>
            <p class="eyebrow">Build in public</p>
            <h2 class="section-title" id="record-title">완성품뿐 아니라 만드는 기록도 남깁니다.</h2>
          </div>
          <p class="section-intro">제품 목록과 작업 과정, 정리한 글을 각 공개 채널에서 이어서 볼 수 있습니다.</p>
        </div>
        <nav class="record-links" aria-label="외부 공개 채널">
          <a class="record-link" href={company.work}><span>01 / WORK</span><strong>작업장</strong><small>제품과 작업일지</small></a>
          <a class="record-link" href={company.newsletter}><span>02 / LETTER</span><strong>뉴스레터</strong><small>빌드와 운영 기록</small></a>
          <a class="record-link" href={company.github}><span>03 / CODE</span><strong>GitHub</strong><small>공개 저장소</small></a>
        </nav>
      </div>
    </section>

    <section class="section site-shell" id="company" aria-labelledby="company-title">
      <div class="company-layout">
        <div class="company-note">
          <p class="eyebrow">Company</p>
          <h2 class="section-title" id="company-title">작게 만들고,<br />오래 책임집니다.</h2>
          <p>{company.name}는 {company.representative}이 운영하는 1인 스튜디오입니다. 제품의 방향과 공개 여부, 비용이 드는 결정은 사람이 직접 확인합니다.</p>
          <div class="button-row">
            <a class="button" href="/organization/">회사와 책임 보기</a>
            <a class="button" href={`mailto:${company.email}`}>이메일 문의</a>
          </div>
        </div>
        <dl class="company-info">
          <div><dt>상호</dt><dd>{company.name}</dd></div>
          <div><dt>대표</dt><dd>{company.representative}</dd></div>
          <div><dt>사업자등록번호</dt><dd>{company.bizNumber}</dd></div>
          <div><dt>통신판매업신고</dt><dd>{company.mailOrderNumber}</dd></div>
          <div><dt>업종</dt><dd>{company.category}</dd></div>
          <div><dt>소재지</dt><dd>{company.address}</dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
          <div><dt>GitHub</dt><dd><a href={company.github}>github.com/ssamssae ↗</a></dd></div>
        </dl>
      </div>
    </section>
  </main>
</SiteLayout>
