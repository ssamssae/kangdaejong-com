<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={company.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="마이너스베타스튜디오 — Tools Worth Keeping." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={company.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Pretendard:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{company.name}</title>
    <script is:inline src="/mb-components.js" defer></script>
  </head>
  <body>
    <mb-header active="home"></mb-header>
    <main>
      <!-- 조직도 페이지와 같은 구성: page-shell 하나가 전 섹션을 감싸고,
           섹션 경계는 풀블리드 괘선이 아니라 shell 폭의 소프트 보더다. -->
      <div class="page-shell">
      <section class="hero" id="top" aria-labelledby="page-title">
        <div class="hero-inner">
          <img class="hero-mark" src="/minusbeta-badge.svg" alt="" width="640" height="640" aria-hidden="true" />
          <div class="hero-copy">
            <p class="eyebrow">MINUS BETA STUDIO</p>
            <h1 id="page-title"><span>마이너스</span><span>베타스튜디오</span></h1>
            <p class="tagline">{slogan}</p>
            <p class="lead">{sloganKo} 모바일 앱, 작은 웹 서비스, 공개 자동화 도구를 직접 만들고 검증하며 운영합니다.</p>
            <div class="hero-actions" aria-label="주요 링크">
              <a class="button primary" href={company.products}>제품 보기</a>
              <a class="button" href={company.work}>작업장 보기</a>
              <a class="button" href={`mailto:${company.email}`}>문의하기</a>
            </div>
          </div>
          <aside class="hero-aside" aria-label="스튜디오 운영 요약">
            <div class="aside-top">
              <span>OPERATING STUDIO</span>
              <strong>1 person</strong>
            </div>
            <ul>
              <li><span>Build</span><strong>앱 · 웹 · 자동화</strong></li>
              <li><span>Record</span><strong>작업일지 · 뉴스레터</strong></li>
              <li><span>Open</span><strong>GitHub · 공개 도구</strong></li>
            </ul>
          </aside>
        </div>
      </section>

      <section class="proof-strip" aria-label="스튜디오 요약">
        <div class="proof-inner">
          {proofPoints.map((item) => (
            <div>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="statement-section" aria-labelledby="statement-title">
        <div class="section-head">
          <p class="eyebrow">IDENTITY</p>
          <h2 id="statement-title">혼자 만들지만 혼자만 보지 않습니다.</h2>
        </div>
        <div class="statement-grid">
          <p>{intro}</p>
          <p>제품은 출시 상태로, 과정은 작업장에, 도구는 공개 저장소에 남깁니다. 작게 시작한 도구가 오래 쓰이도록 기능보다 운영과 회복력을 먼저 봅니다.</p>
        </div>
      </section>

      <section class="focus-section" aria-labelledby="focus-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">WHAT WE BUILD</p>
            <h2 id="focus-title">하는 일</h2>
          </div>
          <p>기획, 개발, 배포, 운영을 한 흐름으로 묶어 빠르게 검증합니다.</p>
        </div>
        <ol class="focus-list">
          {focusAreas.map((item) => (
            <li>
              <span>{item.number}</span>
              <strong>{item.title}</strong>
              <p>{item.desc}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="loop-section" aria-labelledby="loop-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">OPERATING LOOP</p>
            <h2 id="loop-title">만드는 방식</h2>
          </div>
          <p>작게 만들고, 빠르게 공개하고, 기록으로 다시 줄입니다.</p>
        </div>
        <div class="loop-list">
          {operatingLoop.map((item) => (
            <article>
              <span>{item.step}</span>
              <strong>{item.title}</strong>
              <p>{item.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="products-section" aria-labelledby="products-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">PRODUCTS</p>
            <h2 id="products-title">대표 제품</h2>
          </div>
          <a class="text-link" href={company.products}>전체 제품 보기</a>
        </div>
        <div class="product-grid">
          {productCards.map((app) => (
            <article class="product-card">
              <span>{app.status}</span>
              <h3>{app.name}</h3>
              <p>{app.desc}</p>
              <div class="link-row">
                {app.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener">{link.label} →</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="ebooks-section" aria-labelledby="ebooks-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">EBOOKS</p>
            <h2 id="ebooks-title">전자책</h2>
          </div>
          <p>운영하면서 정리한 작업 흐름을 글로 묶었습니다.</p>
        </div>
        <div class="product-grid">
          {ebooks.map((book) => (
            <article class="product-card">
              <span>{book.status}</span>
              <h3>{book.name}</h3>
              <p>{book.desc}</p>
              <div class="link-row">
                {book.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener">{link.label} →</a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="tools-section" aria-labelledby="tools-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">OPEN TOOLS</p>
            <h2 id="tools-title">공개 자동화 도구</h2>
          </div>
          <p>내부에서 실제로 쓰는 도구를 공개 repo로 정리합니다.</p>
        </div>
        <div class="tool-grid">
          {tools.map((tool) => (
            <article class="tool-card">
              <div class="tool-top">
                <h3>{tool.name}</h3>
                <span>{tool.status}</span>
              </div>
              <p>{tool.desc}</p>
              <div class="link-row">
                <a href={tool.repo} target="_blank" rel="noopener">GitHub →</a>
                <a href={tool.releases} target="_blank" rel="noopener">Release →</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="connect-section" aria-labelledby="connect-title">
        <div class="section-head split">
          <div>
            <p class="eyebrow">CONNECT</p>
            <h2 id="connect-title">연결</h2>
          </div>
          <p>제품과 기록은 공개 페이지에서, 연락은 이메일로 받습니다.</p>
        </div>
        <div class="connect-list">
          {links.map((link) => (
            <a href={link.href}>
              <span>{link.label}</span>
              <strong>{link.desc}</strong>
              <em>{link.meta} →</em>
            </a>
          ))}
        </div>
      </section>

      <section class="company-section" aria-labelledby="company-title">
        <div class="section-head">
          <p class="eyebrow">COMPANY</p>
          <h2 id="company-title">회사 정보</h2>
        </div>
        <dl class="company-info">
          <div>
            <dt>상호</dt>
            <dd>{company.name}</dd>
          </div>
          <div>
            <dt>대표</dt>
            <dd>{company.representative}</dd>
          </div>
          <div>
            <dt>사업자등록번호</dt>
            <dd>{company.bizNumber}</dd>
          </div>
          <div>
            <dt>통신판매업신고</dt>
            <dd>{company.mailOrderNumber}</dd>
          </div>
          <div>
            <dt>업종</dt>
            <dd>{company.category}</dd>
          </div>
          <div>
            <dt>조직</dt>
            <dd><a href="/organization/">운영은 AI 에이전트 5, 감독은 인턴 — 조직 구성 보기</a></dd>
          </div>
          <div>
            <dt>소재지</dt>
            <dd>{company.address}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div>
            <dt>GitHub</dt>
            <dd><a href={`https://${company.github}`} target="_blank" rel="noopener">{company.github}</a></dd>
          </div>
        </dl>
      </section>
      </div>
    </main>
    <mb-footer></mb-footer>

    <style is:global>
      /* ── 디자인 시스템 = /organization/ 페이지 기준 (T-260806-062) ──
         타이포 스케일·자간·행간·여백·카드 형태는 src/styles/tokens.css 정본을
         참조한다. 색 팔레트는 종전 그대로(이번 시안의 축은 색이 아니다) —
         verify-tone-pairs.mjs 가 이 파일의 리터럴을 검사하므로 여기 남긴다. */
      :root {
        --bg: #ffffff;
        --bg-elev: #f7f7f7;
        --bg-elev2: #eeeeee;
        --fg: #111111;
        --fg-dim: #4f4f4f;
        --fg-mute: #777777;
        --border: #dedede;
        --border-soft: #eeeeee;
        --accent: #2563eb;
        --accent-dim: #1748b8;
        --cta-fg: #ffffff;
      }

      /* 다크 대응 (2026-08-06 T-260806-060) — /organization/ 이 쓰던 값과 같은 세트.
         색 '이름'은 그대로 두고 값만 뒤집으므로 밝은 모드 렌더는 한 픽셀도 안 바뀐다.
         --cta-fg 는 채운 버튼 전용: 다크 액센트(#7aa2ff) 위에 흰 글자를 얹으면
         명암비가 2.5:1 로 무너져서, 다크에서만 글자를 어둡게 돌린다(7.7:1). */
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0f0f10;
          --bg-elev: #17171a;
          --bg-elev2: #202024;
          --fg: #f2f2f2;
          --fg-dim: #b6b6ba;
          --fg-mute: #8a8a90;
          --border: #2c2c31;
          --border-soft: #232327;
          --accent: #7aa2ff;
          --accent-dim: #9db8ff;
          --cta-fg: #0f0f10;
        }
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      html { background: var(--bg); scroll-behavior: smooth; scrollbar-gutter: stable; }

      body {
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        line-height: var(--leading-body);
        text-rendering: geometricPrecision;
      }

      [id] { scroll-margin-top: 96px; }

      main { width: 100%; margin: 0; padding: 0 0 72px; }

      .page-shell { width: min(calc(100% - 48px), 1120px); margin: 0 auto; }

      a { color: var(--fg); text-decoration: none; }
      a:hover { color: var(--accent); }

      h1, h2, h3 { color: var(--fg); font-weight: 700; letter-spacing: 0; }
      p { color: var(--fg-dim); }

      /* eyebrow — 조직도와 동일: 넓은 자간 + 대문자 */
      .eyebrow {
        font-family: var(--mono);
        font-size: var(--text-meta);
        font-weight: 600;
        letter-spacing: var(--track-eyebrow);
        color: var(--fg-mute);
        text-transform: uppercase;
      }

      /* ── 섹션 리듬 — 굵은 괘선·큰 마진 대신 패딩 + 소프트 경계 (조직도 꼴) ── */
      main section {
        padding: var(--pad-section) 0;
        border-bottom: 1px solid var(--border-soft);
      }

      .company-section { border-bottom: 0; }

      .section-head { margin-bottom: 28px; }
      .section-head h2 { margin-top: 10px; font-size: var(--text-h2); line-height: 1.3; }

      /* 보조 설명은 우측 정렬 분리 대신 제목 아래 리드로 붙인다(조직도 lead.sub 꼴) */
      .section-head.split > p {
        max-width: var(--measure);
        margin-top: 12px;
        font-size: var(--text-body);
        color: var(--fg-mute);
      }

      .section-head .text-link { display: inline-block; margin-top: 12px; }

      /* ── 카드 — 조직도 node 패턴: 12px 라운드 + 얇은 보더 + 6px 스택 ── */
      .hero-aside,
      .proof-inner > div,
      .focus-list li,
      .loop-list article,
      .connect-list a,
      .product-card,
      .tool-card {
        min-width: 0;
        border: 1px solid var(--border);
        border-radius: var(--radius-card);
        background: var(--bg);
        padding: 18px 20px;
      }

      /* 카드 상단 라벨 — 조직도 node-badge 와 동일 규격 */
      .aside-top span,
      .hero-aside li span,
      .proof-inner span,
      .focus-list li > span,
      .loop-list article > span,
      .product-card > span,
      .tool-top span {
        font-family: var(--mono);
        font-size: var(--text-badge);
        font-weight: 600;
        letter-spacing: var(--track-badge);
        color: var(--fg-mute);
        text-transform: uppercase;
      }

      /* ── 히어로 — 조직도 intro-section 리듬 ── */
      .hero { position: relative; overflow: hidden; padding: 72px 0 var(--pad-section); }

      .hero-inner {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
        gap: clamp(28px, 5vw, 56px);
        align-items: center;
      }

      .hero-copy { position: relative; z-index: 1; min-width: 0; }

      .hero-mark {
        position: absolute;
        right: -140px;
        bottom: -160px;
        width: min(48vw, 520px);
        height: auto;
        opacity: 0.05;
        pointer-events: none;
        user-select: none;
      }

      .hero h1 {
        margin: 12px 0 10px;
        font-size: var(--text-h1);
        line-height: var(--leading-h1);
        overflow-wrap: anywhere;
        word-break: keep-all;
      }

      .hero h1 span { display: inline-block; }

      .tagline {
        margin-bottom: 16px;
        font-family: var(--mono);
        font-size: 13px;
        font-weight: 600;
        letter-spacing: var(--track-badge);
        color: var(--fg-dim);
        text-transform: uppercase;
      }

      .lead { max-width: var(--measure); font-size: var(--text-lead); }

      .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

      /* 버튼 — 조직도 .button 규격 (10px 18px · 500 · hover 액센트) */
      .button {
        display: inline-flex;
        align-items: center;
        padding: 10px 18px;
        border: 1px solid var(--border);
        border-radius: var(--radius-btn);
        background: var(--bg);
        color: var(--fg);
        font-size: var(--text-desc);
        font-weight: 500;
      }

      .button:hover { border-color: var(--accent); color: var(--accent); }

      .button.primary {
        border-color: var(--accent);
        background: var(--accent);
        color: var(--cta-fg);
        font-weight: 600;
      }

      .button.primary:hover {
        border-color: var(--accent-dim);
        background: var(--accent-dim);
        color: var(--cta-fg);
      }

      /* 히어로 요약 카드 — 조직도 orchestrator 카드처럼 살짝 띄운 배경 */
      .hero-aside { position: relative; z-index: 1; width: 100%; background: var(--bg-elev); }

      .aside-top {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: baseline;
        border-bottom: 1px solid var(--border);
        padding-bottom: 12px;
      }

      .aside-top strong {
        font-family: var(--mono);
        font-size: var(--text-meta);
        font-weight: 600;
        color: var(--fg);
        white-space: nowrap;
      }

      .hero-aside ul { display: grid; list-style: none; }

      .hero-aside li {
        display: grid;
        grid-template-columns: 76px minmax(0, 1fr);
        gap: 14px;
        align-items: baseline;
        border-bottom: 1px solid var(--border-soft);
        padding: 12px 0;
      }

      .hero-aside li:last-child { border-bottom: 0; padding-bottom: 0; }

      .hero-aside li strong {
        color: var(--fg);
        font-size: var(--text-desc);
        font-weight: 500;
        line-height: var(--leading-desc);
        overflow-wrap: anywhere;
      }

      /* ── 스튜디오 요약 — 셀 괘선 스트립 대신 카드 그리드(조직도 human-grid 꼴) ── */
      .proof-inner {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--gap-card);
      }

      .proof-inner > div { display: flex; flex-direction: column; gap: 6px; }

      .proof-inner strong { color: var(--fg); font-size: 22px; line-height: 1.25; overflow-wrap: anywhere; }

      .proof-inner p { font-size: var(--text-desc); line-height: var(--leading-desc); }

      /* ── IDENTITY — 2단 나눔 대신 리드 문단 스택(조직도 intro 꼴, 62ch) ── */
      .statement-grid { display: grid; gap: 14px; }

      .statement-grid p {
        max-width: var(--measure);
        font-size: var(--text-lead);
        line-height: 1.75;
        word-break: keep-all;
      }

      /* ── 하는 일 / 만드는 방식 — 괘선 셀 대신 카드 그리드 ── */
      .focus-list {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--gap-card);
        list-style: none;
      }

      .focus-list li { display: flex; flex-direction: column; gap: 6px; }

      .focus-list strong { color: var(--fg); font-size: var(--text-h3); line-height: 1.3; }

      .focus-list p { font-size: var(--text-desc); line-height: var(--leading-desc); word-break: keep-all; }

      .loop-list {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--gap-card);
      }

      .loop-list article { display: flex; flex-direction: column; gap: 6px; }

      .loop-list strong { color: var(--fg); font-size: var(--text-h3); line-height: 1.35; word-break: keep-all; }

      .loop-list p { font-size: var(--text-desc); line-height: var(--leading-desc); word-break: keep-all; }

      /* ── 제품·전자책·도구 카드 — 조직도 워커 카드 밀도(4열)·제목 19px ── */
      .product-grid,
      .tool-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--gap-card);
      }

      .ebooks-section .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }

      .tool-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

      .product-card,
      .tool-card { display: flex; flex-direction: column; gap: 6px; }

      .product-card:hover,
      .tool-card:hover { border-color: var(--accent); }

      .product-card h3,
      .tool-card h3 {
        font-size: var(--text-h3);
        line-height: 1.32;
        overflow-wrap: anywhere;
        word-break: keep-all;
      }

      .product-card p,
      .tool-card p { font-size: var(--text-desc); line-height: var(--leading-desc); word-break: keep-all; }

      .link-row { display: flex; flex-wrap: wrap; gap: 10px 14px; margin-top: auto; padding-top: 12px; }

      .link-row a,
      .text-link {
        color: var(--fg);
        font-family: var(--mono);
        font-size: var(--text-meta);
        font-weight: 600;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      .link-row a:hover,
      .text-link:hover { color: var(--accent); }

      .tool-top { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }

      /* ── 연결 — 행 리스트 대신 링크 카드(조직도 node 꼴: 이름/설명/메타) ── */
      .connect-list {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--gap-card);
      }

      .connect-list a { display: flex; flex-direction: column; gap: 6px; }

      .connect-list a:hover { border-color: var(--accent); color: var(--fg); }

      .connect-list a > span { color: var(--fg); font-size: var(--text-lead); font-weight: 700; line-height: 1.3; }

      .connect-list strong {
        color: var(--fg-dim);
        font-size: var(--text-desc);
        font-weight: 400;
        line-height: var(--leading-desc);
        overflow-wrap: anywhere;
      }

      .connect-list em {
        margin-top: auto;
        padding-top: 10px;
        font-family: var(--mono);
        font-size: var(--text-meta);
        font-style: normal;
        font-weight: 600;
        color: var(--fg-mute);
        overflow-wrap: anywhere;
      }

      .connect-list a:hover em { color: var(--accent); }

      /* ── 회사 정보 — dt 를 조직도 라벨 규격(mono 12 · 자간)으로 ── */
      .company-info {
        display: grid;
        grid-template-columns: 1fr;
        border-top: 1px solid var(--border);
      }

      .company-info div {
        display: grid;
        grid-template-columns: 112px minmax(0, 1fr);
        gap: 14px;
        align-items: baseline;
        border-bottom: 1px solid var(--border-soft);
        padding: 12px 0;
      }

      .company-info dt {
        font-family: var(--mono);
        font-size: var(--text-meta);
        font-weight: 600;
        letter-spacing: var(--track-badge);
        color: var(--fg-mute);
      }

      .company-info dd {
        color: var(--fg);
        font-size: var(--text-body);
        font-weight: 500;
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .company-info a {
        color: var(--fg);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      /* ── 반응형 — 조직도와 같은 900 / 640 브레이크 ── */
      @media (max-width: 900px) {
        .hero-inner { grid-template-columns: 1fr; align-items: start; }

        .proof-inner,
        .loop-list,
        .product-grid,
        .ebooks-section .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

        .focus-list,
        .tool-grid,
        .connect-list { grid-template-columns: 1fr; }
      }

      @media (max-width: 640px) {
        .page-shell { width: calc(100% - 32px); }

        main { padding-bottom: 56px; }

        main section { padding: var(--pad-section-sm) 0; }

        .hero { padding: 48px 0 var(--pad-section-sm); }

        .hero-mark { right: -160px; bottom: -120px; width: 420px; opacity: 0.045; }

        .proof-inner,
        .loop-list,
        .product-grid,
        .ebooks-section .product-grid { grid-template-columns: 1fr; }

        .company-info div { grid-template-columns: 1fr; gap: 3px; }
      }
    </style>
  </body>
</html>
