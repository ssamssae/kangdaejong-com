---
import '../styles/home-simple.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import StudioFooter from '../components/StudioFooter.astro';
import SocialBanner from '../components/SocialBanner.astro';
import InsightBanner from '../components/InsightBanner.astro';
import MoodCorner from '../components/MoodCorner.astro';
import productIcons from '../data/product-icon-sources.json';
import { currentProjects } from '../data/project-versions';
import { apps, books, tools } from '../data/home';
const iconFor = (name: string) => productIcons.icons.find(item => item.name === name)?.icon;
const projects = [
  { name: '텔레그램 브릿지', mark: '↔', description: '휴대폰에서 내 컴퓨터의 AI에게 요청하고 답을 받습니다.', note: '공개 소스', href: '#open-tools', action: '설치 안내', icon: null },
  { name: '입타', mark: '입', description: '쓰던 입력칸에서 말하면 글이 됩니다. Mac과 Windows에서.', note: '음성 입력', href: '/ipta/', action: '입타 알아보기', icon: '/product-icons/ipta-779f2694b7.png' },
  { name: '자비스', mark: '⌁', description: '목소리로 부르고, AI의 답을 스피커로 듣는 개인 비서입니다.', note: '실험 중 · 공개 소스', href: 'https://github.com/ssamssae/jarvis-mac', action: '소스 보기', icon: null },
];
---
<SiteLayout title="강대종 — 직접 만드는 작은 도구들" description="강대종의 프로젝트를 한곳에. 텔레그램 브릿지, 입타, 자비스와 생활 앱, 만들며 배운 기록을 만나보세요." canonical="https://kangdaejong.com/" minimal bodyClass="simple-home">
  <mb-header active="home" tone="studio"></mb-header>
  <main id="main-content" class="home-width" tabindex="-1">
    <InsightBanner />
    <section class="intro" aria-labelledby="intro-title">
      <p class="intro-label">만들고, 써 보고, 다듬습니다.</p>
      <h1 id="intro-title">안녕하세요.<br/>만드는 사람 <span>강대종</span>입니다.</h1>
      <p class="intro-description">일할 때 필요한 도구부터 일상의 작은 앱까지.<br class="desktop-break"/> 직접 만들어 쓰는 것들을 이곳에 모았습니다.</p>
      <div class="intro-links"><a href="#projects">프로젝트 둘러보기 <span aria-hidden="true">↓</span></a><a href="https://github.com/ssamssae" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
    </section>
    <section id="projects" class="home-section" aria-labelledby="projects-title">
      <div class="section-title"><h2 id="projects-title">만드는 도구</h2><span>일하는 방식을 조금 더 편하게</span></div>
      <div class="project-grid">{projects.map(project => <article class="project-card">
        <div class="project-top">{project.icon ? <img class="project-icon" src={project.icon} width="40" height="40" alt=""/> : <span class="project-mark" aria-hidden="true">{project.mark}</span>}<span class="project-note">{project.note}</span></div>
        <h3>{project.name}</h3><p>{project.description}</p><a href={project.href}>{project.action}<span aria-hidden="true">↗</span></a>
      </article>)}</div>
      <details id="open-tools" class="bridge-details"><summary>텔레그램 브릿지 설치·시연 <span>Codex · Cursor · Claude · Grok</span></summary>
        <div class="bridge-links">{tools.map(tool => <div><strong>{tool.name.replace(' Telegram Bridge','')}</strong><a href={tool.repo}>설치 안내 ↗</a><a href={tool.release}>릴리스 ↗</a></div>)}</div>
        <video controls playsinline preload="none" width="768" height="500" poster="https://work.kangdaejong.com/product-demos/bridge-iphone-20260923.jpg" aria-label="텔레그램 브릿지 실제 시연"><source src="https://work.kangdaejong.com/product-demos/bridge-iphone-20260923.mp4" type="video/mp4"/><track kind="captions" src="/bridge-demo.ko.vtt" srclang="ko" label="한국어" default/><a href="https://work.kangdaejong.com/product-demos/bridge-iphone-20260923.mp4">시연 영상 보기</a></video><p class="video-note">2026.09.23 시연 · 대기 일부 생략 · 한국어 자막</p>
      </details>
      {currentProjects.length > 1 && <div class="service-list">{currentProjects.slice(1).map(project => <a class="service-row" href={project.href}><span><strong>{project.name}</strong><span>{project.category}</span></span><span class="service-note">{project.status}<span aria-hidden="true"> ↗</span></span></a>)}</div>}
    </section>
    <section id="products" class="home-section" aria-labelledby="apps-title">
      <span id="everyday" class="anchor-alias"></span>
      <div class="section-title"><h2 id="apps-title">생활에 가까운 앱</h2><span>필요할 때 가볍게 꺼내 쓰세요</span></div>
      <div class="app-grid">{apps.map(app => <article class="app-row">{iconFor(app.name) ? <img src={iconFor(app.name)} alt="" width="48" height="48" loading="lazy"/> : <span class="app-letter" aria-hidden="true">{app.name.slice(0,1)}</span>}<div><h3>{app.name}</h3><p>{app.description}</p><div class="store-links"><a href={`https://apps.apple.com/kr/app/id${app.appId}`} aria-label={`${app.name} App Store`}>App Store ↗</a><a href={`https://play.google.com/store/apps/details?id=${app.package}`} aria-label={`${app.name} Google Play`}>Google Play ↗</a></div></div></article>)}</div>
    </section>
    <section id="books" class="home-section" aria-labelledby="books-title">
      <div class="section-title"><h2 id="books-title">만들며 배운 것</h2><a href="https://work.kangdaejong.com/products/#retired-products">종료한 제품 보기 ↗</a></div>
      <div class="book-list">{books.map((book,index) => <div class="book-row"><span class="book-number">0{index+1}</span><span><strong>{book.name}</strong><span>{book.description}</span></span><span class="book-action">판매 종료</span></div>)}</div>
    </section>
    <section id="contact" class="home-section contact-section" aria-labelledby="contact-title">
      <span id="company" class="anchor-alias"></span><span id="choso" class="anchor-alias"></span>
      <div class="contact-heading"><div><h2 id="contact-title">이야기를 나눠요.</h2><p>궁금한 점이나 하고 싶은 이야기가 있다면.</p></div><a class="contact-email" href="mailto:minusbetastudio@gmail.com">이메일 보내기 ↗</a></div>
      <SocialBanner compact />
      <details class="pause-details"><summary>잠깐 쉬어가기 <span aria-hidden="true">＋</span></summary><MoodCorner /></details>
    </section>
  </main>
  <StudioFooter compact />
  <script>
    function revealAnchor() {
      let id; try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (!target) return;
      let parent: HTMLElement | null = target;
      while (parent) { if (parent instanceof HTMLDetailsElement) parent.open = true; parent = parent.parentElement; }
      requestAnimationFrame(() => target.scrollIntoView({ behavior: 'instant', block: 'start' }));
    }
    revealAnchor(); window.addEventListener('hashchange', revealAnchor);
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
      link.addEventListener('click', () => {
        if (link.hash === location.hash) revealAnchor();
      });
    });
  </script>
</SiteLayout>
