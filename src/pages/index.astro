        line-height: 1.32;
        overflow-wrap: anywhere;
        word-break: keep-all;
      }

      .product-card p,
      .tool-card p { font-size: var(--text-desc); line-height: var(--leading-desc); word-break: keep-all; }

      .link-row { display: flex; flex-wrap: wrap; gap: 10px 14px; margin-top: auto; padding-top: 14px; }

      .link-row a,
      .text-link {
        color: var(--fg);
        font-family: var(--mono);
