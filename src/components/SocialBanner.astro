---
const { compact = false } = Astro.props;
const channels = [
  { name: 'GitHub', detail: '공개 코드와 도구', mark: '{ }', href: 'https://github.com/ssamssae', color: '#242720', tint: '#eeeee8' },
  { name: 'Instagram', detail: '사진과 짧은 영상', mark: '◎', href: 'https://www.instagram.com/minusbetastudio/', color: '#a12c62', tint: '#faeaf1' },
  { name: 'Threads', detail: '가볍게 나누는 생각', mark: '@', href: 'https://www.threads.com/@minusbetastudio', color: '#343434', tint: '#eeeeec' },
  { name: 'X', detail: '짧고 빠른 소식', mark: '𝕏', href: 'https://x.com/minusbetastudio', color: '#252525', tint: '#eeeef0' },
  { name: 'YouTube', detail: '영상으로 보는 이야기', mark: '▶', href: 'https://www.youtube.com/channel/UCp92-I0U8c-R2KT8u7gbIXQ', color: '#b32620', tint: '#fceceb' },
  { name: 'LinkedIn', detail: '일과 만드는 경험', mark: 'in', href: 'https://www.linkedin.com/in/minusbetastudio', color: '#175a98', tint: '#e9f1fa' },
  { name: 'Facebook', detail: '일상과 새로운 소식', mark: 'f', href: 'https://www.facebook.com/share/1EKA4ufA3o/', color: '#2259a4', tint: '#eaf0fb' },
  { name: '네이버 블로그', detail: '차곡차곡 쌓는 기록', mark: 'N', href: 'https://blog.naver.com/ssamssae', color: '#1d713b', tint: '#e7f3e9' },
  { name: 'Substack', detail: '만들며 배운 뉴스레터', mark: '≡', href: 'https://minusbetastudio.substack.com', color: '#a84519', tint: '#fcEEE5' },
  { name: '작업실', detail: '작업일지와 만드는 과정', mark: '↗', href: 'https://kangdaejong.com/work/', color: '#655139', tint: '#f2ece2' },
  { name: '전체 제품', detail: '앱 · 서비스 · 전자책', mark: '−β', href: 'https://kangdaejong.com/work/products/', color: '#a13c27', tint: '#f6eae2' },
];
---
<section class:list={["social-banner", {compact}]} aria-labelledby="social-banner-title">
  <div class="social-heading">
    <div><p class="r-kicker">CONNECT / 강대종 · 마이너스베타스튜디오</p><h2 id="social-banner-title">만드는 일, 나누는 이야기.</h2></div>
    <p>코드부터 일상까지, 모든 채널을 한곳에.</p>
  </div>
  <nav class="social-grid" aria-label="SNS와 공개 채널">
    {channels.map(channel => (
      <a class="social-card" href={channel.href} target="_blank" rel="noopener noreferrer" style={`--channel-color:${channel.color};--channel-tint:${channel.tint}`} aria-label={`${channel.name} — ${channel.detail} (새 탭)`}>
        <span class="social-mark" aria-hidden="true">{channel.mark}</span>
        <span class="social-copy"><strong>{channel.name}</strong><span>{channel.detail}</span></span>
        <span class="social-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>
</section>
<style>
  /* 색은 공용 tokens.css(채널 고유색은 각 서비스의 상징색). T-261024-050: 모양·글자·간격은 공용 톤 값만 — 홈의 compact 꼴은 첫이름 trust-footer 링크 줄(15/22 굵게 44px)과 같다. */
  .social-banner { padding: var(--tone-section-gap) 0 0; }
  .social-heading { display: flex; justify-content: space-between; align-items: end; gap: var(--tone-space-3); margin-bottom: var(--tone-space-4); }
  .social-heading .r-kicker { margin: 0 0 var(--tone-space-1); }
  .social-heading h2 { margin: 0; }
  .social-heading > p { margin: 0; font-size: var(--tone-body-size); line-height: var(--tone-body-line); color: var(--fg-dim); }
  .social-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--tone-space-3); }
  .social-card { display: flex; align-items: center; gap: var(--tone-space-2); min-height: var(--tone-control-height); padding: var(--tone-space-2) var(--tone-control-padding); border: 0; border-radius: var(--tone-radius-card); background: var(--bg-elev); color: var(--fg); text-decoration: none; transition: background-color var(--tone-press-ms) linear; }
  .social-card:hover { background: var(--channel-tint); }
  .social-card:focus-visible { outline: var(--tone-focus-width) solid var(--channel-color); outline-offset: var(--tone-focus-offset); }
  .social-mark { display: grid; place-items: center; flex: 0 0 40px; height: 40px; border-radius: var(--tone-radius-control); background: var(--channel-tint); color: var(--channel-color); font: var(--tone-weight-bold) var(--tone-subtitle-size)/1 system-ui, sans-serif; }
  .social-copy { min-width: 0; }
  .social-copy strong { display: block; font-size: var(--tone-label-size); line-height: var(--tone-label-line); }
  .social-copy > span { display: block; margin-top: 2px; font-size: var(--tone-caption-size); line-height: var(--tone-caption-line); color: var(--fg-dim); word-break: keep-all; } /* tone:fixed: 두 줄 글자 미세 간격 2px(의장) */
  .social-arrow { margin-left: auto; color: var(--fg-dim); font-size: var(--tone-label-size); }
  @media (max-width: 1000px) { .social-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .social-heading { display: block; }
    .social-heading > p { margin-top: var(--tone-space-2); }
    .social-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--tone-space-1); }
    .social-card { padding: var(--tone-space-2); gap: var(--tone-space-1); }
    .social-arrow { display: none; }
  }
  .compact { border: 0; padding: 0; }
  .compact .social-heading { display: none; }
  .compact .social-grid { display: flex; flex-wrap: wrap; gap: var(--tone-space-1) var(--tone-space-3); }
  .compact .social-card { border: 0; border-radius: 0; background: none; min-height: var(--tone-tap-height); padding: 0; gap: 4px; color: var(--fg); font: var(--tone-weight-bold) var(--tone-label-size)/var(--tone-label-line) var(--tone-font); } /* tone:fixed: 아이콘·글자 미세 간격 4px(의장) */
  .compact .social-card:hover { color: var(--accent-hover); background: none; }
  .compact .social-mark, .compact .social-copy > span { display: none; }
  .compact .social-copy strong { font-size: var(--tone-label-size); line-height: var(--tone-label-line); font-weight: var(--tone-weight-bold); }
  .compact .social-arrow { display: block; font-size: var(--tone-caption-size); margin: 0; color: inherit; }
</style>
