---
const channels = [
  { name: 'GitHub', detail: '공개 코드와 도구', mark: '{ }', href: 'https://github.com/ssamssae', color: '#242720', tint: '#eeeee8' },
  { name: 'Instagram', detail: '사진과 짧은 영상', mark: '◎', href: 'https://www.instagram.com/minusbetastudio/', color: '#a12c62', tint: '#faeaf1' },
  { name: 'Threads', detail: '가볍게 나누는 생각', mark: '@', href: 'https://www.threads.com/@minusbetastudio', color: '#343434', tint: '#eeeeec' },
  { name: 'X', detail: '짧고 빠른 소식', mark: '𝕏', href: 'https://x.com/minusbetastudio', color: '#252525', tint: '#eeeef0' },
  { name: 'YouTube', detail: '영상으로 보는 이야기', mark: '▶', href: 'https://www.youtube.com/channel/UCp92-I0U8c-R2KT8u7gbIXQ', color: '#b32620', tint: '#fceceb' },
  { name: 'LinkedIn', detail: '일과 만드는 경험', mark: 'in', href: 'https://www.linkedin.com/in/minusbetastudio', color: '#175a98', tint: '#e9f1fa' },
  { name: 'Facebook', detail: '일상과 새로운 소식', mark: 'f', href: 'https://www.facebook.com/share/1EKA4ufA3o/', color: '#2259a4', tint: '#eaf0fb' },
  { name: '네이버 블로그', detail: '차곡차곡 쌓는 기록', mark: 'N', href: 'https://blog.naver.com/ssamssae', color: '#1d713b', tint: '#e7f3e9' },
  { name: 'Substack', detail: '만들며 배운 뉴스레터', mark: '≡', href: 'https://minusbetastudio.substack.com', color: '#a84519', tint: '#fcEEE5' },
  { name: '작업실', detail: '작업일지와 만드는 과정', mark: '↗', href: 'https://work.kangdaejong.com/', color: '#655139', tint: '#f2ece2' },
  { name: '전체 제품', detail: '앱 · 서비스 · 전자책', mark: '−β', href: 'https://work.kangdaejong.com/products/', color: '#a13c27', tint: '#f6eae2' },
  { name: '초소', detail: '지금 작업장의 공개 현황', mark: '◉', href: 'https://choso.kangdaejong.com/guest', color: '#326254', tint: '#e5efe8' },
];
---
<section class="social-banner" aria-labelledby="social-banner-title">
  <div class="social-heading">
    <div><p class="r-kicker">CONNECT / 강대종 · 마이너스베타스튜디오</p><h2 id="social-banner-title">만드는 일, 나누는 이야기.</h2></div>
    <p>코드부터 일상까지, 모든 채널을 한곳에.</p>
  </div>
  <nav class="social-grid" aria-label="SNS와 공개 채널">
    {channels.map(channel => (
      <a class="social-card" href={channel.href} target="_blank" rel="noopener noreferrer" style={`--channel-color:${channel.color};--channel-tint:${channel.tint}`} aria-label={`${channel.name} — ${channel.detail} (새 탭)`}>
        <span class="social-mark" aria-hidden="true">{channel.mark}</span>
        <span class="social-copy"><strong>{channel.name}</strong><span>{channel.detail}</span></span>
        <span class="social-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>
</section>
<style>
  .social-banner { padding: 34px 0 28px; border-bottom: 1px solid #d7d8cd; }
  .social-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 20px; }
  .social-heading .r-kicker { margin: 0 0 10px; font-size: 10px; }
  .social-heading h2 { margin: 0; font-size: clamp(24px, 3vw, 32px); letter-spacing: -.045em; line-height: 1.3; }
  .social-heading > p { margin: 0 0 3px; font-size: 12px; color: #62655d; }
  .social-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .social-card { display: flex; align-items: center; gap: 12px; min-height: 78px; padding: 14px; border: 1px solid #e0e0d6; border-radius: 12px; background: #fffdf9; color: #242720; text-decoration: none; transition: border-color .15s, background .15s; }
  .social-card:hover { border-color: var(--channel-color); background: var(--channel-tint); }
  .social-card:focus-visible { outline: 3px solid var(--channel-color); outline-offset: 3px; }
  .social-mark { display: grid; place-items: center; flex: 0 0 38px; height: 38px; border-radius: 10px; background: var(--channel-tint); color: var(--channel-color); font: 700 23px/1 system-ui, sans-serif; }
  .social-copy { min-width: 0; }
  .social-copy strong { display: block; font-size: 14px; line-height: 1.4; }
  .social-copy > span { display: block; margin-top: 4px; font-size: 11px; line-height: 1.5; color: #62655d; word-break: keep-all; }
  .social-arrow { margin-left: auto; color: #62655d; font-size: 14px; }
  @media (max-width: 1000px) { .social-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .social-banner { padding-top: 24px; }
    .social-heading { display: block; }
    .social-heading > p { margin-top: 10px; }
    .social-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .social-card { min-height: 72px; padding: 10px; gap: 8px; }
    .social-mark { flex-basis: 30px; height: 32px; font-size: 20px; border-radius: 8px; }
    .social-copy strong { font-size: 12px; }
    .social-copy > span { font-size: 10px; }
    .social-arrow { display: none; }
  }
</style>
