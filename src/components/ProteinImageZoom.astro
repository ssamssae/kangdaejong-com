<dialog id="protein-image-dialog" aria-labelledby="protein-image-title">
  <header><strong id="protein-image-title">분자 구조 그림</strong><button class="mb-btn mb-btn--secondary" type="button" autofocus aria-label="그림 확대 닫기">닫기 ×</button></header>
  <p role="status">그림을 불러오는 중…</p>
  <img alt="" hidden />
  <a class="mb-link" target="_blank" rel="noopener noreferrer">원본 그림 새 탭으로 보기 ↗</a>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#protein-image-dialog')!;
  const image = dialog.querySelector('img')!;
  const title = dialog.querySelector('strong')!;
  const status = dialog.querySelector('p')!;
  const original = dialog.querySelector('a')!;
  let opener: HTMLAnchorElement | null = null;
  let overflow = '';
  let active = false;
  function cleanup() {
    if (!active) return;
    active = false;
    document.documentElement.style.overflow = overflow;
    opener?.focus({ preventScroll: true });
  }
  function close() { dialog.close(); cleanup(); }
  image.addEventListener('load', () => { image.hidden = false; status.hidden = true; });
  image.addEventListener('error', () => { status.textContent = '그림을 불러오지 못했습니다. 아래 원본 링크를 이용해주세요.'; });
  document.querySelectorAll<HTMLAnchorElement>('[data-protein-zoom]').forEach(link => {
    link.addEventListener('click', event => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || typeof dialog.showModal !== 'function') return;
      event.preventDefault();
      opener = link;
      image.hidden = true;
      status.hidden = false;
      status.textContent = '그림을 불러오는 중…';
      image.removeAttribute('src');
      image.alt = link.querySelector('img')?.alt || `${document.querySelector('#molecule-title')?.textContent} 분자 구조`;
      title.textContent = image.alt;
      // 그림은 라이트 한 벌뿐이다(T-261024-058 — 다크 바탕 그림 전환을 걷어냈다).
      const src = link.href;
      original.href = src;
      image.src = src;
      overflow = document.documentElement.style.overflow;
      active = true;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });
  });
  dialog.querySelector('button')!.addEventListener('click', close);
  dialog.addEventListener('cancel', event => { event.preventDefault(); close(); });
  dialog.addEventListener('close', () => { if (!dialog.open) cleanup(); });
  dialog.addEventListener('click', event => {
    const r = dialog.getBoundingClientRect();
    if (event.target === dialog && (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom)) close();
  });
</script>
<style>
  /* T-261024-058: 모양·글자·간격은 공용 톤 파일 이름만 쓴다(닫기 = .mb-btn, 원본 링크 = .mb-link). 숫자를 다시 적으면 verify-tone-copies 가 막는다. */
  dialog{box-sizing:border-box;width:min(850px,calc(100vw - var(--tone-space-4)));max-height:calc(100dvh - var(--tone-space-4));margin:auto;padding:var(--tone-space-3);border:1px solid var(--border);border-radius:var(--tone-radius-sheet);background:var(--bg);color:var(--fg);overflow:auto;overscroll-behavior:contain}
  dialog::backdrop{background:#101810d9}header{display:flex;justify-content:space-between;align-items:center;gap:var(--tone-space-2);margin-bottom:var(--tone-space-2)}strong{font-size:var(--tone-label-size);line-height:var(--tone-label-line)}header .mb-btn{flex-shrink:0}
  img{display:block;width:100%;max-height:calc(100dvh - 170px);object-fit:contain;background:var(--bg);border-radius:var(--tone-radius-control)}img[hidden],p[hidden]{display:none}p{padding:var(--tone-space-5) 0;text-align:center;font-size:var(--tone-label-size);line-height:var(--tone-label-line)}a{display:block;width:fit-content;margin:var(--tone-space-1) auto 0}:where(a,button):focus-visible{outline:var(--tone-focus-width) solid var(--accent);outline-offset:var(--tone-focus-offset)}
</style>
