---
import fs from "node:fs";
import path from "node:path";
import "../styles/tokens.css";

const { meta, sourceSegments, rawBase, eyebrow, sourceNote, description } = Astro.props;

const escapeHtml = (value) => value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
const inline = (value) => {
  let output = escapeHtml(value);
  output = output.replace(/`([^`]+)`/g, "<code>$1</code>");
  output = output.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
  output = output.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  return output;
};
const isTableDivider = (line) => /^\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?$/.test(line);
const cells = (line) => line.trim().replace(/^\|/, "").replace(/\|$/, "").split("|").map((cell) => cell.trim());

function markdownToHtml(source) {
  const lines = source.replaceAll("\r\n", "\n").split("\n");
  const html = [];
  let index = 0;
  while (index < lines.length) {
    const line = lines[index];
    if (!line.trim()) { index += 1; continue; }
    if (line.startsWith("```")) {
      const language = line.slice(3).trim();
      const body = [];
      index += 1;
      while (index < lines.length && !lines[index].startsWith("```")) body.push(lines[index++]);
      if (index < lines.length) index += 1;
      html.push(`<pre><code${language ? ` data-language="${escapeHtml(language)}"` : ""}>${escapeHtml(body.join("\n"))}</code></pre>`);
      continue;
    }
    if (/^#{1,3}\s/.test(line)) {
      const match = line.match(/^(#{1,3})\s+(.*)$/);
      const level = match[1].length;
      html.push(`<h${level}>${inline(match[2])}</h${level}>`); index += 1; continue;
    }
    if (line.trimStart().startsWith("|") && index + 1 < lines.length && isTableDivider(lines[index + 1])) {
      const head = cells(line); index += 2; const rows = [];
      while (index < lines.length && lines[index].trimStart().startsWith("|")) rows.push(cells(lines[index++]));
      html.push(`<div class="table-wrap"><table><thead><tr>${head.map((cell) => `<th>${inline(cell)}</th>`).join("")}</tr></thead><tbody>${rows.map((row) => `<tr>${head.map((_, i) => `<td>${inline(row[i] ?? "")}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`);
      continue;
    }
    if (/^\s*[-*]\s+/.test(line) || /^\s*\d+\.\s+/.test(line)) {
      const ordered = /^\s*\d+\.\s+/.test(line); const items = [];
      while (index < lines.length && (ordered ? /^\s*\d+\.\s+/.test(lines[index]) : /^\s*[-*]\s+/.test(lines[index]))) items.push(lines[index++].replace(/^\s*(?:[-*]|\d+\.)\s+/, ""));
      html.push(`<${ordered ? "ol" : "ul"}>${items.map((item) => `<li>${inline(item)}</li>`).join("")}</${ordered ? "ol" : "ul"}>`);
      continue;
    }
    const paragraph = [line]; index += 1;
    while (index < lines.length && lines[index].trim() && !/^#{1,3}\s/.test(lines[index]) && !lines[index].startsWith("```") && !lines[index].trimStart().startsWith("|") && !/^\s*[-*]\s+/.test(lines[index]) && !/^\s*\d+\.\s+/.test(lines[index])) paragraph.push(lines[index++]);
    html.push(`<p>${inline(paragraph.join("\n")).replaceAll("\n", "<br />")}</p>`);
  }
  return html.join("\n");
}

const sourcePath = path.join(process.cwd(), "public", ...sourceSegments, meta.file);
const source = fs.readFileSync(sourcePath, "utf8");
// 페이지 헤더가 meta.title 로 <h1> 을 이미 그리므로, 본문 md 선두의 동일 제목 H1 은
// 렌더에서만 건너뛴다 (원본 .md 다운로드/복사용 콘텐츠는 무변경).
const sourceLines = source.replaceAll("\r\n", "\n").split("\n");
const firstContentIndex = sourceLines.findIndex((line) => line.trim() !== "");
const firstContentLine = firstContentIndex >= 0 ? sourceLines[firstContentIndex].trim() : "";
const body =
  /^#\s+/.test(firstContentLine) && firstContentLine.replace(/^#\s+/, "").trim() === meta.title.trim()
    ? sourceLines.slice(firstContentIndex + 1).join("\n")
    : source;
const rendered = markdownToHtml(body);
const rawUrl = `/${rawBase}/${meta.file}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`${meta.title} — ${description}`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <title>{meta.title} · 마이너스베타스튜디오</title>
    <script is:inline src="/mb-components.js" defer></script>
  </head>
  <body>
    <mb-header></mb-header>
    <main class="page-shell">
      <header class="template-head">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{meta.title}</h1>
        <p class="source-note">{sourceNote}</p>
      </header>
      <article class="markdown-body" set:html={rendered}></article>
      <footer class="template-foot">
        <p>원본 Markdown 파일</p>
        <a href={rawUrl}>{meta.file} 열기 →</a>
      </footer>
    </main>
  </body>
</html>

<style>
  /* ── 디자인 시스템 = src/styles/tokens.css (T-260807-014 확산, parent=T-260806-062) ──
     타이포 스케일·자간·행간·여백·형태는 위 frontmatter 의 tokens.css import 가 정본이다.
     종전에는 같은 값을 이 블록에 리터럴로 갖고 있었다 — 랜딩(T-260806-062)이 토큰으로
     옮겨간 뒤로는 두 벌이 따로 흘러 톤이 갈리는 자리였다.
     ⚠️ 색은 여기 남긴다 — tokens.css 는 설계상 색을 담지 않고(파일 주석 9-11행),
        이 세트는 랜딩·조직도와 이미 같은 값이다(T-260806-060). --code-bg 만 이 페이지 전용.
     ⚠️ 폭(900px)은 토큰으로 접지 않는다 — 랜딩 1120px 은 카드 그리드용이고 이 페이지는
        긴 마크다운 독서면이다. 배차문 「획일화가 아니라 톤 통일」에 따라 고유 구조는 남긴다. */
  :global(:root) { --bg: #fff; --bg-elev: #f7f7f7; --fg: #111; --fg-dim: #4f4f4f; --fg-mute: #777; --border: #dedede; --border-soft: #eeeeee; --accent: #2563eb; --code-bg: #fafafa; }
  /* 다크 대응 (2026-08-06 T-260806-060) — 랜딩·조직도와 같은 값 세트. */
  @media (prefers-color-scheme: dark) {
    :global(:root) { --bg: #0f0f10; --bg-elev: #17171a; --fg: #f2f2f2; --fg-dim: #b6b6ba; --fg-mute: #8a8a90; --border: #2c2c31; --border-soft: #232327; --accent: #7aa2ff; --code-bg: #17171a; }
  }
  :global(*) { box-sizing: border-box; }
  :global(html) { background: var(--bg); }
  :global(body) { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--sans); line-height: var(--leading-body); }
  :global(a) { color: var(--fg); text-decoration: underline; text-underline-offset: .2em; }
  :global(a:hover) { color: var(--accent); }
  .page-shell { width: min(calc(100% - 48px), 900px); margin: 0 auto; padding: var(--pad-section) 0 96px; }
  /* 괘선은 랜딩 꼴 — 전대비(--fg) 굵은 줄 대신 소프트 경계 */
  .template-head { border-bottom: 1px solid var(--border-soft); padding-bottom: 32px; }
  /* eyebrow — 조직도·랜딩과 동일: mono · 넓은 자간 · 대문자 */
  .eyebrow {
    margin: 0 0 14px;
    color: var(--fg-mute);
    font-family: var(--mono);
    font-size: var(--text-meta);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
  }
  h1 { margin: 0; max-width: 760px; font-size: var(--text-h1); line-height: var(--leading-h1); letter-spacing: 0; }
  .source-note { margin: 18px 0 0; font-size: var(--text-lead); color: var(--fg-dim); }
  .markdown-body { padding: 42px 0 54px; }
  /* 독서면 산문 = 토큰의 리드 크기(17px). --text-body(15px)는 조직도 dd 처럼 짧은 항목용이라
     긴 글에 쓰면 읽기 부담이 커진다. */
  .markdown-body :global(h1) { font-size: var(--text-h1); line-height: var(--leading-h1); letter-spacing: 0; margin: 0 0 24px; }
  .markdown-body :global(h2) { margin: 52px 0 16px; padding-top: 18px; border-top: 1px solid var(--border-soft); font-size: var(--text-h2); line-height: 1.3; letter-spacing: 0; }
  .markdown-body :global(h3) { margin: 34px 0 12px; font-size: var(--text-h3); letter-spacing: 0; }
  .markdown-body :global(p) { margin: 0 0 18px; font-size: var(--text-lead); line-height: var(--leading-body); color: var(--fg-dim); }
  .markdown-body :global(ul), .markdown-body :global(ol) { margin: 0 0 24px; padding-left: 1.35rem; font-size: var(--text-lead); line-height: var(--leading-body); color: var(--fg-dim); }
  .markdown-body :global(li) { padding-left: 5px; margin: 5px 0; }
  .markdown-body :global(code) { padding: .15em .35em; border-radius: var(--radius-btn); background: var(--bg-elev); font-family: var(--mono); font-size: .9em; overflow-wrap: anywhere; }
  .markdown-body :global(pre) { max-width: 100%; overflow-x: auto; margin: 24px 0; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--code-bg); -webkit-overflow-scrolling: touch; }
  .markdown-body :global(pre code) { display: block; padding: 0; border-radius: 0; white-space: pre; background: transparent; font-size: 13px; line-height: var(--leading-body); }
  .markdown-body :global(.table-wrap) { max-width: 100%; overflow-x: auto; margin: 24px 0 30px; border-top: 1px solid var(--border); -webkit-overflow-scrolling: touch; }
  .markdown-body :global(table) { width: 100%; min-width: 620px; border-collapse: collapse; font-size: var(--text-desc); }
  .markdown-body :global(th), .markdown-body :global(td) { padding: 11px 12px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; }
  .markdown-body :global(th) { color: var(--fg); font-weight: 700; background: var(--bg-elev); }
  .markdown-body :global(td) { color: var(--fg-dim); }
  .template-foot { display: flex; justify-content: space-between; gap: 18px; padding-top: 22px; border-top: 1px solid var(--border-soft); color: var(--fg-mute); font-size: var(--text-desc); }
  .template-foot p { margin: 0; }
  @media (max-width: 640px) { .page-shell { width: min(calc(100% - 32px), 900px); padding: var(--pad-section-sm) 0 64px; } .template-head { padding-bottom: 24px; } .markdown-body { padding-top: 30px; } .template-foot { display: block; } .template-foot a { display: inline-block; margin-top: 6px; overflow-wrap: anywhere; } }
</style>
