---
import fs from "node:fs";
import path from "node:path";
import SiteLayout from "../layouts/SiteLayout.astro";

const { meta, sourceSegments, rawBase, eyebrow, sourceNote, description } = Astro.props;

const escapeHtml = (value) => value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
const inline = (value) => {
  let output = escapeHtml(value);
  output = output.replace(/`([^`]+)`/g, "<code>$1</code>");
  output = output.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
  output = output.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  return output;
};
const isTableDivider = (line) => /^\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?$/.test(line);
const cells = (line) => line.trim().replace(/^\|/, "").replace(/\|$/, "").split("|").map((cell) => cell.trim());

function markdownToHtml(source) {
  const lines = source.replaceAll("\r\n", "\n").split("\n");
  const html = [];
  let index = 0;
  while (index < lines.length) {
    const line = lines[index];
    if (!line.trim()) { index += 1; continue; }
    if (line.startsWith("```")) {
      const language = line.slice(3).trim();
      const body = [];
      index += 1;
      while (index < lines.length && !lines[index].startsWith("```")) body.push(lines[index++]);
      if (index < lines.length) index += 1;
      html.push(`<pre><code${language ? ` data-language="${escapeHtml(language)}"` : ""}>${escapeHtml(body.join("\n"))}</code></pre>`);
      continue;
    }
    if (/^#{1,3}\s/.test(line)) {
      const match = line.match(/^(#{1,3})\s+(.*)$/);
      const level = match[1].length;
      html.push(`<h${level}>${inline(match[2])}</h${level}>`);
      index += 1;
      continue;
    }
    if (line.trimStart().startsWith("|") && index + 1 < lines.length && isTableDivider(lines[index + 1])) {
      const head = cells(line);
      index += 2;
      const rows = [];
      while (index < lines.length && lines[index].trimStart().startsWith("|")) rows.push(cells(lines[index++]));
      html.push(`<div class="table-wrap"><table><thead><tr>${head.map((cell) => `<th>${inline(cell)}</th>`).join("")}</tr></thead><tbody>${rows.map((row) => `<tr>${head.map((_, cellIndex) => `<td>${inline(row[cellIndex] ?? "")}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`);
      continue;
    }
    if (/^\s*[-*]\s+/.test(line) || /^\s*\d+\.\s+/.test(line)) {
      const ordered = /^\s*\d+\.\s+/.test(line);
      const items = [];
      while (index < lines.length && (ordered ? /^\s*\d+\.\s+/.test(lines[index]) : /^\s*[-*]\s+/.test(lines[index]))) {
        items.push(lines[index++].replace(/^\s*(?:[-*]|\d+\.)\s+/, ""));
      }
      html.push(`<${ordered ? "ol" : "ul"}>${items.map((item) => `<li>${inline(item)}</li>`).join("")}</${ordered ? "ol" : "ul"}>`);
      continue;
    }
    const paragraph = [line];
    index += 1;
    while (index < lines.length && lines[index].trim() && !/^#{1,3}\s/.test(lines[index]) && !lines[index].startsWith("```") && !lines[index].trimStart().startsWith("|") && !/^\s*[-*]\s+/.test(lines[index]) && !/^\s*\d+\.\s+/.test(lines[index])) {
      paragraph.push(lines[index++]);
    }
    html.push(`<p>${inline(paragraph.join("\n")).replaceAll("\n", "<br />")}</p>`);
  }
  return html.join("\n");
}

const sourcePath = path.join(process.cwd(), "public", ...sourceSegments, meta.file);
const source = fs.readFileSync(sourcePath, "utf8");
const sourceLines = source.replaceAll("\r\n", "\n").split("\n");
const firstContentIndex = sourceLines.findIndex((line) => line.trim() !== "");
const firstContentLine = firstContentIndex >= 0 ? sourceLines[firstContentIndex].trim() : "";
const body =
  /^#\s+/.test(firstContentLine) && firstContentLine.replace(/^#\s+/, "").trim() === meta.title.trim()
    ? sourceLines.slice(firstContentIndex + 1).join("\n")
    : source;
const rendered = markdownToHtml(body);
const rawUrl = `/${rawBase}/${meta.file}`;
const slug = meta.file.replace(/\.md$/, "");
const canonical = `https://kangdaejong.com/${rawBase}/${slug}/`;
---

<SiteLayout title={meta.title} description={`${meta.title} — ${description}`} canonical={canonical} active="books" bodyClass="template-page">
  <main class="template-shell" id="main-content">
    <aside class="template-rail">
      <a class="template-back" href="/#books">← 책과 템플릿</a>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{meta.title}</h1>
      <p class="source-note">{sourceNote}</p>
      <div class="template-actions" aria-label="템플릿 사용">
        <button class="button primary" type="button" data-copy-template>Markdown 전체 복사</button>
        <a class="button" href={rawUrl} download={meta.file}>Markdown 다운로드</a>
        <a class="text-action" href={rawUrl}>원본 파일 열기 →</a>
      </div>
      <p class="copy-status" role="status" aria-live="polite"></p>
    </aside>

    <article class="markdown-body" set:html={rendered}></article>
    <textarea class="source-buffer" id="template-source" readonly aria-hidden="true" tabindex="-1">{source}</textarea>
  </main>
</SiteLayout>

<script is:inline>
  const copyButton = document.querySelector("[data-copy-template]");
  const sourceBuffer = document.querySelector("#template-source");
  const copyStatus = document.querySelector(".copy-status");

  copyButton?.addEventListener("click", async () => {
    try {
      let copied = false;
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(sourceBuffer.value);
        copied = true;
      } else {
        sourceBuffer.removeAttribute("aria-hidden");
        try {
          sourceBuffer.select();
          copied = document.execCommand("copy");
        } finally {
          sourceBuffer.setAttribute("aria-hidden", "true");
          copyButton.focus({ preventScroll: true });
        }
      }
      if (!copied) throw new Error("copy command failed");
      copyStatus.textContent = "복사했습니다.";
    } catch {
      copyStatus.textContent = "복사하지 못했습니다. 원본 파일을 열어 복사해 주세요.";
    }
  });
</script>

<style>
  :global(.template-page) { --page-max: 1240px; }
  .template-shell { width:min(calc(100% - 112px),1240px); margin:0 auto; padding:104px 0 128px; display:grid; grid-template-columns:minmax(280px,.62fr) minmax(0,1fr); gap:clamp(70px,9vw,140px); align-items:start; }
  .template-rail { position:sticky; top:42px; }
  .template-back { display:inline-block; margin-bottom:70px; color:var(--fg-mute); font-size:13px; text-decoration:none; }
  .template-rail h1 { margin:0; font-family:var(--serif); font-size:clamp(36px,4.3vw,58px); font-weight:500; letter-spacing:-.045em; line-height:1.2; word-break:keep-all; }
  .source-note { margin:24px 0 0; color:var(--fg-mute); word-break:keep-all; }
  .template-actions { display:grid; gap:10px; margin-top:38px; }
  .text-action { justify-self:start; margin-top:8px; color:var(--fg-dim); font-size:13px; }
  .copy-status { min-height:1.7em; margin:12px 0 0; color:var(--accent); font-size:13px; }
  .markdown-body { min-width:0; padding-top:7px; }
  .markdown-body :global(h1) { margin:0 0 26px; font-family:var(--serif); font-size:var(--text-h2); font-weight:500; letter-spacing:-.035em; }
  .markdown-body :global(h2) { margin:64px 0 20px; padding-top:24px; border-top:1px solid var(--border); font-family:var(--serif); font-size:clamp(28px,3vw,40px); font-weight:500; letter-spacing:-.035em; line-height:1.3; }
  .markdown-body :global(h2:first-child) { margin-top:0; }
  .markdown-body :global(h3) { margin:40px 0 14px; font-family:var(--serif); font-size:var(--text-h3); font-weight:500; }
  .markdown-body :global(p) { margin:0 0 20px; color:var(--fg-dim); font-size:17px; line-height:1.78; }
  .markdown-body :global(ul), .markdown-body :global(ol) { margin:0 0 26px; padding-left:1.35rem; color:var(--fg-dim); font-size:17px; line-height:1.75; }
  .markdown-body :global(li) { margin:6px 0; padding-left:5px; }
  .markdown-body :global(a) { color:var(--accent-hover); }
  .markdown-body :global(code) { padding:.15em .35em; background:var(--bg-elev2); color:var(--fg); font-family:var(--mono); font-size:.88em; overflow-wrap:anywhere; }
  .markdown-body :global(pre) { max-width:100%; margin:28px 0; padding:22px; overflow-x:auto; border:1px solid var(--border); background:var(--code-bg); -webkit-overflow-scrolling:touch; }
  .markdown-body :global(pre code) { display:block; padding:0; background:transparent; white-space:pre; font-size:13px; line-height:1.72; }
  .markdown-body :global(.table-wrap) { max-width:100%; margin:28px 0 34px; overflow-x:auto; border-top:1px solid var(--border); -webkit-overflow-scrolling:touch; }
  .markdown-body :global(table) { width:100%; min-width:620px; border-collapse:collapse; font-size:14px; }
  .markdown-body :global(th), .markdown-body :global(td) { padding:13px 14px; border-bottom:1px solid var(--border); text-align:left; vertical-align:top; }
  .markdown-body :global(th) { background:var(--bg-elev); color:var(--fg); }
  .markdown-body :global(td) { color:var(--fg-dim); }
  .source-buffer { position:fixed; width:1px; height:1px; left:-10000px; opacity:0; pointer-events:none; }

  @media (max-width:820px) {
    .template-shell { width:calc(100% - 64px); grid-template-columns:1fr; gap:58px; padding:72px 0 92px; }
    .template-rail { position:static; }
    .template-back { margin-bottom:44px; }
    .template-actions { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .text-action { grid-column:1 / -1; }
  }

  @media (max-width:640px) {
    .template-shell { width:calc(100% - 40px); padding:58px 0 76px; }
    .template-actions { grid-template-columns:1fr; }
    .text-action { grid-column:auto; }
    .markdown-body :global(p), .markdown-body :global(ul), .markdown-body :global(ol) { font-size:16px; }
  }
</style>
