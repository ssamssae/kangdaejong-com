---
import { projectVersions } from '../data/project-versions';
const { current } = Astro.props;
---
<nav class="project-versions" aria-label="프로젝트 버전">
  {projectVersions.map(item => item.href ?
    <a href={item.href} aria-current={current === item.version ? 'page' : undefined}><strong>{item.version}</strong><span>{item.label}</span></a> :
    <span class="future"><strong>{item.version}</strong><span>{item.label}</span></span>
  )}
</nav>
<style>
  .project-versions{display:flex;flex-wrap:wrap;gap:var(--tone-space-2);font-family:inherit}
  .project-versions>a,.future{display:flex;align-items:center;gap:var(--tone-space-2);padding:var(--tone-space-2) var(--tone-space-3);border:1px solid #d6d9cd;border-radius:var(--tone-radius-control);font-size:var(--tone-caption-size);line-height:1.5;text-decoration:none;color:#62655d}
  .project-versions strong{font-size:var(--tone-label-size);font-variant-numeric:tabular-nums}
  .project-versions a[aria-current="page"]{background:#282f27;border-color:#282f27;color:var(--cta-fg)}
  .project-versions a:hover{border-color:#a94830}.project-versions a:focus-visible{outline:2px solid #a94830;outline-offset:4px}
  .future{border-style:dashed;color:#74786e}
  @media(max-width:420px){.project-versions{gap:var(--tone-space-1)}.project-versions>a,.future{padding:var(--tone-space-2) var(--tone-space-2);flex-direction:column;align-items:flex-start;gap:var(--tone-space-1)}}
</style>
