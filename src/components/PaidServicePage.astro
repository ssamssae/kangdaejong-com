---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/renewal.css';
const {service}=Astro.props;
const canonical=`https://kangdaejong.com/${service.slug}/`;
---
<SiteLayout title={service.name} description={service.description} canonical={canonical} active="guides" bodyClass="renewal">
  <main id="main-content" class="service-page">
    <p class="r-kicker">{service.kicker}</p>
    <h1>{service.name}</h1>
    <p class="lead">{service.description}</p>
    <section aria-labelledby="contents-title">
      <h2 id="contents-title">어떤 내용을 받나요?</h2>
      <ul>{service.details.map(detail=><li>{detail}</li>)}</ul>
    </section>
    <section aria-labelledby="start-title">
      <h2 id="start-title">이용하기</h2>
      <p>{service.notice}</p>
      <div class="actions">
        <a class="r-button" href={service.start} data-service-start>{service.action} ↗</a>
        {service.sample&&<a class="r-button secondary" href={service.sample} data-service-sample>{service.sampleLabel} ↗</a>}
      </div>
      <p class="service-note">입력과 결제는 {service.name} 서비스 화면에서 이어져요.</p>
    </section>
    <section aria-labelledby="saved-title">
      <h2 id="saved-title">기존 이용 내역</h2>
      <p>{service.saved}</p>
      {service.history&&<a href={service.history} data-service-history>{service.historyLabel} ↗</a>}
    </section>
    {service.policies.length>0&&<nav class="policies" aria-label="이용 안내">{service.policies.map(([label,path])=><a href={new URL(path,service.start).href}>{label} ↗</a>)}</nav>}
    <p><a href="/product/">제품 안내로 돌아가기</a></p>
  </main>
</SiteLayout>
<style>
  /* T-261024-050: 첫이름 service 페이지(.hero → .block)와 같은 값 — 숫자는 공용 톤 값만. */
  body.studio-page .service-page{width:min(calc(100% - var(--tone-gutter) * 2),var(--tone-prose-max));margin:0 auto;padding:var(--tone-hero-top) 0 var(--tone-section-gap);color:var(--fg)}h1{margin:0 0 var(--tone-space-3)}.lead{margin:0 0 var(--tone-section-gap);color:var(--fg-dim);font-size:var(--tone-body-size);line-height:var(--tone-body-line)}section{border-top:1px solid var(--border);padding:var(--tone-section-gap) 0}h2{margin:0 0 var(--tone-space-2)}p,li{color:var(--fg-dim);line-height:var(--tone-body-line);word-break:keep-all}p{margin:0 0 var(--tone-space-3)}ul{margin:0 0 var(--tone-space-3);padding-left:var(--tone-space-4)}li{margin-bottom:var(--tone-space-1)}.actions,.policies{display:flex;flex-wrap:wrap;gap:var(--tone-space-1) var(--tone-space-3);margin-top:var(--tone-space-3)}.actions{gap:var(--tone-space-1)}.service-note{margin:var(--tone-space-3) 0 0;color:var(--fg-dim);font-size:var(--tone-caption-size);line-height:var(--tone-caption-line)}.policies{padding:var(--tone-space-4) 0;border-top:1px solid var(--border)}a:not(.r-button){display:inline-flex;align-items:center;min-height:var(--tone-tap-height);color:var(--accent);font-weight:var(--tone-weight-bold);text-underline-offset:var(--tone-underline-offset)}@media(max-width:760px){section{padding:var(--tone-space-6) 0}.actions{flex-direction:column}.actions a{display:flex}}
</style>
