---
import sources from "../data/product-screen-sources.json";
const examples = [
  { slug: "hanjul", name: "한줄일기", action: "오늘의 한 줄을 적고, 지난 기록을 다시 봅니다.", href: "https://apps.apple.com/kr/app/id6764308678" },
  { slug: "memo", name: "메모요", action: "떠오른 생각을 적고, 목록에서 바로 찾습니다.", href: "https://apps.apple.com/kr/app/id6762068073" },
  { slug: "cheotireum", name: "첫이름", action: "이름 후보를 살펴보고, 한자와 풀이를 확인합니다.", href: "https://cheotireum.kangdaejong.com/" },
];
---
<section class="product-examples" aria-labelledby="product-examples-title">
  <div class="examples-heading"><p>INSIDE THE PRODUCTS</p><h2 id="product-examples-title">이렇게 사용합니다.</h2><p>공식 App Store에 공개한 실제 앱 화면입니다.</p></div>
  <div class="examples-grid">{examples.map(item => <article>
    <div class="example-screen"><img src={sources.find(source => source.slug === item.slug)!.path} width="221" height="480" loading="lazy" alt={`${item.name} 실제 앱 화면`} /></div>
    <h3>{item.name}</h3><p>{item.action}</p><a href={item.href}>{item.name === "첫이름" ? "웹에서 시작하기" : "App Store에서 보기"} ↗</a>
  </article>)}</div>
</section>
<style>
.product-examples{margin:56px 0;padding:32px 0;border-top:1px solid var(--border,#d8d8ce)}
.examples-heading>p:first-child{font:11px var(--mono,monospace);letter-spacing:.1em;color:#62655d}.examples-heading h2{font-size:clamp(26px,4vw,38px);margin:12px 0}.examples-heading>p:last-child{font-size:14px;color:#62655d}
.examples-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:28px}.examples-grid article{min-width:0;padding:24px;border:1px solid #d8d8ce;border-radius:14px;background:#fdfcf8}.example-screen{display:flex;justify-content:center;height:350px;padding:12px;background:#eeede7;border-radius:10px}.example-screen img{height:100%;width:auto;max-width:100%;object-fit:contain;border-radius:8px}.examples-grid h3{font-size:22px;margin:24px 0 10px}.examples-grid article>p{font-size:14px;line-height:1.8;word-break:keep-all;color:#62655d}.examples-grid a{display:inline-flex;align-items:center;min-height:44px;font-size:13px;font-weight:600;color:#a94830;margin-top:10px}
@media(max-width:700px){.examples-grid{grid-template-columns:1fr}.example-screen{height:360px}.examples-grid article{padding:20px}}
</style>
