---
import ProteinImageZoom from './ProteinImageZoom.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { aminoAcids } from '../data/amino-acids';
import molecularData from '../../public/protein/manifest.json';
const sources = new Map(molecularData.aminoAcids.map(item => [item.slug, item.pubchem.url]));
const groups = ['전체', '비극성', '방향족', '극성', '산성', '염기성'];
const description = '단백질을 구성하는 표준 아미노산 20종을 3D 분자 그림으로 만나보세요. 이름, 구조, 곁사슬의 성질을 한곳에서 살펴봅니다.';
---
<SiteLayout title="단백질 · 아미노산 20" description={description} canonical="https://kangdaejong.com/protein/" active="protein" bodyClass="studio-page" langToggle>
  <main id="main-content" class="protein-shell studio-width">
    <section class="protein-hero studio-hero" aria-labelledby="protein-title">
      <div class="hero-copy">
        <p class="studio-label">단백질을 이루는 작은 구조</p>
        <h1 id="protein-title">단백질의 시작,<br/><em>20가지</em> 작은 구조.</h1>
        <p class="studio-lead">서로 다른 곁사슬, 무한한 조합.<br/>단백질을 만드는 아미노산을 직접 돌려보며 살펴봅니다.</p>
        <a class="explore mb-link" href="#atlas">20종 둘러보기 <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="hero-molecule mb-card">
        <span class="figure-index">W / TRYPTOPHAN</span>
        <a class="structure-link" data-protein-zoom href="/protein/tryptophan.png" aria-label="트립토판 대표 그림 크게 보기" aria-haspopup="dialog"><picture><img src="/protein/tryptophan.png" alt="트립토판의 3D 공과 막대 분자 모형" width="800" height="800" fetchpriority="high" /></picture></a>
        <figcaption><span>트립토판</span><span>입체 분자 모형 / 구와 막대</span></figcaption>
      </figure>
    </section>
    <section class="reading-guide" aria-label="분자 그림 읽는 법">
      <div><h2>색으로 읽는 원자</h2><p>구는 원자, 막대는 결합을 나타냅니다.</p></div>
      <ul class="legend">
        {[['C','탄소','#48505a'],['H','수소','#ffffff'],['N','질소','#305ed8'],['O','산소','#df443e'],['S','황','#eac53b']].map(([symbol,label,color]) => <li><i style={`--atom:${color}`} aria-hidden="true"></i><b>{symbol}</b> {label}</li>)} {/* tokens:fixed — 원소 색(CPK)은 테마와 무관 */}
      </ul>
    </section>
    <section id="atlas" aria-labelledby="atlas-title">
      <div class="atlas-heading"><div><p class="mb-eyebrow">THE BUILDING BLOCKS</p><h2 id="atlas-title">아미노산 도감</h2></div><p>같은 기본 골격에서,<br/>서로 다른 성질이 시작됩니다.</p></div>
      <div class="controls">
        <div class="filters" role="group" aria-label="곁사슬 분류">{groups.map((group,index) => <button type="button" data-group={group} aria-pressed={index===0?'true':'false'}>{group}</button>)}</div>
        <label class="search"><span class="sr-only">아미노산 이름 또는 약자 검색</span><input class="mb-input" type="search" placeholder="이름 또는 약자 검색" aria-label="아미노산 이름 또는 약자 검색" /></label>
      </div>
      <p class="result-count" role="status" aria-live="polite"><span id="match-count">20</span> / 20종</p>
      <div class="amino-grid">
        {aminoAcids.map((amino,index) => <article class="amino-card mb-card" data-category={amino.group} data-search={`${amino.name} ${amino.en} ${amino.code} ${amino.letter}`.toLowerCase()}>
          <div class="card-top"><span>{String(index+1).padStart(2,'0')}</span><span class="group-label mb-chip">{amino.group}</span></div>
          <a class="structure-link" data-protein-zoom aria-haspopup="dialog" href={`/protein/${amino.slug}.png`} aria-label={`${amino.name} 구조 그림 크게 보기`}><picture><img src={`/protein/${amino.slug}.png`} alt={`${amino.name}(${amino.code})의 3D 분자 구조`} width="800" height="800" loading="lazy" decoding="async" /></picture></a>
          <div class="card-copy"><div class="name-line"><h3>{amino.name}</h3><span class="amino-code">{amino.letter}</span></div><p class="english">{amino.en} <span>· {amino.code}</span></p><p class="amino-note">{amino.note}</p><button class="view-3d mb-btn mb-btn--secondary mb-btn--block" type="button" data-molecule={amino.slug} data-name={amino.name} data-code={amino.code} aria-label={`${amino.name} 3D로 보기`} aria-haspopup="dialog">3D로 보기 <span aria-hidden="true">↻</span></button><a class="structure-source" href={sources.get(amino.slug)} aria-label={`${amino.name} PubChem 구조 원본`}>구조 원본 ↗</a></div>
        </article>)}
      </div>
      <div id="empty-state" hidden><p>일치하는 아미노산이 없습니다.</p></div>
      <button class="reset mb-btn mb-btn--secondary" type="button">초기화</button>
    </section>
    <aside class="model-note" aria-labelledby="model-note-title">
      <h2 id="model-note-title">이 그림에 대하여</h2>
      <div><p>표준 아미노산 20종의 개별 분자를 보여줍니다. 글리신을 제외하면 L형이며, 그림은 중성 형태의 한 가지 3D 배열입니다. 실제 수용액에서는 pH에 따라 전하와 구조가 달라지고, 단백질 안에서는 펩타이드 결합으로 연결됩니다.</p><p>분류는 곁사슬의 특징을 살펴보기 위한 구분입니다. 티로신은 방향족이면서 극성을 띠고, 히스티딘은 고리 구조를 가지면서 염기성으로 분류합니다. 구와 막대의 크기는 보기 쉽게 조정했습니다.</p><p class="source-links">자료: <a href="https://pubchem.ncbi.nlm.nih.gov/">PubChem 분자 구조</a> · <a href="https://www.ncbi.nlm.nih.gov/books/NBK26830/">NCBI · 단백질의 구조</a> · <a href="/protein/manifest.json">그림별 출처</a></p></div>
    </aside>
    <dialog id="molecule-dialog" aria-labelledby="molecule-title" aria-describedby="molecule-help">
      <div class="viewer-heading"><div><p class="mb-eyebrow">INTERACTIVE MOLECULE</p><h2 id="molecule-title">3D 분자 구조</h2></div><button class="viewer-close mb-btn mb-btn--secondary" type="button" aria-label="3D 보기 닫기" autofocus>닫기 ×</button></div>
      <p id="molecule-help">드래그·한 손가락으로 회전, 휠 위로 확대·아래로 축소하세요. 두 손가락으로도 확대·축소할 수 있습니다.<br/>아래 버튼 또는 뷰어에 초점을 둔 뒤 방향키와 + / − 키로도 조작할 수 있습니다.</p>
      <div id="molecule-stage" tabindex="0" role="region" aria-label="회전 가능한 분자 모형" aria-describedby="molecule-help" aria-busy="false"></div>
      <p id="molecule-status" role="status" aria-live="polite"></p>
      <div class="viewer-controls" role="group" aria-label="분자 회전과 확대">
        <button class="mb-btn mb-btn--secondary" type="button" data-view-action="left" aria-label="왼쪽으로 회전" disabled>←</button><button class="mb-btn mb-btn--secondary" type="button" data-view-action="right" aria-label="오른쪽으로 회전" disabled>→</button><button class="mb-btn mb-btn--secondary" type="button" data-view-action="up" aria-label="위로 회전" disabled>↑</button><button class="mb-btn mb-btn--secondary" type="button" data-view-action="down" aria-label="아래로 회전" disabled>↓</button>
        <button class="mb-btn mb-btn--secondary" type="button" data-view-action="out" aria-label="축소" disabled>−</button><button class="mb-btn mb-btn--secondary" type="button" data-view-action="in" aria-label="확대" disabled>+</button><button class="mb-btn mb-btn--secondary" type="button" data-view-action="reset" disabled>원래대로</button>
      </div>
      <div class="viewer-fallback"><button id="molecule-retry" class="mb-btn mb-btn--secondary" type="button" hidden>다시 시도</button><a class="mb-link" data-protein-zoom aria-haspopup="dialog" id="molecule-image" href="/protein/tryptophan.png">정적인 그림 보기 ↗</a></div>
    </dialog>
    <ProteinImageZoom />
  </main>
</SiteLayout>
<script>
  import "../scripts/protein-viewer.js";
  import "../scripts/lang-toggle-protein.js";
  const search = document.querySelector<HTMLInputElement>('.search input')!;
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-group]');
  const cards = document.querySelectorAll<HTMLElement>('.amino-card');
  let selected = '전체';
  function update() {
    const query = search.value.trim().toLowerCase();
    let count = 0;
    cards.forEach(card => {
      const matches = (selected === '전체' || card.dataset.category === selected) && (card.dataset.search || '').includes(query);
      card.hidden = !matches;
      if (matches) count++;
    });
    filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.group === selected)));
    document.querySelector('#match-count')!.textContent = String(count);
    (document.querySelector('#empty-state') as HTMLElement).hidden = count !== 0;
  }
  filters.forEach(button => button.addEventListener('click', () => { selected = button.dataset.group!; update(); }));
  search.addEventListener('input', update);
  document.querySelector('.reset')!.addEventListener('click', () => { selected = '전체'; search.value = ''; update(); });
</script>
<style>
  /* T-261024-058: 모양·글자·간격은 공용 톤 파일(--tone-*)·공용 부품(.mb-*)만 쓴다. 제목 글자 크기는 공용 studio-page.css 가 정한다.
     숫자를 다시 적으면 verify-tone-copies 가 막는다. 그림 크기처럼 정말 고정인 값만 tone:fixed 줄로 남긴다. 다크 모드·다크 그림 세트는 없다. */
  .view-3d{justify-content:space-between;margin-top:var(--tone-space-3)}
  #molecule-dialog{width:min(720px,calc(100% - var(--tone-space-4)));max-height:calc(100dvh - var(--tone-space-4));box-sizing:border-box;padding:var(--tone-space-4);border:1px solid var(--border);border-radius:var(--tone-radius-sheet);background:var(--bg);color:var(--fg);overflow:auto;overscroll-behavior:contain}#molecule-dialog::backdrop{background:#182019a8}
  .viewer-heading{display:flex;align-items:center;justify-content:space-between;gap:var(--tone-space-2)}.viewer-heading .mb-eyebrow{margin:0 0 var(--tone-space-1)}.viewer-heading h2{margin:0}.viewer-heading .mb-btn{flex-shrink:0}#molecule-help{font-size:var(--tone-caption-size);line-height:var(--tone-caption-line);color:var(--fg-dim);margin:var(--tone-space-3) 0}
  #molecule-stage{position:relative;width:100%;height:min(48dvh,420px);border-radius:var(--tone-radius-control);background:var(--bg-elev);overflow:hidden;touch-action:none;cursor:grab}
  #molecule-stage{min-height:180px} /* tone:fixed — 3D 무대 최소 높이(분자가 보이는 크기) */
  #molecule-stage:active{cursor:grabbing}#molecule-status{min-height:var(--tone-label-line);margin:var(--tone-space-2) 0;font-size:var(--tone-caption-size);line-height:var(--tone-caption-line);color:var(--fg-dim)}.viewer-controls{display:flex;flex-wrap:wrap;justify-content:center;gap:var(--tone-space-1)}.viewer-controls .mb-btn{min-width:var(--tone-control-height)}.viewer-controls button:disabled{opacity:.4;cursor:default}.viewer-fallback{display:flex;align-items:center;justify-content:center;gap:var(--tone-space-3);margin-top:var(--tone-space-3)}.viewer-fallback [hidden]{display:none}
  @media(max-width:480px){#molecule-dialog{padding:var(--tone-space-3)}#molecule-stage{height:min(40dvh,340px)}}

  .protein-shell{max-width:var(--page-max);margin:auto;padding:0;color:var(--fg)}
  .protein-hero{display:grid;grid-template-columns:1.2fr .8fr;gap:var(--tone-space-6);align-items:center}
  h1{margin:0 0 var(--tone-space-4)}h1 em{font-family:inherit;font-style:normal;color:var(--accent)}
  .explore{margin-top:var(--tone-space-3);gap:var(--tone-space-3)}
  .hero-molecule{position:relative;margin:0;overflow:hidden;justify-self:end}
  .hero-molecule{max-width:330px} /* tone:fixed — 대표 분자 그림 폭(그림 원본 비율) */
  .hero-molecule img{width:100%;height:auto;display:block;mix-blend-mode:multiply}.figure-index{font:var(--tone-weight) var(--tone-caption-size)/var(--tone-caption-line) var(--mono);color:var(--fg-dim)}figcaption{display:flex;justify-content:space-between;gap:var(--tone-space-2);font-size:var(--tone-caption-size);line-height:var(--tone-caption-line);color:var(--fg-dim)}figcaption span:first-child{color:var(--fg);font-weight:var(--tone-weight-bold)}
  .reading-guide{display:flex;justify-content:space-between;gap:var(--tone-space-4);align-items:center;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:var(--tone-space-4) 0}.reading-guide h2{margin:0 0 var(--tone-space-1)}.reading-guide p{font-size:var(--tone-caption-size);line-height:var(--tone-caption-line);color:var(--fg-dim);margin:0}.legend{display:flex;gap:var(--tone-space-4);list-style:none;margin:0;padding:0;flex-wrap:wrap}.legend li{display:flex;align-items:center;gap:var(--tone-space-1);font-size:var(--tone-caption-size);line-height:var(--tone-caption-line)}.legend b{font:var(--tone-weight-bold) var(--tone-caption-size)/var(--tone-caption-line) var(--mono)}.legend i{display:block;width:14px;height:14px;border-radius:50%;background:var(--atom);border:1px solid #0002;box-shadow:inset -2px -2px 3px #0002}
  #atlas{padding:var(--tone-section-gap) 0;scroll-margin-top:var(--tone-space-4)}.atlas-heading{display:flex;justify-content:space-between;align-items:end;gap:var(--tone-space-4);margin-bottom:var(--tone-space-5)}.atlas-heading .mb-eyebrow{margin-bottom:var(--tone-space-2)}.atlas-heading h2{margin:0}.atlas-heading>p{font-size:var(--tone-caption-size);line-height:var(--tone-caption-line);color:var(--fg-dim);margin:0}.controls{display:flex;justify-content:space-between;align-items:center;gap:var(--tone-space-4)}.filters{display:flex;flex-wrap:wrap;gap:var(--tone-space-1)}.filters button{font:var(--tone-weight-bold) var(--tone-caption-size)/var(--tone-caption-line) var(--tone-font);min-height:var(--tone-tap-height);padding:0 var(--tone-control-padding);border:var(--tone-input-border) solid transparent;border-radius:var(--tone-radius-pill);background:var(--bg-elev);color:var(--fg-dim);cursor:pointer}.filters button[aria-pressed=true]{background:var(--accent-tint);color:var(--accent);border-color:var(--accent)}.search .mb-input{width:260px;max-width:100%}.result-count{text-align:right;font:var(--tone-weight) var(--tone-caption-size)/var(--tone-caption-line) var(--mono);color:var(--fg-dim);margin:var(--tone-space-4) 0 var(--tone-space-2)}
  .amino-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--tone-space-3)}.amino-card{overflow:hidden;min-width:0}.amino-card[hidden]{display:none}.card-top{display:flex;justify-content:space-between;align-items:center;color:var(--fg-dim);font:var(--tone-weight) var(--tone-caption-size)/var(--tone-caption-line) var(--mono)}.structure-link{display:block}.structure-link picture{display:block}.structure-link img{display:block;width:100%;height:210px;aspect-ratio:1;object-fit:contain;mix-blend-mode:multiply}.name-line{display:flex;justify-content:space-between;gap:var(--tone-space-1);align-items:center}.name-line h3{margin:0}.amino-code{font:var(--tone-weight) var(--tone-subtitle-size)/var(--tone-subtitle-line) var(--mono);color:var(--accent)}.english{font-size:var(--tone-caption-size);line-height:var(--tone-caption-line);margin:var(--tone-space-1) 0 var(--tone-space-3);color:var(--fg-dim)}.english span{white-space:nowrap}.amino-note{font-size:var(--tone-caption-size);line-height:var(--tone-caption-line);color:var(--fg-dim);margin:0}.structure-source{display:inline-block;margin-top:var(--tone-space-3);font-size:var(--tone-caption-size);line-height:var(--tone-caption-line);color:var(--fg-dim);text-underline-offset:var(--tone-underline-offset)}.reset{display:flex;width:fit-content;margin:var(--tone-space-4) auto 0}
  .model-note{border-top:1px solid var(--border);padding:var(--tone-space-6) 0 var(--tone-section-gap);display:grid;grid-template-columns:1fr 3fr;gap:var(--tone-space-6)}.model-note h2{margin:0}.model-note p{font-size:var(--tone-caption-size);line-height:var(--tone-caption-line);color:var(--fg-dim);margin:0 0 var(--tone-space-2)}.source-links a{color:var(--fg);text-underline-offset:var(--tone-underline-offset)}#empty-state{text-align:center;padding:var(--tone-section-gap) 0;color:var(--fg-dim)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}:where(a,button,input):focus-visible{outline:var(--tone-focus-width) solid var(--accent);outline-offset:var(--tone-focus-offset)}
  @media(max-width:1050px){.protein-hero{gap:var(--tone-space-5)}.legend{gap:var(--tone-space-3)}}
  @media(max-width:760px){.protein-hero{grid-template-columns:1fr;gap:var(--tone-space-5)}.hero-molecule{width:100%;box-sizing:border-box;justify-self:center}.reading-guide{align-items:flex-start;flex-direction:column}.atlas-heading>p{display:none}.controls{align-items:stretch;flex-direction:column;gap:var(--tone-space-2)}.search .mb-input{width:100%;box-sizing:border-box}.amino-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--tone-space-2)}.model-note{grid-template-columns:1fr;gap:var(--tone-space-3)}}
  @media(max-width:760px){.hero-molecule{max-width:480px}} /* tone:fixed — 휴대전화 대표 분자 그림 폭 */
  @media(max-width:650px){.protein-hero{gap:var(--tone-space-4)}.hero-molecule{justify-self:start}.structure-link img{height:150px}}
  @media(max-width:650px){.hero-molecule{max-width:280px}} /* tone:fixed — 좁은 화면 대표 분자 그림 폭 */
  @media(max-width:390px){.amino-grid{gap:var(--tone-space-1)}.name-line{gap:var(--tone-space-1)}.legend{gap:var(--tone-space-2)}}
</style>
