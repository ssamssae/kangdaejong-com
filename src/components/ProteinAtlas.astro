---
import SiteLayout from '../layouts/SiteLayout.astro';
import { aminoAcids } from '../data/amino-acids';
import molecularData from '../../public/protein/manifest.json';
const sources = new Map(molecularData.aminoAcids.map(item => [item.slug, item.pubchem.url]));
const groups = ['전체', '비극성', '방향족', '극성', '산성', '염기성'];
const description = '단백질을 구성하는 표준 아미노산 20종을 3D 분자 그림으로 만나보세요. 이름, 구조, 곁사슬의 성질을 한곳에서 살펴봅니다.';
---
<SiteLayout title="단백질 · 아미노산 20" description={description} canonical="https://protein.kangdaejong.com/" active="protein">
  <main id="main-content" class="protein-shell">
    <section class="protein-hero" aria-labelledby="protein-title">
      <div class="hero-copy">
        <p class="kicker">MOLECULAR ATLAS / 01</p>
        <h1 id="protein-title">단백질의 시작,<br/><em>20가지</em> 작은 구조.</h1>
        <p class="intro">서로 다른 곁사슬, 무한한 조합.<br/>단백질을 만드는 아미노산을 입체로 살펴봅니다.</p>
        <a class="explore" href="#atlas">20종 둘러보기 <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="hero-molecule">
        <span class="figure-index">W / TRYPTOPHAN</span>
        <img src="/protein/tryptophan.png" alt="트립토판의 3D 공과 막대 분자 모형" width="800" height="800" fetchpriority="high" />
        <figcaption><span>트립토판</span><span>입체 분자 모형 / 구와 막대</span></figcaption>
      </figure>
    </section>
    <section class="reading-guide" aria-label="분자 그림 읽는 법">
      <div><h2>색으로 읽는 원자</h2><p>구는 원자, 막대는 결합을 나타냅니다.</p></div>
      <ul class="legend">
        {[['C','탄소','#48505a'],['H','수소','#ffffff'],['N','질소','#305ed8'],['O','산소','#df443e'],['S','황','#eac53b']].map(([symbol,label,color]) => <li><i style={`--atom:${color}`} aria-hidden="true"></i><b>{symbol}</b> {label}</li>)}
      </ul>
    </section>
    <section id="atlas" aria-labelledby="atlas-title">
      <div class="atlas-heading"><div><p class="kicker">THE BUILDING BLOCKS</p><h2 id="atlas-title">아미노산 도감</h2></div><p>같은 기본 골격에서,<br/>서로 다른 성질이 시작됩니다.</p></div>
      <div class="controls">
        <div class="filters" role="group" aria-label="곁사슬 분류">{groups.map((group,index) => <button type="button" data-group={group} aria-pressed={index===0?'true':'false'}>{group}</button>)}</div>
        <label class="search"><span class="sr-only">아미노산 이름 또는 약자 검색</span><input type="search" placeholder="이름 또는 약자 검색" aria-label="아미노산 이름 또는 약자 검색" /></label>
      </div>
      <p class="result-count" role="status" aria-live="polite"><span id="match-count">20</span> / 20종</p>
      <div class="amino-grid">
        {aminoAcids.map((amino,index) => <article class="amino-card" data-category={amino.group} data-search={`${amino.name} ${amino.en} ${amino.code} ${amino.letter}`.toLowerCase()}>
          <div class="card-top"><span>{String(index+1).padStart(2,'0')}</span><span class="group-label">{amino.group}</span></div>
          <a class="structure-link" href={`/protein/${amino.slug}.png`} aria-label={`${amino.name} 구조 그림 크게 보기`}><img src={`/protein/${amino.slug}.png`} alt={`${amino.name}(${amino.code})의 3D 분자 구조`} width="800" height="800" loading="lazy" decoding="async" /></a>
          <div class="card-copy"><div class="name-line"><h3>{amino.name}</h3><span class="amino-code">{amino.letter}</span></div><p class="english">{amino.en} <span>· {amino.code}</span></p><p class="amino-note">{amino.note}</p><a class="structure-source" href={sources.get(amino.slug)} aria-label={`${amino.name} PubChem 구조 원본`}>구조 원본 ↗</a></div>
        </article>)}
      </div>
      <div id="empty-state" hidden><p>일치하는 아미노산이 없습니다.</p></div>
      <button class="reset" type="button">초기화</button>
    </section>
    <aside class="model-note" aria-labelledby="model-note-title">
      <h2 id="model-note-title">이 그림에 대하여</h2>
      <div><p>표준 아미노산 20종의 개별 분자를 보여줍니다. 글리신을 제외하면 L형이며, 그림은 중성 형태의 한 가지 3D 배열입니다. 실제 수용액에서는 pH에 따라 전하와 구조가 달라지고, 단백질 안에서는 펩타이드 결합으로 연결됩니다.</p><p>분류는 곁사슬의 특징을 살펴보기 위한 구분입니다. 티로신은 방향족이면서 극성을 띠고, 히스티딘은 고리 구조를 가지면서 염기성으로 분류합니다. 구와 막대의 크기는 보기 쉽게 조정했습니다.</p><p class="source-links">자료: <a href="https://pubchem.ncbi.nlm.nih.gov/">PubChem 분자 구조</a> · <a href="https://www.ncbi.nlm.nih.gov/books/NBK26830/">NCBI · 단백질의 구조</a> · <a href="/protein/manifest.json">그림별 출처</a></p></div>
    </aside>
  </main>
</SiteLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('.search input')!;
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-group]');
  const cards = document.querySelectorAll<HTMLElement>('.amino-card');
  let selected = '전체';
  function update() {
    const query = search.value.trim().toLowerCase();
    let count = 0;
    cards.forEach(card => {
      const matches = (selected === '전체' || card.dataset.category === selected) && (card.dataset.search || '').includes(query);
      card.hidden = !matches;
      if (matches) count++;
    });
    filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.group === selected)));
    document.querySelector('#match-count')!.textContent = String(count);
    (document.querySelector('#empty-state') as HTMLElement).hidden = count !== 0;
  }
  filters.forEach(button => button.addEventListener('click', () => { selected = button.dataset.group!; update(); }));
  search.addEventListener('input', update);
  document.querySelector('.reset')!.addEventListener('click', () => { selected = '전체'; search.value = ''; update(); });
</script>
<style>
  .protein-shell{max-width:1280px;margin:auto;padding:0 48px;color:var(--fg)}
  .protein-hero{display:grid;grid-template-columns:1.05fr 1fr;gap:52px;align-items:center;padding:72px 0 56px}
  .kicker{font:11px var(--mono);letter-spacing:.15em;color:var(--accent);margin:0 0 28px}
  h1{font-size:clamp(38px,4.6vw,65px);line-height:1.23;letter-spacing:-.06em;font-weight:650;margin:0 0 26px}h1 em{font-family:var(--serif);font-style:normal;color:var(--accent)}
  .intro{font-size:17px;line-height:1.9;color:var(--fg-dim)}.explore{display:inline-flex;gap:50px;padding:15px 0;border-bottom:1px solid var(--fg);margin-top:18px;color:var(--fg);text-decoration:none;font-size:14px;font-weight:600}
  .hero-molecule{position:relative;background:#eeede7;border:1px solid var(--border);border-radius:24px;margin:0;padding:24px;overflow:hidden}.hero-molecule img{width:100%;height:auto;display:block;mix-blend-mode:multiply}.figure-index{font:11px var(--mono);letter-spacing:.1em;color:var(--fg-dim)}figcaption{display:flex;justify-content:space-between;gap:12px;font-size:11px;color:var(--fg-dim)}figcaption span:first-child{color:var(--fg);font-weight:650}
  .reading-guide{display:flex;justify-content:space-between;gap:24px;align-items:center;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:26px 0}.reading-guide h2{font-size:15px;margin:0 0 6px}.reading-guide p{font-size:13px;color:var(--fg-dim);margin:0}.legend{display:flex;gap:24px;list-style:none;margin:0;padding:0;flex-wrap:wrap}.legend li{display:flex;align-items:center;gap:7px;font-size:12px}.legend b{font:12px var(--mono)}.legend i{display:block;width:14px;height:14px;border-radius:50%;background:var(--atom);border:1px solid #0002;box-shadow:inset -2px -2px 3px #0002}
  #atlas{padding:68px 0;scroll-margin-top:20px}.atlas-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.atlas-heading .kicker{margin-bottom:12px}.atlas-heading h2{font-size:32px;letter-spacing:-.04em;margin:0}.atlas-heading>p{font-size:13px;line-height:1.8;color:var(--fg-dim);margin:0}.controls{display:flex;justify-content:space-between;align-items:center;gap:20px}.filters{display:flex;flex-wrap:wrap;gap:6px}.filters button,.reset{font:inherit;font-size:13px;border:1px solid var(--border);background:transparent;border-radius:30px;padding:9px 16px;cursor:pointer;color:var(--fg-dim)}.filters button[aria-pressed=true]{background:var(--fg);color:var(--bg);border-color:var(--fg)}.search input{font:inherit;font-size:13px;background:transparent;border:0;border-bottom:1px solid var(--border);padding:12px 4px;width:210px;max-width:100%;border-radius:0}.result-count{text-align:right;font:11px var(--mono);color:var(--fg-dim);margin:22px 0 12px}.amino-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.amino-card{background:#fffefb;border:1px solid var(--border);border-radius:16px;overflow:hidden;min-width:0}.amino-card[hidden]{display:none}.card-top{display:flex;justify-content:space-between;align-items:center;padding:18px 18px 0;color:var(--fg-dim);font:11px var(--mono)}.group-label{font-family:var(--sans);background:var(--bg-tint);padding:4px 8px;border-radius:20px;font-size:10px}.structure-link{display:block}.structure-link img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain;mix-blend-mode:multiply}.card-copy{padding:0 20px 22px}.name-line{display:flex;justify-content:space-between;gap:8px;align-items:center}.name-line h3{font-size:19px;letter-spacing:-.035em;margin:0}.amino-code{font:20px var(--mono);color:var(--accent)}.english{font-size:11px;margin:6px 0 14px;color:var(--fg-dim)}.english span{white-space:nowrap}.amino-note{font-size:12px;line-height:1.8;color:var(--fg-dim);margin:0}.structure-source{display:inline-block;margin-top:14px;font-size:11px;color:var(--fg-dim);text-underline-offset:3px}.reset{display:block;margin:24px auto 0}.model-note{border-top:1px solid var(--border);padding:35px 0 64px;display:grid;grid-template-columns:1fr 3fr;gap:40px}.model-note h2{font-size:16px;margin:0}.model-note p{font-size:12px;line-height:1.9;color:var(--fg-dim);margin:0 0 12px}.source-links a{color:var(--fg);text-underline-offset:3px}#empty-state{text-align:center;padding:50px 0;color:var(--fg-dim)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}:where(a,button,input):focus-visible{outline:2px solid var(--accent);outline-offset:4px}
  @media(max-width:1050px){.amino-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.protein-hero{gap:28px}.legend{gap:14px}}
  @media(max-width:760px){.protein-shell{padding:0 24px}.protein-hero{grid-template-columns:1fr;padding:44px 0 32px;gap:34px}.hero-molecule{max-width:480px;width:100%;box-sizing:border-box;justify-self:center}.reading-guide{align-items:flex-start;flex-direction:column}.legend{gap:18px}.atlas-heading>p{display:none}.controls{align-items:stretch;flex-direction:column;gap:12px}.search input{width:100%;box-sizing:border-box}.amino-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card-copy{padding:0 14px 18px}.card-top{padding:14px 14px 0}.name-line h3{font-size:16px}.amino-code{font-size:18px}.english{font-size:10px}.model-note{grid-template-columns:1fr;gap:16px}#atlas{padding:44px 0}.filters button{padding:8px 12px}.intro{font-size:15px}}
  @media(max-width:390px){.protein-shell{padding:0 20px}.amino-grid{gap:10px}.card-copy{padding:0 12px 16px}.name-line{gap:4px}.name-line h3{font-size:15px}.legend{gap:12px}}
</style>
